---
import AdminLayout from '@/layouts/AdminLayout.astro'
import { can } from '@/admin/auth'
import { configured, find, joinedSince, listTotals, page, parseSubRange, rangeStart, subscriberStats, type Subscriber } from '@/admin/brevo'
export const prerender = false

const me = Astro.locals.admin!
if (!can(me.role, 'subscribers.read')) return Astro.redirect('/admin?e=forbidden')

const PER = 50
const sp = Astro.url.searchParams
const pg = Math.max(1, Number(sp.get('p')) || 1)
const q = (sp.get('q') ?? '').trim().toLowerCase().slice(0, 200)
const fmt = (d: string | null) => (d ? new Date(d).toLocaleString('he-IL', { timeZone: 'Asia/Jerusalem', dateStyle: 'short', timeStyle: 'short' }) : '—')
const nf = (n: number) => n.toLocaleString('he-IL')

const range = parseSubRange(sp.get('d'))
const LABEL: Record<string, string> = { today: 'היום', '7': '7 ימים', '30': '30 ימים', '90': '90 ימים', all: 'הכול' }
const SPAN: Record<string, string> = { today: 'היום', '7': 'ב-7 הימים האחרונים', '30': 'ב-30 הימים האחרונים', '90': 'ב-90 הימים האחרונים' }

let error = '', totals: Awaited<ReturnType<typeof listTotals>> = null, rows: Subscriber[] = [], found: Subscriber | null | undefined
let stats: Awaited<ReturnType<typeof subscriberStats>> = null
let newCount = 0, newTruncated = false, filtered: Subscriber[] = []
if (configured()) {
  try {
    totals = await listTotals()
    stats = await subscriberStats()
    if (q) found = await find(q)
    else if (range === 'all') rows = await page((pg - 1) * PER, PER)
    else {
      // everyone who joined in the range (newest first); the table pages through them
      const j = await joinedSince(rangeStart(range))
      filtered = j.rows; newCount = j.rows.length; newTruncated = j.truncated
      rows = filtered.slice((pg - 1) * PER, pg * PER)
    }
  } catch (e) {
    console.error('[subscribers]', e)
    error = 'הקריאה מ-Brevo נכשלה. בדקו את BREVO_API_KEY ואת BREVO_LIST_ID.'
  }
}
const pages = range === 'all' ? (totals ? Math.max(1, Math.ceil(totals.subscribers / PER)) : 1) : Math.max(1, Math.ceil(newCount / PER))
const show = q ? (found ? [found] : []) : rows
---
<AdminLayout title="רשימת תפוצה" nav="subscribers">
  <h1>רשימת תפוצה</h1>
  {!configured() ? (
    <p class="ad-note" role="alert">החיבור ל-Brevo לא מוגדר: חסרים <span class="ltr">BREVO_API_KEY</span> ו-<span class="ltr">BREVO_LIST_ID</span> ב-Vercel.</p>
  ) : (
    <>
      {error && <p class="ad-note" role="alert">{error}</p>}
      <div class="ad-kpis subs-page-kpis">
        <div class="ad-kpi k-green"><b>{totals ? nf(totals.subscribers) : '—'}</b><span>מצטרפים ברשימה{totals?.name ? ` "${totals.name}"` : ''}</span></div>
        {stats && <div class={`ad-kpi k-gold${range === 'today' ? ' sel' : ''}`}><b>{nf(stats.today)}</b><span>הצטרפו היום</span></div>}
        {stats && <div class={`ad-kpi k-blue${range === '7' ? ' sel' : ''}`}><b>{nf(stats.d7)}</b><span>הצטרפו ב-7 הימים האחרונים</span></div>}
        {stats && <div class={`ad-kpi k-plum${range === '30' ? ' sel' : ''}`}><b>{nf(stats.d30)}</b><span>הצטרפו ב-30 הימים האחרונים</span></div>}
        {stats && <div class={`ad-kpi k-green${range === '90' ? ' sel' : ''}`}><b>{nf(stats.d90)}{stats.truncated ? '+' : ''}</b><span>הצטרפו ב-90 הימים האחרונים</span></div>}
        {totals && totals.blocked > 0 && <div class="ad-kpi k-blue"><b>{nf(totals.blocked)}</b><span>הוסרו או נחסמו</span></div>}
      </div>
      <nav class="ad-range" aria-label="תקופה" style="margin-top:20px">
        {(['today', '7', '30', '90', 'all'] as const).map((r) => <a href={`/admin/subscribers?d=${r}`} aria-current={!q && r === range ? 'true' : undefined}>{LABEL[r]}</a>)}
      </nav>
      <form class="ad-row" method="get" action="/admin/subscribers" style="margin:0 0 20px">
        <input type="hidden" name="d" value={range} />
        <label>חיפוש לפי אימייל<input class="ltr" type="email" name="q" value={q} placeholder="name@example.com" autocomplete="off" /></label>
        <button class="ad-btn" type="submit">חיפוש</button>
        {q && <a class="ad-btn soft" href="/admin/subscribers">ניקוי</a>}
        <span style="flex:1"></span>
        <a class="ad-btn" href={`/api/admin/subscribers-export?d=${range}`} download>{range === 'all' ? 'הורדה לאקסל' : `הורדה לאקסל (${LABEL[range]})`}</a>
      </form>
      <p class="ad-muted">הרשימה נקראת ישירות מ-Brevo ולא נשמרת באתר. מי שנרשם ועדיין לא אישר את המייל (אישור כפול) יופיע רק אחרי האישור. כל הורדה נרשמת ביומן הפעולות.</p>
      {show.length ? (
        <div class="ad-scroll"><table class="ad-table"><thead><tr><th>אימייל</th><th>שם</th><th>מקור ההרשמה</th><th>הצטרף</th><th>סטטוס</th></tr></thead><tbody>
          {show.map((r) => <tr><td class="ltr">{r.email}</td><td>{[r.first, r.last].filter(Boolean).join(' ') || '—'}</td><td class="ltr">{r.source || '—'}</td><td>{fmt(r.joined)}</td><td>{r.blocked ? 'הוסר / חסום' : 'פעיל'}</td></tr>)}
        </tbody></table></div>
      ) : <p class="ad-empty">{q ? 'הכתובת לא נמצאה ברשימה.' : range === 'all' ? 'אין מצטרפים ברשימה.' : 'אין מצטרפים חדשים בתקופה הזו.'}</p>}
      {!q && pages > 1 && (
        <nav class="ad-range" aria-label="עמודים" style="margin-top:16px">
          {pg > 1 && <a href={`/admin/subscribers?d=${range}&p=${pg - 1}`}>הקודם</a>}
          <a href="#" aria-current="true" onclick="return false">עמוד {pg} מתוך {pages}</a>
          {pg < pages && <a href={`/admin/subscribers?d=${range}&p=${pg + 1}`}>הבא</a>}
        </nav>
      )}
    </>
  )}
</AdminLayout>
