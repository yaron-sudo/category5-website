---
// BRIEF §11 — article page, ported from mockups/Article.dc.html (820px column).
import Site from '@/layouts/Site.astro'
import { t } from '@/c5/i18n'
import { ARTICLES, type Article } from '@/c5/content/articles'
import { linkTerms } from '@/c5/glossaryLinks'

export function getStaticPaths() {
  return ARTICLES.map((a) => ({ params: { slug: a.slug }, props: { a } }))
}
const { a } = Astro.props as { a: Article }
const used = new Set<string>()
const grey = 'aspect-ratio: 16 / 9; background: #e9e9e7; display: flex; align-items: center; justify-content: center'
---
<Site title={a.title} description={a.excerpt} image={a.image}>
<article style="max-width: 820px; margin: 0 auto; padding: clamp(40px, 6vw, 80px) clamp(16px, 4vw, 48px) clamp(56px, 7vw, 112px); box-sizing: content-box; display: flex; flex-direction: column; gap: 24px">
<h1 style="margin: 0">{a.title}</h1>
{a.image ? <img src={a.image} alt="" style="display: block; width: 100%; height: auto"> : <div style={grey}>{t('img')}</div>}
{a.body.map((b) =>
  'h2' in b ? <h2 style="margin: 8px 0 0">{b.h2}</h2>
  : 'p' in b ? <p style="margin: 0" set:html={linkTerms(b.p, used)} />
  : b.image ? <img src={b.image} alt={b.alt ?? ''} loading="lazy" style="display: block; width: 100%; height: auto"> : <div style={grey}>{t('img')}</div>)}
</article>
</Site>
