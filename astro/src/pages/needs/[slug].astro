---
// BRIEF §7 — need page ("מה הצורך"), ported from mockups/Need.dc.html.
import Site from '@/layouts/Site.astro'
import ProductCard from '@/components/c5/ProductCard.astro'
import { NEEDS, type Need } from '@/c5/data'
import { t } from '@/c5/i18n'
import { NEED_CONTENT, NEED_INTRO_PLACEHOLDER } from '@/c5/content/needs'
import { PRODUCT_TITLE_PLACEHOLDER } from '@/c5/content/series'
import { productHref } from '@/c5/content/products'
import { getCatalog } from '@/c5/content/catalog'
import { linkTerms } from '@/c5/glossaryLinks'

export function getStaticPaths() {
  return NEEDS.map((n) => ({ params: { slug: n.slug }, props: { n } }))
}
const { n } = Astro.props as { n: Need }
const content = NEED_CONTENT[n.slug] ?? { products: [] }
const intro = content.intro?.length ? content.intro : [NEED_INTRO_PLACEHOLDER]
const catalog = await getCatalog()
const products = content.products.map((slug) => catalog.find((p) => p.slug === slug)).filter(Boolean) as typeof catalog
const used = new Set<string>()
---
<Site title={n.label} description={content.intro?.[0]}>

<section aria-label={t('banner')} style={`background: ${content.image ? '#ffffff' : '#e9e9e7'}; min-height: clamp(260px, 30vw, 480px); display: flex; align-items: center; justify-content: center; position: relative`}>
{content.image
  ? <img src={content.image} alt="" style="display: block; max-width: 100%; height: auto; margin-inline-start: auto">
  : <p style="margin: 0; font-size: 20px">{t('banner')}</p>}
<h1 class="c5-banner-title" style="position: absolute; left: clamp(16px, 4vw, 64px); bottom: clamp(24px, 4vw, 48px); margin: 0; color: #141414">{n.label}</h1>
</section>

<section style="max-width: 1280px; margin: 0 auto; padding: clamp(40px, 5vw, 72px) clamp(16px, 4vw, 48px) 24px; box-sizing: border-box">
{intro.map((p, i) => <p style={`margin: ${i ? '16px' : '0'} 0 0`} set:html={linkTerms(p, used)} />)}
</section>

<section aria-label="מוצרים בתחום" style="max-width: 1280px; margin: 0 auto; padding: 24px clamp(16px, 4vw, 48px) clamp(56px, 7vw, 112px); box-sizing: border-box">
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px">
{products.length
  ? products.map((p) => <ProductCard title={p.title} image={p.image} href={productHref(p)} series={p.series} />)
  : ['vitamins-minerals', 'professional', 'probiotics', 'plants'].map((s) => <ProductCard title={PRODUCT_TITLE_PLACEHOLDER} series={s} />)}
</div>
</section>

</Site>
