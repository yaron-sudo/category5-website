---
// BRIEF §9 — stores page (no map), ported from mockups/Stores.dc.html.
// Store list: the client's points of sale (dataset), grouped into the mockup's six regions.
import Site from '@/layouts/Site.astro'
import { getStores } from '@/lib/sanity'
import { ONLINE_SHOPS, STORE_REGIONS } from '@/c5/content/stores'

const stores = (await getStores()).filter((s) => s.category !== 'online')
// Dataset regions → the mockup's regions ("center" is split: Sharon = north of Herzliya's latitude).
const regionOf = (s: (typeof stores)[number]): (typeof STORE_REGIONS)[number] => {
  switch (s.region) {
    case 'north': return 'צפון'
    case 'haifa': return 'חיפה והקריות'
    case 'jerusalem': return 'ירושלים'
    case 'south': return 'דרום'
    case 'tel-aviv': return 'מרכז'
    default: return s.lat >= 32.15 ? 'השרון' : 'מרכז'
  }
}
const groups = STORE_REGIONS.map((name) => ({
  name,
  stores: stores.filter((s) => regionOf(s) === name).sort((a, b) => a.city.localeCompare(b.city, 'he') || a.name.localeCompare(b.name, 'he')),
}))
const btn = 'display: inline-flex; align-items: center; min-height: 44px; padding: 0 22px; border: 1px solid #141414; border-radius: 4px; color: #141414; text-decoration: none'
const row = 'padding: 10px 0; border-top: 1px solid #dcdcd9'
---
<Site title="חנויות" description="רכישה אונליין וחנויות לפי אזורים.">
<section style="max-width: 1280px; margin: 0 auto; padding: clamp(40px, 6vw, 88px) clamp(16px, 4vw, 48px) 24px; box-sizing: border-box">
<h1 style="margin: 0">חנויות</h1>
</section>

<section aria-label="רכישה אונליין" style="max-width: 1280px; margin: 0 auto; padding: 24px clamp(16px, 4vw, 48px); box-sizing: border-box">
<h2 style="margin: 0 0 16px">רכישה אונליין</h2>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
{ONLINE_SHOPS.map((o) => o.href
  ? <a href={o.href} target="_blank" rel="noopener" style={btn}>{o.name}</a>
  : <span style={btn}>{o.name}</span>)}
</div>
</section>

<section aria-label="חנויות לפי אזור" style="max-width: 1280px; margin: 0 auto; padding: clamp(32px, 4vw, 56px) clamp(16px, 4vw, 48px) clamp(56px, 7vw, 112px); box-sizing: border-box">
<h2 style="margin: 0 0 24px">חנויות לפי אזורים</h2>
<div data-c5-regions style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px 48px; align-items: start">
{groups.map((g) => (
<div>
<h3 style="margin: 0 0 8px">{g.name}</h3>
<ul style="list-style: none; margin: 0; padding: 0; border-bottom: 1px solid #dcdcd9">
{g.stores.length
  ? g.stores.map((s) => <li style={row}>{s.name}, {[s.address, s.city].filter(Boolean).join(', ')}</li>)
  : <li style={row}>שם חנות, כתובת</li>}
</ul>
</div>
))}
</div>
</section>
</Site>
