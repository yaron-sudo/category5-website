---
// /products/[slug]
//  • products of the new site (src/c5/content/products.ts) → new design (BRIEF §8)
//  • the 41 products migrated from the old site → old-design page, until they are
//    re-entered in the new catalogue (old URLs redirect to these slugs).
import ProductPage from '@/components/c5/ProductPage.astro'
import LegacyProduct from '@/components/LegacyProduct.astro'
import { PRODUCTS, type Product } from '@/c5/content/products'
import { getProduct, getProductSlugs, type ProductDoc } from '@/lib/sanity'

export async function getStaticPaths() {
  const fresh = PRODUCTS.map((product) => ({ params: { slug: product.slug }, props: { product } }))
  const taken = new Set(PRODUCTS.map((p) => p.slug))
  const slugs = (await getProductSlugs()).filter((s) => s && !taken.has(s))
  const docs = await Promise.all(slugs.map((s) => getProduct(s)))
  const legacy = docs.filter((d): d is ProductDoc => Boolean(d)).map((doc) => ({ params: { slug: doc.slug }, props: { doc } }))
  return [...fresh, ...legacy]
}
const { product, doc } = Astro.props as { product?: Product; doc?: ProductDoc }
if (!product && !doc) return new Response(null, { status: 404 })
---
{product ? <ProductPage product={product} /> : <LegacyProduct doc={doc!} />}
