---
// /products/[slug] — every product of the catalogue (hand-entered + pulled from the
// old site, see src/c5/content/catalog.ts) in the new design (BRIEF §8).
// Old slugs (replaced or hidden products) are not built: vercel.json and the server fallback
// in pages/[...path].astro answer them with a real 301 (SEO plan, 22.11.2026).
import ProductPage from '@/components/c5/ProductPage.astro'
import { getCatalog } from '@/c5/content/catalog'
import type { Product } from '@/c5/content/products'

export async function getStaticPaths() {
  return (await getCatalog()).map((product) => ({ params: { slug: product.slug }, props: { product } }))
}
const { product } = Astro.props as { product?: Product }
if (!product) return new Response(null, { status: 404 })
---
<ProductPage product={product} />
