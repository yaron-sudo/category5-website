---
// BRIEF §5 — home page, floor by floor, ported from mockups/Main.dc.html.
import Site from '@/layouts/Site.astro'
import SeriesTile from '@/components/c5/SeriesTile.astro'
import { SERIES, CONTACT } from '@/c5/data'
import { t } from '@/c5/i18n'

// "בואו נדבר בריאות": 4 article teasers. No articles yet (BRIEF §17) → placeholders as in the mockup.
const articles = Array.from({ length: 4 }, () => ({ title: 'כותרת הנושא', excerpt: 'תקציר טקסט…', href: '/articles' }))
const bannerTitle = 'margin: 0; font-size: clamp(22px, 2.3vw, 36px); line-height: 1.2; font-weight: 400; letter-spacing: 0'
const bannerLine = 'position: absolute; left: 50%; top: calc(clamp(28px, 3.2vw, 48px) + 1.2em + clamp(14px, 1.6vw, 24px)); width: 1px; height: clamp(70px, 9vw, 140px); background: #141414; z-index: 2; font-size: clamp(22px, 2.3vw, 36px)'
const field = 'display: flex; flex-direction: column; gap: 2px; font-size: 15px'
---
<Site
  title="Category 5 | Ethical Supplements"
  description="קטגוריה 5 היא חברת תוספי תזונה ישראלית המשלבת ידע וניסיון מקצועי רב־שנים, יכולות מחקר ופיתוח מתקדמות ונגישות לחומרי גלם ייחודיים ולטכנולוגיות חדשניות."
>

<section aria-label={t('banner')} style="background: #ffffff; position: relative">
<div style="position: relative; text-align: center; padding: clamp(28px, 3.2vw, 48px) 16px clamp(34px, 4.2vw, 64px)">
<h1 class="c5-sr">Category 5 | Ethical Supplements</h1>
<p class="c5-hero-title" style={bannerTitle}>תוספי תזונה <strong style="font-weight: 700">שעובדים</strong></p>
<span aria-hidden="true" style={bannerLine}></span>
</div>
<img src="/assets/banners/home-banner-1.jpg" alt="" width="2600" height="1111" fetchpriority="high" style="display: block; width: 100%; height: auto">
</section>

<section id="about" style="max-width: 1280px; margin: 0 auto; padding: clamp(48px, 6vw, 96px) clamp(16px, 4vw, 48px); box-sizing: border-box">
<div style="display: flex; flex-direction: column; gap: 16px; text-align: right">
<p style="margin: 0; font-weight: 700" dir="ltr"><span style="display: inline-block; direction: ltr">Category 5 | Ethical Supplements</span></p>
<p style="margin: 0">קטגוריה 5 היא חברת תוספי תזונה ישראלית המשלבת ידע וניסיון מקצועי רב־שנים, יכולות מחקר ופיתוח מתקדמות ונגישות לחומרי גלם ייחודיים ולטכנולוגיות חדשניות.</p>
<p style="margin: 0">החברה מתמחה בפיתוח פורמולות מורכבות וסדרות מוצרים מקצועיות, תוך התבססות על ידע מדעי ועל מנגנוני פעולה פיזיולוגיים מוכרים בגוף. הפורמולות משלבות רכיבים פעילים שנבחרו בקפידה, מתוך חשיבה מקצועית על הרכבם ועל אופן שילובם.</p>
<p style="margin: 0">בלב העשייה עומדת תפיסת <strong>Ethical Supplements</strong> - מחויבות למקצועיות, לאיכות, לשקיפות, להגינות ולחדשנות בכל שלבי הפיתוח והייצור.</p>
</div>
</section>

<section id="series" style="background: #f7f7f5">
<div style="max-width: 1280px; margin: 0 auto; padding: clamp(48px, 6vw, 96px) clamp(16px, 4vw, 48px); box-sizing: border-box">
<h2 style="margin: 0 0 40px">הסדרות</h2>
<div class="series-grid">
{SERIES.map((s) => <SeriesTile series={s} />)}
</div>
</div>
</section>

<section aria-label={t('banner')} style="background: #ffffff; position: relative">
<div style="position: relative; text-align: center; padding: clamp(28px, 3.2vw, 48px) 16px clamp(34px, 4.2vw, 64px)">
<p class="c5-hero-title" style={bannerTitle}><strong style="font-weight: 700">פורצי גבולות</strong> בעולם תוספי התזונה</p>
<span aria-hidden="true" style={bannerLine}></span>
</div>
<img src="/assets/banners/home-banner-2.jpg" alt="" width="2600" height="1110" loading="lazy" style="display: block; width: 100%; height: auto">
</section>

<section id="articles" style="max-width: 1280px; margin: 0 auto; padding: clamp(48px, 6vw, 96px) clamp(16px, 4vw, 48px); box-sizing: border-box">
<div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 32px">
<h2 style="margin: 0">בואו נדבר בריאות</h2>
<a href="/articles" class="c5-soft" style="display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 22px; border: 1px solid #141414; color: #141414; text-decoration: none; border-radius: 4px">לכל המאמרים</a>
</div>
<div class="articles-grid">
{articles.map((a) => (
<article style="display: flex; flex-direction: column; gap: 12px">
<div style="aspect-ratio: 4 / 3; background: #e9e9e7; display: flex; align-items: center; justify-content: center">{t('img')}</div>
<h3 style="margin: 0">{a.title}</h3>
<p style="margin: 0">{a.excerpt} <a href={a.href} style="color: #141414">קרא עוד</a></p>
</article>
))}
</div>
</section>

<section aria-label={t('nav.stores')} class="c5-stores">
<div style="max-width: 1280px; margin: 0 auto; padding: clamp(64px, 9vw, 140px) clamp(16px, 4vw, 48px); box-sizing: border-box; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px">
<h2 class="c5-stores-title" style="margin: 0; font-weight: 400 !important; font-size: 28px !important"><img src="/assets/logo/category5-logo-no-slogan.png" alt="Category 5" width="1200" height="155"><span style="font-weight: 400; font-size: 28px; line-height: 1.2">- מחפשים אותנו?</span></h2>
<p style="margin: 0; max-width: 520px">מצאו את החנויות הקרובות אליכם</p>
<a href="/stores" class="c5-soft" style="display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 22px; border: 1px solid #141414; color: #141414; text-decoration: none; border-radius: 4px; margin-top: 10px; background: #ffffff">לחנויות</a>
</div>
</section>

<section id="contact" style="max-width: 1280px; margin: 0 auto; padding: clamp(48px, 6vw, 96px) clamp(16px, 4vw, 48px); box-sizing: border-box; display: flex; flex-wrap: wrap; gap: clamp(32px, 5vw, 80px)">
<div style="flex: 1 1 320px; display: flex; flex-direction: column; gap: 14px">
<h2 style="margin: 0; font-weight: 400 !important"><span style="font-weight: 400">יש לכם שאלה?</span> <strong style="font-weight: 700">אנחנו כאן.</strong></h2>
<p style="margin: 0">השאירו פרטים ונחזור אליכם</p>
<p style="margin: 6px 0 0; display: flex; align-items: center; gap: 10px">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z"></path><path d="M9 8.5c.3 2.6 2.4 5 5 5.6l1.3-1.3 2 1-.4 1.7c-4.2.3-8.3-3.6-8.4-7.8l1.7-.5 1 2z"></path></svg>
<a href={`https://wa.me/${CONTACT.whatsappIntl}`} target="_blank" rel="noopener" aria-label={`WhatsApp ${CONTACT.whatsapp}`} dir="ltr" style="color: #141414">{CONTACT.whatsapp}</a><span>הודעות בלבד</span></p>
<p style="margin: 0; display: flex; align-items: center; gap: 10px">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"></rect><path d="M3 7l9 6 9-6"></path></svg>
<a href={`mailto:${CONTACT.email}`} dir="ltr" style="color: #141414">{CONTACT.email}</a></p>
</div>
<form data-c5-form="contact" style="flex: 1 1 380px; display: flex; flex-direction: column; gap: 12px">
<label style={field}>שם
<input name="name" type="text" autocomplete="name" required class="c5-line"></label>
<label style={field}>טלפון
<input name="phone" type="tel" autocomplete="tel" required dir="ltr" class="c5-line" style="text-align: right"></label>
<label style={field}>אימייל
<input name="email" type="email" autocomplete="email" required dir="ltr" class="c5-line" style="text-align: right"></label>
<label style={field}>הודעה
<textarea name="message" rows="3" required class="c5-line" style="resize: vertical"></textarea></label>
<button type="submit" class="c5-soft" style="align-self: flex-start; margin-top: 8px; min-height: 44px; padding: 0 22px; border: 1px solid #141414; border-radius: 4px; background: #ffffff; color: #141414; font: inherit; cursor: pointer">שליחה</button>
<p data-c5-form-status role="status" aria-live="polite" style="margin: 0; font-size: 15px; min-height: 1em"></p>
</form>
</section>

</Site>
