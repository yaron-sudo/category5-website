---
// BRIEF §5 — home page, floor by floor, ported from mockups/Main.dc.html.
import Site from '@/layouts/Site.astro'
import { ABOUT } from '@/c5/content/about'
import { imgSet } from '@/c5/content/thumbs'
import SeriesTile from '@/components/c5/SeriesTile.astro'
import { SERIES, CONTACT } from '@/c5/data'
import { t } from '@/c5/i18n'

// "בואו נדבר בריאות": 4 article teasers chosen by the client (home round 3, 17.11.2026), in
// this order. A slug without an article yet shows the grey placeholder from the mockup.
import { ARTICLES } from '@/c5/content/articles'
const HOME_ARTICLES = ['epimedium-icariin', 'selenium-selenomethionine', 'elderberry', 'olive-polyphenols']
const banner = async (src: string) => (await imgSet(src, '100vw', 'banner')).srcset ?? src // same picture at the width the screen needs; the original stays src
const ban = { b1m: await banner('/assets/banners/home-banner-1-mobile.jpg'), b1: await imgSet('/assets/banners/home-banner-1.jpg', '100vw', 'banner'), b2m: await banner('/assets/banners/home-banner-2.jpg'), b2: await imgSet('/assets/banners/home-banner-2-desktop.jpg', '100vw', 'banner') }
const ART_SIZES = '(max-width: 599px) 320px, 380px' // measured card photo width: 275–363 css px
const articles = await Promise.all(HOME_ARTICLES.map(async (slug) => {
  const a = ARTICLES.find((x) => x.slug === slug)
  return a ? { title: a.title, excerpt: a.excerpt, href: `/articles/${a.slug}`, image: a.image, srcset: (await imgSet(a.image, ART_SIZES, 'article')).srcset } : { title: 'כותרת הנושא', excerpt: 'תקציר טקסט…', href: '/articles', image: undefined, srcset: undefined }
}))
const bannerTitle = 'margin: 0; font-size: clamp(22px, 2.3vw, 36px); line-height: 1.2; font-weight: 400; letter-spacing: 0'
const bannerLine = 'position: absolute; left: 50%; top: calc(clamp(28px, 3.2vw, 48px) + 1.2em + clamp(14px, 1.6vw, 24px)); width: 1px; height: clamp(70px, 9vw, 140px); background: #141414; z-index: 2; font-size: clamp(22px, 2.3vw, 36px)'
const field = 'display: flex; flex-direction: column; gap: 2px; font-size: 15px'
---
<Site
  title="קטגוריה 5 | תוספי תזונה אתיים ! חדשנות וטכנולוגיה"
  description="קטגוריה 5 היא חברת תוספי תזונה ישראלית המשלבת ידע וניסיון מקצועי רב־שנים, יכולות מחקר ופיתוח מתקדמות ונגישות לחומרי גלם ייחודיים ולטכנולוגיות חדשניות."
>

<section aria-label={t('banner')} style="background: #ffffff; position: relative">
<div style="position: relative; text-align: center; padding: clamp(28px, 3.2vw, 48px) 16px clamp(34px, 4.2vw, 64px)">
<h1 class="c5-sr">Category 5 | Ethical Supplements</h1>
<p class="c5-hero-title" style={bannerTitle}>תוספי תזונה <strong style="font-weight: 700">שעובדים</strong></p>
<span aria-hidden="true" style={bannerLine}></span>
</div>
<!-- Phones get their own portrait banner (client, 19.11.2026); wider screens keep this one. -->
<picture>
<source media="(max-width: 640px)" srcset={ban.b1m} sizes="100vw" width="1440" height="1800">
<img src="/assets/banners/home-banner-1.jpg" srcset={ban.b1.srcset} sizes="100vw" alt="" width="2600" height="1111" fetchpriority="high" style="display: block; width: 100%; height: auto">
</picture>
</section>

<section id="about" style="max-width: 1280px; margin: 0 auto; padding: clamp(48px, 6vw, 96px) clamp(16px, 4vw, 48px); box-sizing: border-box">
<div style="display: flex; flex-direction: column; gap: 16px; text-align: right">
<p style="margin: 0; font-weight: 700" dir="ltr"><span style="display: inline-block; direction: ltr">Category 5 | Ethical Supplements</span></p>
{ABOUT.map((p) => <p style="margin: 0" set:html={p.replace('Ethical Supplements', '<strong>Ethical Supplements</strong>')} />)}
</div>
</section>

<section id="series" style="background: #f7f7f5">
<div style="max-width: 1280px; margin: 0 auto; padding: clamp(48px, 6vw, 96px) clamp(16px, 4vw, 48px); box-sizing: border-box">
<h2 style="margin: 0 0 40px">הסדרות</h2>
<div class="series-grid">
{SERIES.map((s) => <SeriesTile series={s} />)}
</div>
</div>
</section>

<section aria-label={t('banner')} style="background: #ffffff; position: relative">
<div style="position: relative; text-align: center; padding: clamp(28px, 3.2vw, 48px) 16px clamp(34px, 4.2vw, 64px)">
<p class="c5-hero-title" style={bannerTitle}><strong style="font-weight: 700">פורצי גבולות</strong> בעולם תוספי התזונה</p>
<span aria-hidden="true" style={bannerLine}></span>
</div>
<!-- Desktop gets the new banner (client, 22.11.2026); phones keep the previous one. -->
<picture>
<source media="(max-width: 640px)" srcset={ban.b2m} sizes="100vw" width="2600" height="1110">
<img src="/assets/banners/home-banner-2-desktop.jpg" srcset={ban.b2.srcset} sizes="100vw" alt="" width="2576" height="1100" loading="lazy" style="display: block; width: 100%; height: auto">
</picture>
</section>

<section id="articles" style="max-width: 1280px; margin: 0 auto; padding: clamp(48px, 6vw, 96px) clamp(16px, 4vw, 48px); box-sizing: border-box">
<div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 32px">
<h2 style="margin: 0">בואו נדבר בריאות</h2>
<a href="/articles" class="c5-soft" style="display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 22px; border: 1px solid #141414; color: #141414; text-decoration: none; border-radius: 4px">לכל המאמרים</a>
</div>
<div class="articles-grid" data-art-track>
{articles.map((a) => (
<article style="display: flex; flex-direction: column; gap: 12px">
{a.image
  ? <a href={a.href} tabindex="-1" aria-hidden="true" style="display: block; aspect-ratio: 4 / 3; background: #f7f7f5; overflow: hidden"><img src={a.image} srcset={a.srcset} sizes={ART_SIZES} alt="" loading="lazy" style="display: block; width: 100%; height: 100%; object-fit: cover"></a>
  : <div style="aspect-ratio: 4 / 3; background: #e9e9e7; display: flex; align-items: center; justify-content: center">{t('img')}</div>}
<h3 style="margin: 0"><a href={a.href} style="color: #141414; text-decoration: none">{a.title}</a></h3>
<p style="margin: 0">{a.excerpt} <a href={a.href} style="color: #141414">קרא עוד</a></p>
</article>
))}
</div>
<!-- Phones only (client, 19.11.2026): the four articles are a swipe carousel, one card at a time;
     these two small arrows move it too. Hidden on wider screens, where the grid stays as is. -->
<div class="articles-nav" role="group" aria-label="ניווט בין המאמרים">
<button type="button" data-art-prev aria-label="המאמר הקודם" disabled><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></button>
<span class="articles-dots" data-art-dots aria-hidden="true">{articles.map((_, i) => <i class={i === 0 ? 'on' : ''}></i>)}</span>
<button type="button" data-art-next aria-label="המאמר הבא"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></button>
</div>
</section>

<script>
  // Home articles carousel (phones). RTL: the first article is on the right, "next" moves left.
  const track = document.querySelector<HTMLElement>('[data-art-track]')
  const prev = document.querySelector<HTMLButtonElement>('[data-art-prev]')
  const next = document.querySelector<HTMLButtonElement>('[data-art-next]')
  if (track && prev && next) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const rtl = getComputedStyle(track).direction === 'rtl'
    const cards = [...track.children] as HTMLElement[]
    const dots = [...document.querySelectorAll<HTMLElement>('[data-art-dots] i')]
    const step = () => (cards[0]?.offsetWidth || track.clientWidth) + parseFloat(getComputedStyle(track).columnGap || '0')
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth
      const pos = Math.abs(track.scrollLeft)
      prev.disabled = pos <= 2
      next.disabled = pos >= max - 2
      const at = pos >= max - 2 ? cards.length - 1 : Math.round(pos / step())
      dots.forEach((d, i) => d.classList.toggle('on', i === at))
    }
    // A hint that the row scrolls sideways: the first time it comes into view on a phone, the
    // cards slide a little towards the next article and settle back (not with reduced motion).
    if (!reduce && 'IntersectionObserver' in window) {
      new IntersectionObserver((es, io) => {
        if (!es.some((e) => e.isIntersecting) || track.scrollWidth <= track.clientWidth + 2) return
        io.disconnect()
        window.setTimeout(() => { if (Math.abs(track.scrollLeft) < 2) track.classList.add('is-nudge') }, 500)
        window.setTimeout(() => track.classList.remove('is-nudge'), 1900)
      }, { threshold: 0.6 }).observe(track)
    }
    const go = (dir: 1 | -1) => track.scrollBy({ left: dir * step() * (rtl ? -1 : 1), behavior: reduce ? 'auto' : 'smooth' })
    prev.addEventListener('click', () => go(-1))
    next.addEventListener('click', () => go(1))
    track.addEventListener('scroll', sync, { passive: true })
    window.addEventListener('resize', sync)
    sync()
  }
</script>

<section aria-label={t('nav.stores')} class="c5-stores">
<div style="max-width: 1280px; margin: 0 auto; padding: clamp(64px, 9vw, 140px) clamp(16px, 4vw, 48px); box-sizing: border-box; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px">
<h2 class="c5-stores-title" style="margin: 0; font-weight: 400 !important; font-size: 28px !important"><img src="/assets/logo/category5-logo-no-slogan.png" alt="Category 5" width="1200" height="155"><span style="font-weight: 400; font-size: 28px; line-height: 1.2">- מחפשים אותנו?</span></h2>
<p style="margin: 0; max-width: 520px">מצאו את החנויות הקרובות אליכם</p>
<a href="/stores" class="c5-soft" style="display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 22px; border: 1px solid #141414; color: #141414; text-decoration: none; border-radius: 4px; margin-top: 10px; background: #ffffff">לחנויות</a>
</div>
</section>

<section id="contact" style="max-width: 1280px; margin: 0 auto; padding: clamp(48px, 6vw, 96px) clamp(16px, 4vw, 48px); box-sizing: border-box; display: flex; flex-wrap: wrap; gap: clamp(32px, 5vw, 80px)">
<div style="flex: 1 1 320px; display: flex; flex-direction: column; gap: 14px">
<h2 style="margin: 0; font-weight: 400 !important"><span style="font-weight: 400">יש לכם שאלה?</span> <strong style="font-weight: 700">אנחנו כאן.</strong></h2>
<p style="margin: 0">השאירו פרטים ונחזור אליכם</p>
<p style="margin: 6px 0 0; display: flex; align-items: center; gap: 10px">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z"></path><path d="M9 8.5c.3 2.6 2.4 5 5 5.6l1.3-1.3 2 1-.4 1.7c-4.2.3-8.3-3.6-8.4-7.8l1.7-.5 1 2z"></path></svg>
<a href={`https://wa.me/${CONTACT.whatsappIntl}`} target="_blank" rel="noopener" aria-label={`WhatsApp ${CONTACT.whatsapp}`} dir="ltr" style="color: #141414">{CONTACT.whatsapp}</a><span>הודעות בלבד</span></p>
<p style="margin: 0; display: flex; align-items: center; gap: 10px">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"></rect><path d="M3 7l9 6 9-6"></path></svg>
<a href={`mailto:${CONTACT.email}`} dir="ltr" data-copied={t('mail.copied')} style="color: #141414">{CONTACT.email}</a></p>
</div>
<form data-c5-form="contact" data-sent-title={t('form.sentTitle')} data-sent-text={t('form.sentText')} data-again={t('form.again')} data-error={t('form.error')} style="flex: 1 1 380px; display: flex; flex-direction: column; gap: 12px">
<label style={field}>שם
<input name="name" type="text" autocomplete="name" required class="c5-line"></label>
<label style={field}>טלפון
<input name="phone" type="tel" autocomplete="tel" required dir="ltr" class="c5-line" style="text-align: right"></label>
<label style={field}>אימייל
<input name="email" type="email" autocomplete="email" required dir="ltr" class="c5-line" style="text-align: right"></label>
<label style={field}>הודעה
<textarea name="message" rows="3" required class="c5-line" style="resize: vertical"></textarea></label>
<button type="submit" class="c5-soft" style="align-self: flex-start; margin-top: 8px; min-height: 44px; padding: 0 22px; border: 1px solid #141414; border-radius: 4px; background: #ffffff; color: #141414; font: inherit; cursor: pointer">שליחה</button>
<p data-c5-form-status role="status" aria-live="polite" style="margin: 0; font-size: 15px; min-height: 1em"></p>
</form>
</section>

</Site>
