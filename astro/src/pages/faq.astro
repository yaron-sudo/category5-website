---
import Base from '@/layouts/Base.astro'
import PageHero from '@/components/PageHero.astro'
import { getPage, getAllProductCards, plainText, resolveSeo } from '@/lib/sanity'

// "תמיכה ומידע": the AI assistant (POST /api/ask, streamed) — answers from the
// site's product content first, then the web — plus the CMS FAQ list.
const [doc, products] = await Promise.all([getPage('faq'), getAllProductCards()])
const title = doc?.title || 'תמיכה ומידע'
const intro = plainText(doc?.body, 400) || 'שאלו כל שאלה על המוצרים שלנו.'
const faqs = (doc?.faqs ?? []).filter((f) => f.question && f.answer)
const seo = resolveSeo(doc?.seo, { title, description: intro })
const pick = (slug: string) => products.find((p) => p.slug === slug)?.name
const suggestions = [
  pick('cellinol-liposomal-vitamin-c') && `מה היתרון של ${pick('cellinol-liposomal-vitamin-c')} על פני ויטמין C רגיל?`,
  'איזה מגנזיום מתאים לשינה ולרגיעה?',
  'אילו מוצרים מתאימים לטבעונים?',
  'מה ההבדל בין ליפוזמין Mg קומפלקס למג ספקטרום?',
  'איפה אפשר לקנות את המוצרים בירושלים?',
  'מה זה ליפוזום ולמה זה משפר ספיגה?',
].filter(Boolean) as string[]
const faqLd = faqs.length
  ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) }
  : undefined
---
<Base title={seo.title} description={seo.description} noindex={seo.noindex} canonicalUrl={seo.canonical} jsonLd={faqLd}>
  <PageHero eyebrow="שאלות ותשובות" title={title} lede={intro} />

  <section class="ns-section ns-section--tight">
    <div class="ns-container">
      <div class="ai" data-ai>
        <div class="ai__head">
          <span class="ai__badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.7 4.8L18.5 9l-4.8 1.7L12 15l-1.7-4.3L5.5 9l4.8-1.2z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg>
          </span>
          <div>
            <h2 class="ai__title">העוזר החכם של קטגוריה 5</h2>
            <p class="ai__sub">עונה קודם כול לפי המידע באתר, ומשלים ממקורות ברשת כשצריך.</p>
          </div>
        </div>

        <ol class="ai__log" data-ai-log aria-live="polite" aria-label="שיחה עם העוזר"></ol>

        <div class="ai__sugs" data-ai-sugs>
          {suggestions.map((q) => <button type="button" class="ai__sug" data-ai-sug>{q}</button>)}
        </div>

        <form class="ai__form" data-ai-form>
          <label class="sr-only" for="ai-q">השאלה שלכם</label>
          <textarea id="ai-q" name="q" rows="2" maxlength="800" placeholder="למשל: מה ההבדל בין סלינאול לסלינאול ג׳וניור?" required></textarea>
          <button type="submit" class="ns-btn ns-btn--primary ai__send" data-ai-send>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 3 10.5 13.5M21 3l-7 18-3.5-7.5L3 10z"/></svg>
            שאלו
          </button>
        </form>
        <p class="ai__note">
          התשובות נוצרות באופן אוטומטי ועלולות לכלול טעויות. אין בהן ייעוץ רפואי ואין הן תחליף להתייעצות עם רופא או רוקח.
          לא עניתם? <a href="/contact">צרו קשר</a> או שלחו הודעת ווטסאפ ל-<a href="https://wa.me/972539325888" dir="ltr" target="_blank" rel="noopener">053-9325888</a>.
        </p>
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="ns-section ns-section--white">
      <div class="ns-container faq">
        <h2 class="faq__h">שאלות נפוצות</h2>
        {faqs.map((f) => (
          <details class="faq__item">
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <script>
    type Turn = { role: 'user' | 'assistant'; content: string }
    const root = document.querySelector<HTMLElement>('[data-ai]')
    if (root) {
      const log = root.querySelector<HTMLOListElement>('[data-ai-log]')!
      const form = root.querySelector<HTMLFormElement>('[data-ai-form]')!
      const input = form.querySelector('textarea')!
      const sendBtn = root.querySelector<HTMLButtonElement>('[data-ai-send]')!
      const sugs = root.querySelector<HTMLElement>('[data-ai-sugs]')!
      const history: Turn[] = []
      let busy = false

      const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!)
      // Minimal, safe markdown: escape first, then links (site paths / https only), bold, bullets, paragraphs.
      const md = (src: string) => {
        const lines = esc(src).split('\n')
        let html = ''
        let inList = false
        for (const raw of lines) {
          let l = raw
            .replace(/\[([^\]]+)\]\(((?:\/|https:\/\/)[^)\s]*)\)/g, (_m, t, u) =>
              `<a href="${u}"${u.startsWith('http') ? ' target="_blank" rel="noopener nofollow"' : ''}>${t}</a>`)
            .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
            .replace(/^#{1,4}\s+/, '')
          const li = l.match(/^\s*(?:[-*•]|\d+\.)\s+(.*)$/)
          if (li) { if (!inList) { html += '<ul>'; inList = true } html += `<li>${li[1]}</li>`; continue }
          if (inList) { html += '</ul>'; inList = false }
          if (l.trim()) html += `<p>${l}</p>`
        }
        if (inList) html += '</ul>'
        return html
      }

      const add = (role: 'user' | 'assistant', html: string) => {
        const li = document.createElement('li')
        li.className = `ai__msg ai__msg--${role}`
        li.innerHTML = `<div class="ai__bubble">${html}</div>`
        log.appendChild(li)
        li.scrollIntoView({ block: 'nearest', behavior: 'smooth' })
        return li
      }

      async function ask(q: string) {
        if (busy || !q.trim()) return
        busy = true
        sendBtn.disabled = true
        sugs.hidden = true
        add('user', `<p>${esc(q)}</p>`)
        const li = add('assistant', '<p class="ai__typing"><span></span><span></span><span></span></p>')
        const bubble = li.querySelector<HTMLElement>('.ai__bubble')!
        let text = ''
        const sources: Array<{ url: string; title: string }> = []
        let status = ''
        const render = () => {
          bubble.innerHTML =
            (status && !text ? `<p class="ai__status">${esc(status)}</p>` : '') +
            (text ? md(text) : status ? '' : '<p class="ai__typing"><span></span><span></span><span></span></p>') +
            (sources.length
              ? `<div class="ai__src"><span>מקורות מהרשת:</span><ul>${sources.map((s) => `<li><a href="${esc(s.url)}" target="_blank" rel="noopener nofollow">${esc(s.title)}</a></li>`).join('')}</ul></div>`
              : '')
        }
        try {
          const res = await fetch('/api/ask', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question: q, history }),
          })
          if (!res.ok || !res.body) {
            const msg = res.status === 429 ? 'שאלתם הרבה שאלות בזמן קצר. נסו שוב בעוד כמה דקות.'
              : res.status === 503 ? 'העוזר החכם עדיין לא הופעל. בינתיים אפשר לפנות אלינו בטופס [צור קשר](/contact).'
              : 'משהו השתבש. נסו שוב, או פנו אלינו בטופס [צור קשר](/contact).'
            text = msg; render(); return
          }
          const reader = res.body.getReader()
          const dec = new TextDecoder()
          let buf = ''
          for (;;) {
            const { done, value } = await reader.read()
            if (done) break
            buf += dec.decode(value, { stream: true })
            let nl
            while ((nl = buf.indexOf('\n')) >= 0) {
              const line = buf.slice(0, nl); buf = buf.slice(nl + 1)
              if (!line.trim()) continue
              const ev = JSON.parse(line)
              if (ev.t === 'text') text += ev.v
              else if (ev.t === 'status') status = ev.v
              else if (ev.t === 'source') sources.push({ url: ev.url, title: ev.title })
              else if (ev.t === 'error') text += (text ? '\n\n' : '') + (ev.v === 'busy' ? 'העוזר עמוס כרגע. נסו שוב בעוד רגע.' : 'משהו השתבש. נסו שוב, או פנו אלינו בטופס [צור קשר](/contact).')
              render()
            }
          }
          if (text) { history.push({ role: 'user', content: q }, { role: 'assistant', content: text }) }
        } catch {
          text = 'אין חיבור כרגע. נסו שוב בעוד רגע.'
          render()
        } finally {
          busy = false
          sendBtn.disabled = false
          input.focus()
        }
      }

      form.addEventListener('submit', (e) => { e.preventDefault(); const q = input.value; input.value = ''; ask(q) })
      input.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit() } })
      root.querySelectorAll<HTMLButtonElement>('[data-ai-sug]').forEach((b) => b.addEventListener('click', () => ask(b.textContent || '')))
      // ?q= deep link (e.g. "ask about this product" from a product page)
      const q0 = new URLSearchParams(location.search).get('q')
      if (q0) ask(q0)
    }
  </script>

  <style is:global>
    .ai { max-width: 880px; margin-inline: auto; background: #fff; border: 1px solid var(--ns-border); border-radius: var(--ns-radius-xl); box-shadow: var(--ns-shadow-lg); padding: clamp(18px, 3vw, 32px); position: relative; overflow: hidden; }
    .ai::before { content: ""; position: absolute; inset-inline: 0; inset-block-start: 0; height: 5px; background: var(--c5-holi); }
    .ai__head { display: flex; gap: 14px; align-items: center; margin-block-end: 18px; }
    .ai__badge { flex: none; width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; color: #fff; background: var(--ns-field-green); }
    .ai__title { margin: 0; font-size: clamp(20px, 2vw, 24px); font-weight: 700; }
    .ai__sub { margin: 2px 0 0; color: var(--ns-fg-muted); font-size: 15px; }
    .ai__log { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; max-height: 60vh; overflow-y: auto; }
    .ai__log:empty { display: none; }
    .ai__msg { display: flex; }
    .ai__msg--user { justify-content: flex-start; }
    .ai__msg--assistant { justify-content: flex-end; }
    .ai__bubble { max-width: 88%; padding: 12px 16px; border-radius: 18px; font-size: 16.5px; line-height: 1.7; }
    .ai__bubble p { margin: 0 0 8px; font-size: inherit; }
    .ai__bubble p:last-child { margin: 0; }
    .ai__bubble ul { margin: 4px 0 8px; padding-inline-start: 20px; }
    .ai__bubble a { color: var(--ns-pure-orange); text-decoration: underline; }
    .ai__msg--user .ai__bubble { background: var(--ns-field-green); color: #fff; border-end-start-radius: 4px; }
    .ai__msg--assistant .ai__bubble { background: var(--ns-sun-beige); border: 1px solid var(--ns-border); border-end-end-radius: 4px; }
    .ai__status { color: var(--ns-fg-muted); font-style: italic; }
    .ai__src { margin-block-start: 10px; padding-block-start: 8px; border-block-start: 1px dashed var(--ns-border); font-size: 13.5px; }
    .ai__src span { font-weight: 700; color: var(--ns-fg-muted); }
    .ai__src ul { margin: 4px 0 0; }
    .ai__typing { display: inline-flex; gap: 5px; }
    .ai__typing span { width: 7px; height: 7px; border-radius: 50%; background: var(--ns-light-gray); animation: aiDot 1.2s infinite ease-in-out; }
    .ai__typing span:nth-child(2) { animation-delay: .15s; } .ai__typing span:nth-child(3) { animation-delay: .3s; }
    @keyframes aiDot { 0%, 80%, 100% { opacity: .3; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-4px); } }
    .ai__sugs { display: flex; flex-wrap: wrap; gap: 8px; margin-block: 4px 16px; }
    .ai__sug { font: inherit; font-size: 14.5px; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--ns-border); background: var(--ns-sun-beige); color: var(--ns-fg); cursor: pointer; text-align: start; }
    .ai__sug:hover { border-color: var(--ns-pure-orange); color: var(--ns-pure-orange); }
    .ai__form { display: flex; gap: 10px; align-items: flex-end; margin-block-start: 16px; }
    .ai__form textarea { flex: 1; font: inherit; font-size: 16.5px; resize: vertical; min-height: 56px; padding: 12px 14px; border-radius: 16px; border: 1.5px solid var(--ns-border-strong); background: #fff; color: var(--ns-fg); }
    .ai__form textarea:focus { outline: none; border-color: var(--ns-pure-orange); }
    .ai__send { flex: none; }
    .ai__send:disabled { opacity: .55; cursor: wait; }
    .ai__note { margin: 12px 0 0; font-size: 13px; color: var(--ns-fg-muted); line-height: 1.6; }
    .ai__note a { color: inherit; text-decoration: underline; }
    .faq { max-width: 880px; }
    .faq__h { font-size: clamp(24px, 2.4vw, 32px); }
    .faq__item { border-block-end: 1px solid var(--ns-border); padding-block: 14px; }
    .faq__item summary { cursor: pointer; font-weight: 700; font-size: 18px; }
    .faq__item p { margin: 10px 0 0; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    @media (max-width: 640px) { .ai__form { flex-direction: column; align-items: stretch; } .ai__bubble { max-width: 96%; } }
  </style>
</Base>
