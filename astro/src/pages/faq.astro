---
import Base from '@/layouts/Base.astro'
import PortableText from '@/components/PortableText.astro'
import { getPage, resolveSeo } from '@/lib/sanity'

// FAQ page: structured Q&A (page-faq.faqs) rendered as the same accordion the
// product pages use, with a live filter and FAQPage JSON-LD. Falls back to
// the raw imported body if no structured items exist yet.
const doc = await getPage('faq')
const faqs = (doc?.faqs ?? []).filter((f) => f.question && f.answer)
const seo = resolveSeo(doc?.seo, {
  title: 'שאלות ותשובות — נייטשרסייג',
  description: 'כל מה שרציתם לדעת על שמן זרעי מרווה מרושתת: רכישה, מינונים, היריון, כשרות, טבעונות וגלוטן.',
})
const jsonLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
    }
  : undefined
---
<Base title={seo.title} description={seo.description} noindex={seo.noindex} canonicalUrl={seo.canonical} ogTitle={seo.ogTitle} ogDescription={seo.ogDescription} jsonLd={jsonLd}>
  <!-- ===== HERO ===== -->
  <section class="fh">
    <div class="ns-container fh__inner" data-reveal>
      <span class="ns-eyebrow">שאלות ותשובות</span>
      <h1 class="fh__title">{doc?.title || 'שאלות ותשובות'}</h1>
      <p class="fh__lede">כל מה שרציתם לדעת על שמן זרעי המרווה המרושתת — רכישה, שימוש, כשרות ואיכות. לא מצאתם? חפשו למטה.</p>
      {faqs.length > 0 && (
        <label class="fh__search">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></svg>
          <input type="search" data-faq-filter placeholder="חיפוש בשאלות…" autocomplete="off" aria-label="חיפוש בשאלות ותשובות" />
        </label>
      )}
    </div>
  </section>

  <!-- ===== ACCORDION ===== -->
  <section class="ns-section ns-section--white">
    <div class="ns-container pfaq">
      {faqs.length > 0 ? (
        <>
          <div class="pfaq__list" data-faq-list>
            {faqs.map((f, i) => (
              <details class="pfaq__item" data-reveal style={`transition-delay:${Math.min(i, 8) * 50}ms`} data-faq-item>
                <summary>
                  <span class="pfaq__q">{f.question}</span>
                  <span class="pfaq__toggle" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
                </summary>
                <div class="pfaq__ans"><p>{f.answer}</p></div>
              </details>
            ))}
          </div>
          <p class="pfaq__empty" data-faq-empty hidden>לא נמצאו שאלות תואמות — נסו ניסוח אחר.</p>
        </>
      ) : (
        doc?.body?.length && <PortableText blocks={doc.body} class="ns-prose m-rt" />
      )}
    </div>
  </section>

  <!-- ===== STILL HAVE A QUESTION ===== -->
  <section class="ns-section ns-section--beige">
    <div class="ns-container">
      <div class="fcta" data-reveal>
        <div>
          <h2 class="fcta__h">לא מצאתם תשובה?</h2>
          <p class="fcta__p">כל המידע על המוצרים — הרכב, מינון ותווית מלאה — נמצא בעמודי המוצרים.</p>
        </div>
        <div class="fcta__btns">
          <a class="ns-btn ns-btn--primary" href="/product">לעמוד המוצר</a>
          <a class="ns-btn ns-btn--ghost" href="https://shop.naturesage.co.il" rel="noopener">לחנות המקוונת</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* ---------- hero ---------- */
    .fh { position: relative; overflow: hidden; padding-block: clamp(48px, 7vw, 96px) clamp(28px, 4vw, 48px);
      background: radial-gradient(120% 120% at 85% 10%, color-mix(in srgb, var(--ns-immune-green) 22%, var(--ns-sun-beige)), var(--ns-sun-beige) 60%); }
    .fh__inner { max-width: 760px; }
    .fh__inner .ns-eyebrow { display: inline-flex; margin-block-end: 14px; }
    .fh__title { font-family: var(--ns-font-display); font-weight: 500; font-size: clamp(34px, 4.6vw, 60px); line-height: 1.05; letter-spacing: -0.015em; color: var(--ns-field-green); margin: 0 0 16px; }
    .fh__lede { font-size: clamp(17px, 1.4vw, 20px); line-height: 1.8; color: var(--ns-fg); opacity: .9; max-width: 56ch; margin: 0 0 26px; }
    .fh__search { display: flex; align-items: center; gap: 12px; max-width: 520px; padding: 6px 18px; background: var(--ns-bg-alt); border: 1px solid var(--ns-border); border-radius: 999px; box-shadow: var(--ns-shadow-sm); color: var(--ns-field-green); transition: box-shadow .2s var(--ns-ease-out), border-color .2s var(--ns-ease-out); }
    .fh__search:focus-within { box-shadow: var(--ns-shadow-md); border-color: color-mix(in srgb, var(--ns-pure-orange) 45%, var(--ns-border)); }
    .fh__search input { flex: 1; min-width: 0; border: none; background: transparent; padding: 10px 0; font: inherit; font-size: var(--ns-text-base); color: var(--ns-fg); outline: none; }
    .fh__search input::placeholder { color: var(--ns-light-gray); }

    /* ---------- accordion — identical to the product-page FAQ ---------- */
    .pfaq { max-width: 880px; }
    .pfaq__list { display: flex; flex-direction: column; gap: 14px; }
    .pfaq__item { background: var(--ns-bg-alt); border: 1px solid var(--ns-border); border-radius: var(--ns-radius-lg); overflow: hidden; transition: box-shadow var(--ns-dur-base) var(--ns-ease-out), border-color var(--ns-dur-base) var(--ns-ease-out); }
    .pfaq__item:hover { box-shadow: var(--ns-shadow-sm); }
    .pfaq__item[open] { box-shadow: var(--ns-shadow-md); border-color: color-mix(in srgb, var(--ns-pure-orange) 35%, var(--ns-border)); }
    .pfaq__item[hidden] { display: none; }
    .pfaq__item summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: clamp(20px, 2.2vw, 26px) clamp(20px, 2.4vw, 30px); }
    .pfaq__item summary::-webkit-details-marker { display: none; }
    .pfaq__q { font-family: var(--ns-font-display); font-weight: 600; font-size: clamp(18px, 1.7vw, 22px); line-height: 1.45; color: var(--ns-field-green); }
    .pfaq__toggle { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 999px; background: color-mix(in srgb, var(--ns-field-green) 8%, transparent); color: var(--ns-field-green); transition: transform .3s var(--ns-ease-out), background .2s var(--ns-ease-out), color .2s var(--ns-ease-out); }
    .pfaq__item[open] .pfaq__toggle { transform: rotate(45deg); background: var(--ns-pure-orange); color: var(--ns-sun-beige); }
    .pfaq__ans p { margin: 0; padding: 0 clamp(20px, 2.4vw, 30px) clamp(22px, 2.4vw, 28px); font-size: clamp(18px, 1.45vw, 21px); line-height: 1.95; color: var(--ns-fg); opacity: .92; max-width: 72ch; }
    .pfaq__empty { text-align: center; color: var(--ns-fg-muted); font-size: var(--ns-text-md); padding: 32px 0; margin: 0; }

    /* ---------- closing CTA (unified text box) ---------- */
    .fcta { display: flex; align-items: center; justify-content: space-between; gap: 28px; background: var(--ns-bg-alt); border: 1px solid var(--ns-border); border-radius: var(--ns-radius-lg); box-shadow: var(--ns-shadow-md); padding: clamp(28px, 3.2vw, 44px); }
    .fcta__h { font-family: var(--ns-font-display); font-weight: 500; font-size: clamp(24px, 2.4vw, 32px); line-height: 1.2; color: var(--ns-field-green); margin: 0 0 8px; }
    .fcta__p { font-size: var(--ns-text-md); line-height: 1.7; color: var(--ns-fg); opacity: .88; margin: 0; max-width: 54ch; }
    .fcta__btns { display: inline-grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 12px; }
    .fcta__btns .ns-btn { min-height: 54px; display: inline-flex; align-items: center; justify-content: center; white-space: nowrap; }
    @media (max-width: 760px) { .fcta { flex-direction: column; align-items: stretch; } .fcta__btns { grid-auto-flow: row; } }
  </style>

  <script>
    // Live filter: hide items whose question + answer don't match; show the
    // empty state when nothing matches. Opens matching items for scanning.
    const input = document.querySelector<HTMLInputElement>('[data-faq-filter]')
    const items = [...document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]')]
    const empty = document.querySelector<HTMLElement>('[data-faq-empty]')
    if (input && items.length) {
      const norm = (s: string) => s.toLowerCase().replace(/["'״׳]/g, '').trim()
      const texts = items.map((el) => norm(el.textContent || ''))
      input.addEventListener('input', () => {
        const q = norm(input.value)
        let shown = 0
        items.forEach((el, i) => {
          const hit = !q || texts[i].includes(q)
          el.hidden = !hit
          if (hit) { shown++; if (q.length >= 2) el.open = true }
          else el.open = false
        })
        if (empty) empty.hidden = shown > 0
      })
    }
  </script>
</Base>
