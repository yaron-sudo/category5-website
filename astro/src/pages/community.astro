---
// קהילה — the brand's Instagram feed (reels + posts, optionally posts the brand is tagged in),
// pulled through /api/instagram and rendered in the site layout: title, follow button, filter
// chips, a card grid (9:16 reels, square posts), a "tag us" strip. Static page; the feed loads
// client-side from the cached API route, so Instagram is never hit per visitor.
import Site from '@/layouts/Site.astro'
import { getSiteSettings } from '@/lib/sanity'
import { CONTACT } from '@/c5/data'

const settings = await getSiteSettings()
const igUrl = settings?.socials?.instagram || CONTACT.instagram
const handle = '@' + (igUrl.replace(/\/+$/, '').split('/').pop() || 'category.5.es')
---
<Site title="קהילה: מה מספרים עלינו ברשת" description="הרילס והפוסטים של קטגוריה 5 תוספים אתיים ושל הקהילה: טיפים, מידע מקצועי וחדשות על המוצרים, מתעדכנים ישירות מאינסטגרם.">

<section style="max-width: 1280px; margin: 0 auto; padding: clamp(40px, 5vw, 72px) clamp(16px, 4vw, 48px) 24px; box-sizing: border-box; display: flex; flex-direction: column; gap: 16px">
<h1 style="margin: 0">מה מספרים עלינו ברשת</h1>
<p style="margin: 0; max-width: 64ch">רילס, פוסטים ותיוגים מהקהילה שלנו באינסטגרם: טיפים, מידע מקצועי, חדשות על מוצרים והצצה אל מאחורי הקלעים. העמוד מתעדכן אוטומטית מהחשבון שלנו.</p>
<p style="margin: 8px 0 0"><a class="c5-button" href={igUrl} target="_blank" rel="noopener">
<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M3 7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>
עקבו אחרינו <span dir="ltr">{handle}</span></a></p>
</section>

<section class="cm" aria-label="הפיד">
<div class="cm__bar">
<div class="cm__chips" role="tablist" aria-label="סינון התוכן">
<button type="button" class="cm__chip" data-kind="" role="tab" aria-selected="true" aria-pressed="true">הכל</button>
<button type="button" class="cm__chip" data-kind="reel" role="tab" aria-selected="false" aria-pressed="false">רילס</button>
<button type="button" class="cm__chip" data-kind="post" role="tab" aria-selected="false" aria-pressed="false">פוסטים</button>
<button type="button" class="cm__chip" data-kind="tagged" role="tab" aria-selected="false" aria-pressed="false" hidden>מהקהילה</button>
</div>
<span class="cm__count" data-cm-count aria-live="polite"></span>
</div>

<!-- loading skeleton -->
<div class="cm__grid" data-cm-grid aria-busy="true">
{Array.from({ length: 8 }).map((_, i) => <div class={`cm__skel${i % 3 === 0 ? ' cm__skel--tall' : ''}`} aria-hidden="true"></div>)}
</div>

<div class="cm__more-wrap"><button type="button" class="c5-button" data-cm-more hidden>הציגו עוד</button></div>

<!-- no token / no items -->
<div class="cm__empty" data-cm-empty hidden>
<h2 style="margin: 0">הפיד מתעדכן בקרוב</h2>
<p style="margin: 0; max-width: 48ch">בינתיים כל הרילס, הסיפורים והתיוגים מחכים לכם בעמוד האינסטגרם שלנו.</p>
<a class="c5-button" href={igUrl} target="_blank" rel="noopener">לאינסטגרם <span dir="ltr">{handle}</span></a>
</div>
</section>

<section class="cm__cta" aria-label="שתפו אותנו">
<div>
<h2 style="margin: 0 0 8px">צילמתם ריל עם המוצרים? תייגו אותנו</h2>
<p style="margin: 0">תייגו <span dir="ltr">{handle}</span> או השתמשו בהאשטאג <b dir="ltr">#category5</b>, והסיפור שלכם עשוי להופיע כאן בעמוד הקהילה.</p>
</div>
<a class="c5-button" href={igUrl} target="_blank" rel="noopener">לפרופיל באינסטגרם</a>
</section>

<!-- reel player -->
<dialog class="cm__player" data-cm-player aria-label="צפייה בריל">
<button type="button" class="cm__player-close" data-cm-close aria-label="סגירה">
<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
</button>
<div class="cm__player-box">
<video data-cm-video controls playsinline preload="none"></video>
<a class="cm__player-link" data-cm-link href="#" target="_blank" rel="noopener">לפתיחה באינסטגרם</a>
</div>
</dialog>

<!-- global: the feed cards are injected by the script below, so scoped rules would never
     match them; every class is cm__-prefixed. Site tokens only: #141414, greys, 1px borders. -->
<style is:global>
.cm { max-width: 1280px; margin: 0 auto; padding: 24px clamp(16px, 4vw, 48px) clamp(40px, 5vw, 72px); box-sizing: border-box; color: #141414; }
.cm__bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
.cm__chips { display: flex; gap: 8px; flex-wrap: wrap; }
.cm__chip { display: inline-flex; align-items: center; justify-content: center; min-height: 40px; padding: 0 16px; border: 1px solid #141414; border-radius: 4px; background: #ffffff; color: #141414; font: inherit; font-size: 15px; cursor: pointer; transition: background .3s cubic-bezier(.22,.61,.36,1), color .3s cubic-bezier(.22,.61,.36,1); }
.cm__chip[aria-pressed="true"] { background: #cfccc3; }
.cm__chip:not([aria-pressed="true"]):hover { background: #efeeea; }
.cm__chip[hidden] { display: none; }
.cm__count { font-size: 15px; }

/* grid: 4 columns, reels span two rows (9:16), posts are square */
.cm__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: minmax(0, 1fr); grid-auto-flow: dense; gap: 24px; }
.cm__skel { aspect-ratio: 1; background: #f7f7f5; border: 1px solid #dcdcd9; box-sizing: border-box; }
.cm__skel--tall { aspect-ratio: 9 / 16; grid-row: span 2; }

.cm__card { position: relative; display: block; overflow: hidden; background: #f7f7f5; border: 1px solid #dcdcd9; box-sizing: border-box; isolation: isolate; aspect-ratio: 1; color: #ffffff; text-decoration: none; opacity: 0; transform: translateY(14px); animation: cmIn .6s cubic-bezier(.22,.61,.36,1) forwards; animation-delay: calc(var(--i, 0) * 50ms); }
.cm__card--reel { aspect-ratio: 9 / 16; grid-row: span 2; }
@keyframes cmIn { to { opacity: 1; transform: none; } }
.cm__card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(.22,.61,.36,1); }
.cm__card:hover img { transform: scale(1.025); }
.cm__card::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(20,20,20,.78) 0%, rgba(20,20,20,.25) 40%, transparent 65%); }
.cm__kind { position: absolute; inset-block-start: 12px; inset-inline-start: 12px; z-index: 2; display: inline-flex; align-items: center; padding: 4px 10px; border: 1px solid #141414; border-radius: 4px; background: #ffffff; color: #141414; font-size: 13px; }
.cm__play { position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; pointer-events: none; }
.cm__play span { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: #ffffff; color: #141414; border: 1px solid #141414; transition: transform .3s cubic-bezier(.22,.61,.36,1); }
.cm__card:hover .cm__play span { transform: scale(1.06); }
.cm__meta { position: absolute; inset-inline: 0; inset-block-end: 0; z-index: 2; padding: 14px 14px 12px; display: flex; flex-direction: column; gap: 4px; }
.cm__user { font-size: 13px; direction: ltr; text-align: right; }
.cm__cap { font-size: 15px; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.cm__date { font-size: 13px; opacity: .8; }

.cm__more-wrap { display: flex; justify-content: center; margin-top: 32px; }
.cm__more-wrap .c5-button[hidden] { display: none; }
.cm__empty { display: none; flex-direction: column; align-items: center; text-align: center; gap: 12px; padding: clamp(32px, 5vw, 64px) 16px; background: #f7f7f5; }
.cm__empty:not([hidden]) { display: flex; }

.cm__cta { max-width: 1280px; margin: 0 auto clamp(56px, 7vw, 112px); padding: clamp(24px, 3vw, 40px); box-sizing: border-box; width: calc(100% - 2 * clamp(16px, 4vw, 48px)); background: #f7f7f5; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
.cm__cta .c5-button { flex: none; }

.cm__player { border: 0; padding: 0; background: transparent; max-width: none; max-height: none; width: 100vw; height: 100vh; }
.cm__player::backdrop { background: rgba(20,20,20,.85); }
.cm__player-box { position: absolute; inset: 0; display: grid; place-items: center; gap: 12px; align-content: center; }
.cm__player video { width: min(420px, 92vw); max-height: 80vh; aspect-ratio: 9 / 16; background: #000; border: 1px solid #dcdcd9; }
.cm__player-link { color: #ffffff; text-decoration: underline; text-underline-offset: 3px; }
.cm__player-close { position: absolute; inset-block-start: 18px; inset-inline-end: 18px; z-index: 2; width: 44px; height: 44px; border-radius: 4px; border: 1px solid #141414; background: #ffffff; color: #141414; display: grid; place-items: center; cursor: pointer; }

@media (max-width: 1023px) { .cm__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; } }
@media (max-width: 760px) {
  .cm__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .cm__cta { flex-direction: column; align-items: flex-start; }
  .cm__bar { flex-direction: column; align-items: flex-start; }
}
@media (prefers-reduced-motion: reduce) { .cm__card { animation: none; opacity: 1; transform: none; } .cm__card img, .cm__play span { transition: none; } }
</style>

<script>
type Item = { id: string; kind: 'reel' | 'post' | 'carousel'; src: string; poster: string; permalink: string; caption: string; date: string; username: string; tagged: boolean }
const grid = document.querySelector<HTMLElement>('[data-cm-grid]')!
const empty = document.querySelector<HTMLElement>('[data-cm-empty]')!
const more = document.querySelector<HTMLButtonElement>('[data-cm-more]')!
const count = document.querySelector<HTMLElement>('[data-cm-count]')!
const chips = [...document.querySelectorAll<HTMLButtonElement>('.cm__chip')]
const player = document.querySelector<HTMLDialogElement>('[data-cm-player]')!
const video = player.querySelector<HTMLVideoElement>('[data-cm-video]')!
const link = player.querySelector<HTMLAnchorElement>('[data-cm-link]')!
const PAGE = 12
let items: Item[] = [], kind = '', shown = 0

const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!)
const fmtDate = (iso: string) => { try { return new Date(iso).toLocaleDateString('he-IL', { day: 'numeric', month: 'short', year: 'numeric' }) } catch { return '' } }
const filtered = () => items.filter((it) => !kind || (kind === 'tagged' ? it.tagged : kind === 'post' ? it.kind !== 'reel' : it.kind === kind))

const card = (it: Item, i: number) => {
  const reel = it.kind === 'reel'
  const label = it.tagged ? 'מהקהילה' : reel ? 'ריל' : it.kind === 'carousel' ? 'קרוסלה' : 'פוסט'
  return `<a class="cm__card${reel ? ' cm__card--reel' : ''}" href="${esc(it.permalink)}" target="_blank" rel="noopener" style="--i:${i % PAGE}" data-id="${esc(it.id)}" ${reel && it.src ? `data-video="${esc(it.src)}"` : ''}>
    <img src="${esc(it.poster)}" alt="${esc(it.caption.slice(0, 80))}" loading="lazy" />
    <span class="cm__kind">${label}</span>
    ${reel ? '<span class="cm__play"><span><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg></span></span>' : ''}
    <span class="cm__meta">
      ${it.username ? `<span class="cm__user">@${esc(it.username)}</span>` : ''}
      ${it.caption ? `<span class="cm__cap">${esc(it.caption)}</span>` : ''}
      ${it.date ? `<span class="cm__date">${fmtDate(it.date)}</span>` : ''}
    </span>
  </a>`
}

const render = (reset = true) => {
  const list = filtered()
  if (reset) { grid.innerHTML = ''; shown = 0 }
  const slice = list.slice(shown, shown + PAGE)
  grid.insertAdjacentHTML('beforeend', slice.map(card).join(''))
  shown += slice.length
  more.hidden = shown >= list.length
  count.textContent = list.length ? `${list.length} פריטים` : ''
  empty.hidden = list.length > 0
  grid.setAttribute('aria-busy', 'false')
}

chips.forEach((c) => c.addEventListener('click', () => {
  chips.forEach((x) => { x.setAttribute('aria-pressed', String(x === c)); x.setAttribute('aria-selected', String(x === c)) })
  kind = c.dataset.kind || ''
  render()
}))
more.addEventListener('click', () => render(false))

// reels play in a lightbox (direct mp4 from the API); anything else opens Instagram
grid.addEventListener('click', (e) => {
  const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('.cm__card[data-video]')
  if (!a) return
  e.preventDefault()
  video.src = a.dataset.video!
  video.poster = a.querySelector('img')?.src || ''
  link.href = a.href
  player.showModal()
  video.play().catch(() => {})
})
const close = () => { video.pause(); video.removeAttribute('src'); video.load(); player.close() }
player.querySelector('[data-cm-close]')!.addEventListener('click', close)
player.addEventListener('click', (e) => { if (e.target === player) close() })
player.addEventListener('close', () => { video.pause() })

fetch('/api/instagram', { headers: { Accept: 'application/json' } })
  .then((r) => r.json())
  .then((data: { configured: boolean; items: Item[] }) => {
    items = data.items || []
    chips.find((c) => c.dataset.kind === 'tagged')!.hidden = !items.some((it) => it.tagged)
    render()
  })
  .catch(() => { items = []; render() })
</script>

</Site>
