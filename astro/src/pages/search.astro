---
// BRIEF §12 — search, ported from mockups/Search.dc.html. Client-side search over
// products, series and needs. Each item's index includes names, series, short text,
// benefits, usage and extra keywords (products.ts / overrides.ts `keywords`), so
// everyday words, benefits and uses find the product too.
import Site from '@/layouts/Site.astro'
import ProductCard from '@/components/c5/ProductCard.astro'
import { SERIES, NEEDS, seriesHref, needHref } from '@/c5/data'
import { t } from '@/c5/i18n'
import { getCatalog } from '@/c5/content/catalog'
import { productHref } from '@/c5/content/products'
import { NEED_CONTENT } from '@/c5/content/needs'

const catalog = await getCatalog()
const seriesName = (slug: string) => SERIES.find((s) => s.slug === slug)?.name ?? ''
const needsOf = (slug: string) => NEEDS.filter((n) => NEED_CONTENT[n.slug]?.products.includes(slug)).map((n) => n.label)
const idx = (parts: Array<string | undefined>) => parts.filter(Boolean).join(' ').toLowerCase()
const chip = 'min-height: 40px; padding: 0 16px; border: 1px solid #141414; border-radius: 4px; font: inherit; cursor: pointer'
const tile = 'display: flex; flex-direction: column; height: 100%; text-decoration: none; color: #141414; background: #ffffff; border: 1px solid #dcdcd9; box-sizing: border-box'
---
<Site title="חיפוש">
<section style="max-width: 960px; margin: 0 auto; padding: clamp(40px, 6vw, 88px) clamp(16px, 4vw, 48px) 24px; box-sizing: content-box; display: flex; flex-direction: column; gap: 16px">
<h1 style="margin: 0">חיפוש</h1>
<form role="search" data-search-form style="display: flex; gap: 8px">
<label for="q" style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0)">חיפוש באתר</label>
<input id="q" name="q" type="search" placeholder="שם מוצר, תחום, רכיב או שימוש" style="flex: 1 1 auto; min-width: 0; min-height: 48px; border: 1px solid #141414; border-radius: 4px; padding: 0 14px; font: inherit">
<button type="submit" style="min-height: 48px; padding: 0 22px; border: 1px solid #141414; border-radius: 4px; background: #ffffff; color: #141414; font: inherit; cursor: pointer">חיפוש</button>
</form>
<div role="group" aria-label="סינון" style="display: flex; flex-wrap: wrap; gap: 8px">
<button type="button" data-filter="all" aria-pressed="true" style={`${chip}; background: #141414; color: #ffffff`}>הכל</button>
<button type="button" data-filter="series" aria-pressed="false" style={`${chip}; background: #ffffff; color: #141414`}>סדרות</button>
<button type="button" data-filter="needs" aria-pressed="false" style={`${chip}; background: #ffffff; color: #141414`}>מה הצורך</button>
<button type="button" data-filter="products" aria-pressed="false" style={`${chip}; background: #ffffff; color: #141414`}>מוצרים</button>
</div>
</section>

<section style="max-width: 1280px; margin: 0 auto; padding: 24px clamp(16px, 4vw, 48px) clamp(56px, 7vw, 112px); box-sizing: border-box">
<h2 style="margin: 0 0 16px">תוצאות</h2>
<div data-search-results style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 24px">
{SERIES.map((s) => (
<div data-kind="series" data-index={idx([s.name])}>
<a href={seriesHref(s)} style={tile}>
<div style="aspect-ratio: 1 / 1; background: #f7f7f5; display: flex; align-items: center; justify-content: center"><img src={s.icon} alt="" style="width: 96px; height: 96px"></div>
<div style="padding: 16px; display: flex; flex-direction: column; gap: 8px"><span style="font-size: 20px; line-height: 1.3">{s.name}</span></div>
</a>
</div>
))}
{NEEDS.map((n) => (
<div data-kind="needs" data-index={idx([n.label])}>
<a href={needHref(n)} style={tile}>
<div style="aspect-ratio: 1 / 1; background: #e9e9e7; display: flex; align-items: center; justify-content: center">{t('img')}</div>
<div style="padding: 16px; display: flex; flex-direction: column; gap: 8px"><span style="font-size: 20px; line-height: 1.3">{n.label}</span></div>
</a>
</div>
))}
{catalog.map((p) => (
<div data-kind="products" data-index={idx([p.title, p.fullTitle, seriesName(p.series), ...needsOf(p.slug), ...(p.intro ?? []), ...(p.benefits ?? []), ...(p.usage ?? []), ...(p.keywords ?? [])])}>
<ProductCard title={p.title} image={p.image} href={productHref(p)} series={p.series} />
</div>
))}
</div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-search-form]')!
  const input = form.querySelector('input')!
  const items = [...document.querySelectorAll<HTMLElement>('[data-search-results] > [data-kind]')]
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')]
  let filter = 'all'
  // Hebrew: ignore niqqud / punctuation, and allow one-letter prefixes (ה/ב/ל/ו/מ/ש/כ) on query words.
  const norm = (s: string) => s.toLowerCase().replace(/[֑-ׇ"'׳״.,\-–]/g, ' ').replace(/\s+/g, ' ').trim()
  const apply = () => {
    const words = norm(input.value).split(' ').filter(Boolean)
    for (const el of items) {
      const hay = norm(el.dataset.index || '')
      const okKind = filter === 'all' || el.dataset.kind === filter
      const okText = words.every((w) => hay.includes(w) || (w.length > 3 && /^[הבלומשכ]/.test(w) && hay.includes(w.slice(1))))
      el.hidden = !(okKind && okText)
    }
  }
  const setFilter = (f: string) => {
    filter = f
    chips.forEach((c) => {
      const on = c.dataset.filter === f
      c.setAttribute('aria-pressed', String(on))
      c.style.background = on ? '#141414' : '#ffffff'
      c.style.color = on ? '#ffffff' : '#141414'
    })
    apply()
  }
  chips.forEach((c) => c.addEventListener('click', () => setFilter(c.dataset.filter!)))
  form.addEventListener('submit', (e) => { e.preventDefault(); apply(); history.replaceState(null, '', input.value ? `?q=${encodeURIComponent(input.value)}` : location.pathname) })
  input.addEventListener('input', apply)
  const params = new URLSearchParams(location.search)
  input.value = params.get('q') || ''
  setFilter(['series', 'needs', 'products'].includes(params.get('filter') || '') ? params.get('filter')! : 'all')
</script>
<style is:global>
  [data-search-results] > [hidden] { display: none !important; }
  /* Results are filtered live: no position-based reveal delay here. */
  [data-search-results].c5-stagger > * { opacity: 1 !important; transform: none !important; }
</style>
</Site>
