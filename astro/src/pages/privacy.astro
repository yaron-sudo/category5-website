---
import LegalLayout from '@/layouts/LegalLayout.astro'
import PortableText from '@/components/PortableText.astro'
import { getPage, plainText } from '@/lib/sanity'

// The client's own text from the old site, edited in the CMS (עמודים נוספים → privacy).
const doc = await getPage('privacy')
---
<LegalLayout
  heading={doc?.title ?? ''}
  title={doc?.seo?.metaTitle || doc?.title || ''}
  description={doc?.seo?.metaDescription || plainText(doc?.body, 155)}
>
  <PortableText blocks={doc?.body} />
</LegalLayout>
