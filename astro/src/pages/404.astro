---
// 404 — the site layout, noindex. Also rendered by the server fallback (src/pages/[...path].astro)
// with a 404 / 410 status for unknown and removed URLs.
import Site from '@/layouts/Site.astro'
import { t } from '@/c5/i18n'
---
<Site title="העמוד לא נמצא" description="העמוד שחיפשתם לא נמצא באתר קטגוריה 5 תוספים אתיים." noindex>
<section style="max-width: 1280px; margin: 0 auto; padding: clamp(64px, 9vw, 140px) clamp(16px, 4vw, 48px); box-sizing: border-box; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px">
<p dir="ltr" aria-hidden="true" style="margin: 0; font-size: clamp(72px, 14vw, 140px); font-weight: 600; line-height: 1; color: #dcdcd9">404</p>
<h1 style="margin: 0">העמוד לא נמצא</h1>
<p style="margin: 0; max-width: 46ch">ייתכן שהקישור שגוי או שהעמוד הוסר. אפשר לחזור לדף הבית ולהמשיך משם.</p>
<a class="c5-button" href="/" style="margin-top: 12px">חזרה ל{t('home')}</a>
</section>
<script is:inline>window.__c5Status = 404</script>
</Site>
