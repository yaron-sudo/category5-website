---
import Base from '@/layouts/Base.astro'
import PageHero from '@/components/PageHero.astro'
import ContentSections from '@/components/ContentSections.astro'
import { getCategories, getCategory, getAllProductCards, urlFor, resolveSeo, plainText, type CategoryDoc, type PortableBlock } from '@/lib/sanity'

// Product family page: hero (family colour) → product grid → the family's text.
export async function getStaticPaths() {
  const cats = await getCategories()
  return cats.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }))
}
const slug = Astro.params.slug ?? ''
const cat: CategoryDoc | null = (Astro.props as { cat?: CategoryDoc }).cat ?? (await getCategory(slug))
if (!cat) return new Response(null, { status: 404 })

const products = (await getAllProductCards()).filter((p) => p.category?.slug === cat.slug)
const others = (await getCategories()).filter((c) => c.slug !== cat.slug)

// Body → text cards, one per h2.
const blockText = (b: PortableBlock) => ((b.children as Array<{ text?: string }> | undefined) ?? []).map((c) => c.text ?? '').join('')
const sections: Array<{ heading: string; blocks: PortableBlock[] }> = []
for (const b of cat.body ?? []) {
  if (b._type === 'block' && b.style === 'h2') { sections.push({ heading: blockText(b), blocks: [] }); continue }
  if (!sections.length) sections.push({ heading: '', blocks: [] })
  sections[sections.length - 1].blocks.push(b)
}
const heroImg = cat.image?.asset ? urlFor(cat.image).width(1000).fit('max').auto('format').url() : undefined
const seo = resolveSeo(cat.seo, {
  title: `${cat.title} | קטגוריה 5 תוספים אתיים`,
  description: cat.tagline?.slice(0, 155) || plainText(cat.body),
  image: heroImg,
})
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: cat.title,
  itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/products/${p.slug}`, Astro.site).href, name: p.name })),
}
---
<Base title={seo.title} description={seo.description} image={seo.image} noindex={seo.noindex} canonicalUrl={seo.canonical} jsonLd={itemList}>
  <div class="cat" style={cat.color ? `--fam:${cat.color};--ns-pure-orange:${cat.color}` : undefined}>
    <PageHero eyebrow="משפחת מוצרים" title={cat.title} lede={cat.tagline} image={heroImg ? { src: heroImg, alt: cat.title } : null} />

    <section class="ns-section ns-section--tight">
      <div class="ns-container">
        <h2 class="cat__h">המוצרים ב{cat.title} <span>({products.length})</span></h2>
        <ul class="cat__grid">
          {products.map((p, i) => (
            <li data-reveal style={`transition-delay:${Math.min(i, 8) * 50}ms`}>
              <a class="cat__card" href={`/products/${p.slug}`}>
                <span class="cat__media">{p.image?.asset && <img src={urlFor(p.image).width(600).fit('max').url()} alt="" loading={i < 4 ? 'eager' : 'lazy'} />}</span>
                {p.isNew && <span class="cat__new">חדש</span>}
                <span class="cat__name">{p.name}</span>
                {p.tagline && <span class="cat__tag">{p.tagline}</span>}
                <span class="cat__go">לפרטים ←</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {sections.length > 0 && (
      <section class="ns-section ns-section--white">
        <div class="ns-container">
          <ContentSections sections={sections} />
        </div>
      </section>
    )}

    <section class="ns-section ns-section--tight">
      <div class="ns-container">
        <h2 class="cat__h">משפחות מוצרים נוספות</h2>
        <ul class="cat__fams">
          {others.map((c) => (
            <li><a href={`/category/${c.slug}`} style={`--c:${c.color}`}>
              {c.icon?.asset && <img src={urlFor(c.icon).width(80).url()} alt="" width="32" height="32" />}{c.title}
            </a></li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <style>
    .cat :global(.ph2) { border-block-end: 5px solid var(--fam); }
    .cat__h { font-family: var(--ns-font-display); font-size: clamp(24px, 2.4vw, 32px); font-weight: 700; margin: 0 0 22px; }
    .cat__h span { color: var(--ns-fg-muted); font-weight: 400; font-size: .7em; }
    .cat__grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
    .cat__card { position: relative; display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 14px 14px 18px; background: #fff; border: 1px solid var(--ns-border); border-radius: var(--ns-radius-lg); color: var(--ns-fg); text-decoration: none; transition: transform var(--ns-dur-base) var(--ns-ease-out), box-shadow var(--ns-dur-base) var(--ns-ease-out); }
    .cat__card:hover { transform: translateY(-4px); box-shadow: var(--ns-shadow-md); color: var(--ns-fg); }
    .cat__media { aspect-ratio: 1; display: grid; place-items: center; background: color-mix(in srgb, var(--fam) 7%, #fff); border-radius: var(--ns-radius-md); margin-block-end: 6px; }
    .cat__media img { width: 86%; height: 86%; object-fit: contain; }
    .cat__new { position: absolute; inset-block-start: 22px; inset-inline-start: 22px; background: var(--fam); color: #fff; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 999px; }
    .cat__name { font-weight: 700; font-size: 17px; line-height: 1.3; }
    .cat__tag { font-size: 14.5px; color: var(--ns-fg-muted); line-height: 1.45; flex: 1; }
    .cat__go { font-weight: 700; font-size: 14px; color: var(--fam); }
    .cat__fams { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
    .cat__fams a { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px 8px 12px; border-radius: 999px; background: #fff; border: 1px solid var(--ns-border); border-inline-start: 4px solid var(--c); color: var(--ns-fg); font-weight: 600; text-decoration: none; }
    .cat__fams a:hover { box-shadow: var(--ns-shadow-md); }
    .cat__fams img { width: 26px; height: 26px; object-fit: contain; }
    @media (max-width: 1024px) { .cat__grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 640px) { .cat__grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } .cat__name { font-size: 15px; } .cat__tag { font-size: 13px; } }
  </style>
</Base>
