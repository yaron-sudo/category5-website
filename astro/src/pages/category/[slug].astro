---
// /category/<family> — the old site's six product-family pages (ויטמין C ליפוזומלי, מערכת החיסון…),
// kept as landing pages (they are the 301 targets of the WordPress categories and carry the
// client's own texts), in the site layout, like a need page (BRIEF §7): banner area → text →
// product grid. Products are the family's products as they exist in the new catalogue
// (replaced slugs follow their replacement, hidden ones are left out). Linked from the
// matching series pages ("קריאה נוספת") and between themselves, so none is an orphan.
import Site from '@/layouts/Site.astro'
import ProductCard from '@/components/c5/ProductCard.astro'
import { getCategories, fetchQ, resolveSeo, plainText, type CategoryDoc, type PortableBlock } from '@/lib/sanity'
import { getCatalog, replacedSlugs, FAMILY_TO_SERIES } from '@/c5/content/catalog'
import { productHref } from '@/c5/content/products'
import { PRODUCT_SUMMARIES } from '@/c5/content/summaries'
import { SERIES, seriesHref } from '@/c5/data'
import { linkTerms } from '@/c5/glossaryLinks'
import { t } from '@/c5/i18n'
import { breadcrumbLd } from '@/c5/seo'

export async function getStaticPaths() {
  const cats = await getCategories()
  return cats.map((c) => ({ params: { slug: c.slug }, props: { cat: c, cats } }))
}
const { cat, cats } = Astro.props as { cat: CategoryDoc; cats: CategoryDoc[] }

// The family's products in the new catalogue, in the old order.
const familySlugs = await getCatalogFamily(cat.slug)
const catalog = await getCatalog()
const bySlug = new Map(catalog.map((p) => [p.slug, p]))
const replaced = replacedSlugs()
const seen = new Set<string>()
const products = familySlugs
  .map((slug) => bySlug.get(replaced[slug] ?? slug))
  .filter((p): p is NonNullable<typeof p> => !!p && !seen.has(p.slug) && !!seen.add(p.slug))

function getCatalogFamily(family: string): Promise<string[]> {
  return fetchQ<string[]>(`*[_type == "product" && defined(slug.current) && category->slug.current == $family] | order(orderRank asc).slug.current`, { family })
}

// Body (portable text: h2 / paragraphs / bullet lists, no marks) → HTML in the site's type.
const text = (b: PortableBlock) => ((b.children as Array<{ text?: string }> | undefined) ?? []).map((c) => c.text ?? '').join('')
const used = new Set<string>()
type Node = { h2: string } | { p: string } | { ul: string[] }
const nodes: Node[] = []
for (const b of cat.body ?? []) {
  if (b._type !== 'block') continue
  const s = text(b).trim()
  if (!s) continue
  if (b.style === 'h2') nodes.push({ h2: s })
  else if ((b as { listItem?: string }).listItem) {
    const last = nodes[nodes.length - 1]
    if (last && 'ul' in last) last.ul.push(s); else nodes.push({ ul: [s] })
  } else nodes.push({ p: s })
}

const series = SERIES.find((s) => s.slug === FAMILY_TO_SERIES[cat.slug])
const others = cats.filter((c) => c.slug !== cat.slug)
// Title distinct from the series page of the same name (/series/vitamins-minerals).
const seo = resolveSeo(cat.seo, {
  title: `${cat.title} – משפחת מוצרים`,
  description: (cat.tagline || plainText(cat.body) || '').slice(0, 155),
})
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: cat.title,
  itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(productHref(p) as string, Astro.site).href, name: p.title })),
}
---
<Site title={seo.title} description={seo.description} noindex={seo.noindex} jsonLd={[itemList, breadcrumbLd([{ name: t('home'), href: '/' }, ...(series ? [{ name: series.name, href: seriesHref(series) }] : []), { name: cat.title, href: `/category/${cat.slug}` }], Astro.site)]}>

<section aria-label={t('banner')} style="background: #e9e9e7; min-height: clamp(220px, 26vw, 400px); display: flex; align-items: center; justify-content: center; position: relative">
<p style="margin: 0; font-size: 20px">{t('banner')}</p>
<h1 class="c5-banner-title" style="position: absolute; left: clamp(16px, 4vw, 64px); bottom: clamp(24px, 4vw, 48px); margin: 0; color: #141414">{cat.title}</h1>
</section>

<section style="max-width: 1280px; margin: 0 auto; padding: clamp(40px, 5vw, 72px) clamp(16px, 4vw, 48px) 24px; box-sizing: border-box">
<div style="max-width: 760px; display: flex; flex-direction: column; gap: 16px">
{cat.tagline && <p style="margin: 0" set:html={linkTerms(cat.tagline, used)} />}
{nodes.map((n) =>
  'h2' in n ? <h2 style="margin: 16px 0 0">{n.h2}</h2>
  : 'p' in n ? <p style="margin: 0" set:html={linkTerms(n.p, used)} />
  : <ul style="margin: 0; padding-inline-start: 22px; display: flex; flex-direction: column; gap: 6px">{n.ul.map((x) => <li set:html={linkTerms(x, used)} />)}</ul>)}
{series && <p style="margin: 8px 0 0">{t('readMore')}: <a href={seriesHref(series)} style="color: #141414">{series.name}</a></p>}
</div>
</section>

{products.length > 0 && (
<section aria-label="מוצרים" style="max-width: 1280px; margin: 0 auto; padding: 24px clamp(16px, 4vw, 48px) 24px; box-sizing: border-box">
<h2 style="margin: 0 0 24px">המוצרים</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px">
{products.map((p) => <ProductCard title={p.title} summary={PRODUCT_SUMMARIES[p.slug]} image={p.image} href={productHref(p)} series={p.series} newPack={p.newPack} />)}
</div>
</section>
)}

<nav aria-label="משפחות מוצרים נוספות" style="max-width: 1280px; margin: 0 auto; padding: 24px clamp(16px, 4vw, 48px) clamp(56px, 7vw, 112px); box-sizing: border-box">
<h2 style="margin: 0 0 16px">משפחות מוצרים נוספות</h2>
<ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px">
{others.map((c) => <li><a class="c5-soft" href={`/category/${c.slug}`} style="display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border: 1px solid #dcdcd9; border-radius: 4px; background: #ffffff; color: #141414; text-decoration: none; font-size: 15px">{c.title}</a></li>)}
</ul>
</nav>

</Site>
