---
// BRIEF §6 — series page, ported from mockups/Series.dc.html:
// full-width banner (no title: the name is in the image) → short description → product grid.
// Content lives in src/c5/content/series.ts and products.ts.
import Site from '@/layouts/Site.astro'
import ProductCard from '@/components/c5/ProductCard.astro'
import { SERIES, type Series } from '@/c5/data'
import { t } from '@/c5/i18n'
import { SERIES_CONTENT, SERIES_INTRO_PLACEHOLDER, PRODUCT_TITLE_PLACEHOLDER, PLACEHOLDER_GRID_SIZE } from '@/c5/content/series'
import { productHref } from '@/c5/content/products'
import { productsOfSeries } from '@/c5/content/catalog'
import { linkTerms } from '@/c5/glossaryLinks'

export function getStaticPaths() {
  return SERIES.map((s) => ({ params: { slug: s.slug }, props: { s } }))
}
const { s } = Astro.props as { s: Series }
const content = SERIES_CONTENT[s.slug] ?? { fillPlaceholders: true }
const intro = content.intro?.length ? content.intro : [SERIES_INTRO_PLACEHOLDER]
const products = (await productsOfSeries(s.slug)).map((p) => ({ title: p.title, image: p.image, href: productHref(p) as string | undefined }))
const cards = content.fillPlaceholders
  ? [...products, ...Array.from({ length: Math.max(0, PLACEHOLDER_GRID_SIZE - products.length) }, () => ({ title: PRODUCT_TITLE_PLACEHOLDER, image: undefined, href: undefined }))]
  : products
---
<Site title={s.name} description={content.intro?.[0]} image={s.banner}>

<section aria-label={t('banner')}>
<h1 class="c5-sr">{s.name}</h1>
<img src={s.banner} alt={s.name} width="2576" height="1100" fetchpriority="high" style="display: block; width: 100%; height: auto">
</section>

<section style="max-width: 1280px; margin: 0 auto; padding: clamp(40px, 5vw, 72px) clamp(16px, 4vw, 48px) 24px; box-sizing: border-box">
{intro.map((p, i) => <p style={`margin: ${i ? '16px' : '0'} 0 0; max-width: 820px`} set:html={linkTerms(p)} />)}
</section>

<section aria-label="מוצרי הסדרה" style="max-width: 1280px; margin: 0 auto; padding: 24px clamp(16px, 4vw, 48px) clamp(56px, 7vw, 112px); box-sizing: border-box">
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px">
{cards.map((c) => <ProductCard title={c.title} image={c.image} href={c.href} series={s.slug} />)}
</div>
</section>

</Site>
