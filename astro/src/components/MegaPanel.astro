---
// Shared mega-menu panel: a featured product card + link rows + a shop strip.
// Used by the top bar (dropdown) and by the desktop side rail (flyout), so
// both menus are identical. The wrapper that positions/reveals the panel is
// owned by the caller; the row stagger keys off those wrappers' hover state.
export interface MegaRow { label: string; href: string; desc?: string; img?: string; group?: string }
export interface Props {
  feat?: MegaRow | null
  rows: MegaRow[]
  shopUrl: string
  /** Small tag above the featured card's title (default: מוצר הדגל). */
  featTag?: string
  /** Featured card call-to-action (default: לעמוד המוצר). */
  featCta?: string
  /** Show the shop strip at the bottom (default: true). */
  shop?: boolean
  /** Wider panel with the rows in two columns (for long lists, e.g. the info menu). */
  wide?: boolean
}
const { feat, rows, shopUrl, featTag = 'מוצר הדגל', featCta = 'לעמוד המוצר', shop = true, wide = false } = Astro.props
const GO = '<path d="m14 7-5 5 5 5"/>'
const LEAF = '<path d="M5 19c0-7 5-12 14-12 0 9-5 14-12 14M5 19c2-3.5 4.5-5.8 8-7.5"/>'
const CART = '<path d="M4 5h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H7"/><circle cx="10.4" cy="19.6" r="1.3"/><circle cx="17.2" cy="19.6" r="1.3"/>'
---
<div class:list={["ns-mega__panel", { "ns-mega__panel--wide": wide }]}>
  <span class="ns-mega__glow" aria-hidden="true"></span>
  {feat && (
    <a class="ns-mega__feat" href={feat.href}>
      {feat.img && <img src={feat.img} alt="" loading="lazy" />}
      <span class="ns-mega__feat-text">
        <small>{featTag}</small>
        <b>{feat.label}</b>
        {feat.desc && <em>{feat.desc}</em>}
        <span class="ns-mega__feat-cta">{featCta}
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={GO} />
        </span>
      </span>
    </a>
  )}
  <div class="ns-mega__list">
    {rows.map((l, i) => (
      <>
      {l.group && l.group !== rows[i - 1]?.group && <span class="ns-mega__grp" style={`--i:${i}`}>{l.group}</span>}
      <a class="ns-mega__row" href={l.href} style={`--i:${i}`}>
        <span class="ns-mega__fig">
          {l.img
            ? <img src={l.img} alt="" loading="lazy" width="48" height="48" />
            : <svg class="ns-mega__ic" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={LEAF} />}
        </span>
        <span class="ns-mega__rtext"><b>{l.label}</b>{l.desc && <em>{l.desc}</em>}</span>
        <span class="ns-mega__go" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={GO} />
        </span>
      </a>
      </>
    ))}
    <div class="ns-mega__foot">
      <span class="ns-mega__foot-note">ממקור אחד בטבע — מרווה מרושתת</span>
      {shop && <a class="ns-mega__shop" href={shopUrl} rel="noopener">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={CART} />
        לחנות המקוונת
      </a>}
    </div>
  </div>
</div>

<style>
  /* two-zone panel: featured product card + link rows, footer strip below */
  .ns-mega__panel { position: relative; display: grid; grid-template-columns: 264px 1fr; gap: 18px; width: min(720px, 94vw); padding: 18px; background: var(--ns-bg-alt); border: 1px solid var(--ns-border); border-radius: 22px; box-shadow: 0 30px 70px -28px rgba(17,48,33,.45), var(--ns-shadow-lg); overflow: hidden; }
  /* wide variant: rows flow into two columns; group headings span both */
  .ns-mega__panel--wide { width: min(960px, 94vw); grid-template-columns: 264px 1fr; }
  .ns-mega__panel--wide .ns-mega__list { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 8px; align-content: start; }
  .ns-mega__panel--wide .ns-mega__row { padding-block: 8px; }
  .ns-mega__panel--wide .ns-mega__foot { grid-column: 1 / -1; }
  .ns-mega__grp { grid-column: 1 / -1; font-size: 12px; font-weight: 700; letter-spacing: .05em; color: var(--ns-pure-orange); padding: 8px 12px 2px; }
  .ns-mega__grp:first-child { padding-top: 0; }
  .ns-mega__glow { position: absolute; inset-block-start: -40%; inset-inline-end: -20%; width: 60%; aspect-ratio: 1; pointer-events: none; background: radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--ns-immune-green) 30%, transparent), transparent 65%); }

  /* featured card — image-led, text anchored to the bottom over a gradient */
  .ns-mega__feat { position: relative; display: flex; align-items: flex-end; min-height: 340px; border-radius: 16px; overflow: hidden; background: linear-gradient(165deg, var(--ns-field-green), var(--ns-green-950, #0c2417)); isolation: isolate; }
  .ns-mega__feat img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; transform: scale(1.08); transition: transform .9s var(--ns-ease-smooth); }
  /* the featured photo eases from a slight zoom to rest as the panel lands, and zooms again on hover */
  :global(.ns-nav__item:hover) .ns-mega__feat img, :global(.ns-nav__item:focus-within) .ns-mega__feat img,
  :global(.ns-rail__item:hover) .ns-mega__feat img, :global(.ns-rail__item:focus-within) .ns-mega__feat img { transform: scale(1); }
  .ns-mega__feat:hover img { transform: scale(1.06) !important; }
  .ns-mega__feat::after { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(to top, rgba(17,48,33,.88) 0%, rgba(17,48,33,.35) 45%, transparent 70%); }
  .ns-mega__feat-text { position: relative; z-index: 2; padding: 16px; color: var(--ns-sun-beige); }
  .ns-mega__feat-text small { display: inline-block; font-size: 11px; font-weight: 600; letter-spacing: .06em; color: var(--ns-sun-beige); background: color-mix(in srgb, var(--ns-pure-orange) 82%, transparent); border-radius: 999px; padding: 3px 10px; margin-block-end: 8px; }
  .ns-mega__feat-text b { display: block; font-family: var(--ns-font-display); font-weight: 500; font-size: 20px; line-height: 1.25; }
  .ns-mega__feat-text em { display: block; font-style: normal; font-size: 12.5px; line-height: 1.5; opacity: .85; margin-block-start: 4px; }
  .ns-mega__feat-cta { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; color: var(--ns-sun-beige); margin-block-start: 10px; }
  .ns-mega__feat-cta svg { transition: transform .25s var(--ns-ease-out); }
  .ns-mega__feat:hover .ns-mega__feat-cta svg { transform: translateX(-4px); }

  /* link rows — staggered entrance (keyed off the caller's hover state), arrow slides in on hover */
  .ns-mega__list { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .ns-mega__row { display: flex; align-items: center; gap: 14px; padding: 11px 12px; border-radius: 16px; transition: background .2s var(--ns-ease-out); opacity: 0; transform: translateY(10px); }
  :global(.ns-nav__item:hover) .ns-mega__row, :global(.ns-nav__item:focus-within) .ns-mega__row,
  :global(.ns-rail__item:hover) .ns-mega__row, :global(.ns-rail__item:focus-within) .ns-mega__row { opacity: 1; transform: none; transition: background .2s var(--ns-ease-out), opacity .3s var(--ns-ease-smooth) calc(var(--i, 0) * 45ms + 80ms), transform .3s var(--ns-ease-smooth) calc(var(--i, 0) * 45ms + 80ms); }
  .ns-mega__row:hover, .ns-mega__row:focus-visible { background: color-mix(in srgb, var(--ns-pure-orange) 9%, var(--ns-sun-beige)); }
  /* round thumbnails: the photo is fully contained in the circle (ring + soft fill), never bleeding out */
  .ns-mega__fig { flex: none; width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; overflow: hidden; background: #fff; box-shadow: 0 0 0 1.5px color-mix(in srgb, var(--ns-field-green) 14%, transparent) inset; transition: transform .3s var(--ns-ease-out), box-shadow .3s var(--ns-ease-out); }
  /* the whole product sits inside the circle (contained with padding), never cropped by it */
  .ns-mega__fig img { width: 100%; height: 100%; object-fit: contain; padding: 6px; display: block; background: #fff; }
  .ns-mega__row:hover .ns-mega__fig { transform: scale(1.06); box-shadow: 0 0 0 2px color-mix(in srgb, var(--ns-pure-orange) 55%, transparent) inset; }
  .ns-mega__ic { color: var(--ns-pure-orange); }
  .ns-mega__rtext { flex: 1; min-width: 0; text-align: start; }
  .ns-mega__rtext b { display: block; font-family: var(--ns-font-display); font-weight: 500; font-size: 16.5px; color: var(--ns-field-green); line-height: 1.25; }
  .ns-mega__rtext em { display: block; font-style: normal; font-size: 13px; color: var(--ns-light-gray); margin-block-start: 3px; }
  .ns-mega__go { flex: none; width: 28px; height: 28px; border-radius: 999px; display: grid; place-items: center; background: var(--ns-sun-beige); color: var(--ns-field-green); opacity: 0; transform: translateX(6px); transition: opacity .22s var(--ns-ease-out), transform .22s var(--ns-ease-out), background .2s, color .2s; }
  .ns-mega__row:hover .ns-mega__go, .ns-mega__row:focus-visible .ns-mega__go { opacity: 1; transform: none; background: var(--ns-pure-orange); color: var(--ns-sun-beige); }

  /* footer strip */
  .ns-mega__foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-block-start: auto; padding: 12px 6px 2px; border-block-start: 1px solid var(--ns-border); }
  .ns-mega__foot-note { font-size: 12px; color: var(--ns-light-gray); }
  .ns-mega__shop { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; color: var(--ns-field-green); padding: 7px 12px; border-radius: 999px; border: 1px solid var(--ns-border); transition: color .2s var(--ns-ease-out), border-color .2s var(--ns-ease-out), background .2s var(--ns-ease-out); }
  .ns-mega__shop:hover { color: var(--ns-pure-orange); border-color: color-mix(in srgb, var(--ns-pure-orange) 45%, transparent); background: color-mix(in srgb, var(--ns-pure-orange) 7%, transparent); }

  @media (prefers-reduced-motion: reduce) { .ns-mega__row, .ns-mega__feat img, .ns-mega__go { transition: none !important; } }
</style>
