---
// BRIEF §15 — floating "דברו איתנו" AI chat (bottom left) + accessibility
// button (bottom right), ported from mockups/Floating.dc.html. The chat talks
// to POST /api/ask (streamed); answers link to product pages and, for purchase
// questions, to /stores or the online shops. Hebrew / English toggle.
import Accessibility from '@/components/Accessibility.astro'
import { t, chatDict, CHAT_LANGS } from '@/c5/i18n'
const strings = Object.fromEntries(CHAT_LANGS.map((l) => [l.code, chatDict(l.code)]))
// Product previews in answers: every /products/<slug> link the answer contains gets a
// card (photo + name + button to the product page).
import { getCatalog } from '@/c5/content/catalog'
const products = Object.fromEntries((await getCatalog()).map((p) => [p.slug, { t: p.fullTitle || p.title, i: p.image ?? '' }]))
const dirs = Object.fromEntries(CHAT_LANGS.map((l) => [l.code, l.dir]))
---
<div dir="rtl" data-c5-chat data-strings={JSON.stringify(strings)} data-dirs={JSON.stringify(dirs)} data-products={JSON.stringify(products)} style="font-family: 'C5 Sans', 'Noto Sans Hebrew', Arial, sans-serif; color: #141414; font-size: 15px; line-height: 1.5">

<Accessibility variant="c5" label={t('a11y.open')} />

<button type="button" data-chat-open class="c5-soft" aria-expanded="false" aria-controls="c5-chat" style="position: fixed; left: 20px; bottom: 20px; z-index: 80; min-height: 48px; padding: 0 22px; border-radius: 4px; border: 1px solid #141414; background: #ffffff; color: #141414; font: inherit; font-size: 16px; cursor: pointer">{t('chat.open')}</button>

<section id="c5-chat" role="dialog" aria-label={t('chat.title')} data-chat-panel hidden style="position: fixed; left: 16px; bottom: 16px; z-index: 90; width: min(380px, calc(100vw - 32px)); height: min(600px, calc(100vh - 32px)); background: #ffffff; border: 1px solid #141414; border-radius: 8px; display: flex; flex-direction: column; overflow: hidden">
<div style="padding: 14px 16px; display: flex; align-items: center; gap: 12px; border-bottom: 1px solid #dcdcd9">
<p data-chat-title style="margin: 0; flex: 1 1 auto; font-size: 17px">{t('chat.title')}</p>
<select data-chat-lang aria-label={t('chat.lang')} style="min-height: 36px; padding: 0 8px; border: 1px solid #141414; border-radius: 4px; background: #ffffff; color: #141414; font: inherit; font-size: 14px; cursor: pointer">
{CHAT_LANGS.map((l) => <option value={l.code} lang={l.code} selected={l.code === 'he'}>{l.name}</option>)}
</select>
<button type="button" data-chat-size aria-pressed="false" aria-label={t('chat.expand')} style="width: 40px; height: 40px; border: 0; background: transparent; color: #141414; display: flex; align-items: center; justify-content: center; cursor: pointer">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path data-size-icon d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7"></path></svg></button>
<button type="button" data-chat-close aria-label={t('chat.close')} style="width: 40px; height: 40px; border: 0; background: transparent; color: #141414; display: flex; align-items: center; justify-content: center; cursor: pointer">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
</div>
<div data-chat-log aria-live="polite" style="flex: 1 1 auto; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; background: #f7f7f5"></div>
<form data-chat-form style="border-top: 1px solid #dcdcd9; padding: 10px; display: flex; gap: 8px; align-items: center">
<label for="chat-input" data-chat-label style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0)">{t('chat.inputLabel')}</label>
<input id="chat-input" type="text" maxlength="800" autocomplete="off" placeholder={t('chat.placeholder')} style="flex: 1 1 auto; min-width: 0; min-height: 44px; border: 1px solid #141414; border-radius: 4px; padding: 0 12px; font: inherit">
<button type="submit" data-chat-send aria-label={t('chat.send')} style="width: 44px; height: 44px; border: 1px solid #141414; border-radius: 4px; background: #ffffff; color: #141414; display: flex; align-items: center; justify-content: center; cursor: pointer">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 12H5M11 6l-6 6 6 6"></path></svg></button>
</form>
</section>
</div>

<style is:global>
  [data-chat-panel][hidden], [data-chat-open][hidden] { display: none !important; }
  [data-chat-log] a { color: #141414; }
  [data-chat-log] a.c5-chat-card { display: flex; align-items: center; gap: 12px; padding: 10px; border: 1px solid #dcdcd9; border-radius: 4px; background: #ffffff; text-decoration: none; }
  [data-chat-log] a.c5-chat-card:hover, [data-chat-log] a.c5-chat-card:focus-visible { border-color: #141414; }
  .c5-chat-card-img { flex: 0 0 72px; width: 72px; height: 72px; background: #f7f7f5; display: flex; align-items: center; justify-content: center; }
  .c5-chat-card-img img { max-width: 100%; max-height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .c5-chat-card-txt { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
  .c5-chat-card-btn { display: inline-flex; align-items: center; min-height: 32px; padding: 0 12px; border: 1px solid #141414; border-radius: 4px; font-size: 14px; }
  a.c5-chat-card:hover .c5-chat-card-btn { background: #efeeea; }
  [data-chat-log] p { margin: 0 0 6px; } [data-chat-log] p:last-child { margin: 0; }
  [data-chat-log] ul { margin: 4px 0; padding-inline-start: 18px; }
  [data-chat-panel][data-large] { width: min(760px, calc(100vw - 32px)) !important; height: min(860px, calc(100vh - 32px)) !important; }
  @media (max-width: 640px) { [data-chat-size] { display: none !important; } }
  /* Phones: the chat is a full-screen sheet sized to the visible viewport (so the keyboard and the
     browser bars never cover the input), 16px text (iOS zooms the page on smaller inputs), and the
     page behind does not scroll while it is open. */
  @media (max-width: 640px) {
    [data-chat-panel] { left: 0 !important; right: 0; top: 0; bottom: auto !important; width: 100% !important; height: var(--c5-chat-h, 100dvh) !important; border: 0 !important; border-radius: 0 !important; font-size: 16px; }
    [data-chat-panel] > div:first-child { padding-top: calc(12px + env(safe-area-inset-top)) !important; }
    [data-chat-form] { padding: 10px 12px calc(10px + env(safe-area-inset-bottom)) !important; }
    [data-chat-form] input { font-size: 16px !important; min-height: 48px !important; }
    [data-chat-send] { width: 48px !important; height: 48px !important; flex: 0 0 48px; }
    [data-chat-log] { padding: 14px 12px !important; overscroll-behavior: contain; }
    [data-chat-log] > div { max-width: 92% !important; }
    [data-chat-langs] select, [data-chat-lang] { font-size: 16px !important; }
    html.c5-chat-open, html.c5-chat-open body { overflow: hidden; }
    /* Nothing of the page shows around the sheet (e.g. between the input and the keyboard). */
    html.c5-chat-open [data-c5-chat]::before { content: ''; position: fixed; inset: 0; z-index: 85; background: #ffffff; }
    [data-chat-open] { left: 12px !important; bottom: 12px !important; min-height: 44px !important; padding: 0 16px !important; font-size: 15px !important; }
  }
</style>

<script>
  type Lang = 'he' | 'en' | 'ar' | 'ru' | 'fr'
  type Turn = { role: 'user' | 'assistant'; content: string }
  const root = document.querySelector<HTMLElement>('[data-c5-chat]')
  if (root) {
    const S = JSON.parse(root.dataset.strings || '{}') as Record<Lang, Record<string, string>>
    const openBtn = root.querySelector<HTMLButtonElement>('[data-chat-open]')!
    const panel = root.querySelector<HTMLElement>('[data-chat-panel]')!
    const log = root.querySelector<HTMLElement>('[data-chat-log]')!
    const form = root.querySelector<HTMLFormElement>('[data-chat-form]')!
    const input = form.querySelector('input')!
    const sendBtn = root.querySelector<HTMLButtonElement>('[data-chat-send]')!
    const DIRS = JSON.parse(root.dataset.dirs || '{}') as Record<Lang, 'rtl' | 'ltr'>
    const langSel = root.querySelector<HTMLSelectElement>('[data-chat-lang]')!
    const sizeBtn = root.querySelector<HTMLButtonElement>('[data-chat-size]')!
    let lang: Lang = 'he'
    let busy = false
    const history: Turn[] = []

    // Phones: keep the sheet exactly as tall as the visible viewport (it shrinks when the keyboard opens).
    const touch = window.matchMedia('(hover: none) and (pointer: coarse)').matches
    // The current question stays at the top of the log, so the answer is read from its first line.
    let turn: HTMLElement | null = null
    const toTurn = () => { log.scrollTop = turn ? Math.max(0, turn.offsetTop - log.offsetTop - 12) : log.scrollHeight }
    const vv = window.visualViewport
    const fit = () => {
      if (!vv || panel.hidden) return
      panel.style.setProperty('--c5-chat-h', `${Math.round(vv.height)}px`)
      panel.style.setProperty('top', window.matchMedia('(max-width: 640px)').matches ? `${Math.round(vv.offsetTop)}px` : '')
      toTurn()
    }
    vv?.addEventListener('resize', fit)
    vv?.addEventListener('scroll', fit)
    const setOpen = (open: boolean) => {
      panel.hidden = !open
      document.documentElement.classList.toggle('c5-chat-open', open)
      fit()
      openBtn.hidden = open
      openBtn.setAttribute('aria-expanded', String(open))
      if (open) { if (!touch) input.focus() } else openBtn.focus()
    }
    openBtn.addEventListener('click', () => setOpen(true))
    root.querySelector('[data-chat-close]')!.addEventListener('click', () => setOpen(false))
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) setOpen(false) })

    const applyLang = (l: Lang) => {
      lang = l
      const s = S[l]
      const ltr = DIRS[l] === 'ltr'
      panel.setAttribute('dir', ltr ? 'ltr' : 'rtl')
      panel.setAttribute('lang', l)
      panel.setAttribute('aria-label', s['chat.title'])
      root.querySelector('[data-chat-title]')!.textContent = s['chat.title']
      root.querySelector('[data-chat-label]')!.textContent = s['chat.inputLabel']
      input.placeholder = s['chat.placeholder']
      sendBtn.setAttribute('aria-label', s['chat.send'])
      langSel.setAttribute('aria-label', s['chat.lang'])
      root.querySelector('[data-chat-close]')!.setAttribute('aria-label', s['chat.close'])
      sizeBtn.setAttribute('aria-label', s[panel.hasAttribute('data-large') ? 'chat.shrink' : 'chat.expand'])
      sendBtn.querySelector('svg')!.style.transform = ltr ? 'scaleX(-1)' : ''
    }
    langSel.addEventListener('change', () => applyLang(langSel.value as Lang))
    // Enlarge / reduce the window (desktop; on phones the chat is already full screen).
    sizeBtn.addEventListener('click', () => {
      const large = panel.toggleAttribute('data-large')
      sizeBtn.setAttribute('aria-pressed', String(large))
      sizeBtn.setAttribute('aria-label', S[lang][large ? 'chat.shrink' : 'chat.expand'])
      sizeBtn.querySelector('[data-size-icon]')!.setAttribute('d', large ? 'M20 10h-6V4M4 14h6v6M14 10l7-7M10 14l-7 7' : 'M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7')
      log.scrollTop = log.scrollHeight
    })

    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!)
    // Safe light markdown: escape, then links (site paths / https only), bold, bullets.
    const P = JSON.parse(root.dataset.products || '{}') as Record<string, { t: string; i: string }>
    // One preview card per product page linked in the answer.
    const cards = (src: string) => {
      const seen = new Set<string>()
      let html = ''
      for (const m of src.matchAll(/\]\(\/products\/([a-z0-9-]+)\/?\)/g)) {
        const p = P[m[1]]
        if (!p || seen.has(m[1])) continue
        seen.add(m[1])
        html += `<a class="c5-chat-card" href="/products/${m[1]}"><span class="c5-chat-card-img">${p.i ? `<img src="${esc(p.i)}" alt="" loading="lazy">` : ''}</span><span class="c5-chat-card-txt"><strong>${esc(p.t)}</strong><span class="c5-chat-card-btn">${esc(S[lang]['chat.toProduct'] || '')}</span></span></a>`
      }
      return html
    }
    const md = (src: string) => {
      let html = '', inList = false
      for (const raw of esc(src).split('\n')) {
        const l = raw
          .replace(/\[([^\]]+)\]\(((?:\/|https:\/\/)[^)\s]*)\)/g, (_m, txt, u) => `<a href="${u}"${u.startsWith('http') ? ' target="_blank" rel="noopener nofollow"' : ''}>${txt}</a>`)
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
          .replace(/^#{1,4}\s+/, '')
        const li = l.match(/^\s*(?:[-*•]|\d+\.)\s+(.*)$/)
        if (li) { if (!inList) { html += '<ul>'; inList = true } html += `<li>${li[1]}</li>`; continue }
        if (inList) { html += '</ul>'; inList = false }
        if (l.trim()) html += `<p>${l}</p>`
      }
      return inList ? html + '</ul>' : html
    }
    const bubble = (role: 'user' | 'assistant') => {
      const el = document.createElement('div')
      el.style.cssText = role === 'user'
        ? 'align-self: flex-end; max-width: 85%; background: #ffffff; border: 1px solid #141414; padding: 10px 14px; border-radius: 4px'
        : 'align-self: flex-start; max-width: 90%; background: #ffffff; border: 1px solid #dcdcd9; padding: 10px 14px; border-radius: 4px; display: flex; flex-direction: column; gap: 8px'
      log.appendChild(el)
      return el
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const q = input.value.trim()
      if (!q || busy) return
      busy = true; sendBtn.disabled = true; input.value = ''
      turn = bubble('user'); turn.textContent = q
      // Touch screens: close the keyboard so the answer is visible.
      if (touch) input.blur()
      const out = bubble('assistant')
      out.textContent = '…'
      toTurn()
      let text = ''
      const s = S[lang]
      try {
        const res = await fetch('/api/ask', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ question: q, history, lang }) })
        if (!res.ok || !res.body) {
          out.textContent = res.status === 429 ? s['chat.rateLimited'] : res.status === 503 ? s['chat.unavailable'] : s['chat.error']
          return
        }
        const reader = res.body.getReader(); const dec = new TextDecoder(); let buf = ''
        for (;;) {
          const { done, value } = await reader.read()
          if (done) break
          buf += dec.decode(value, { stream: true })
          let nl
          while ((nl = buf.indexOf('\n')) >= 0) {
            const line = buf.slice(0, nl); buf = buf.slice(nl + 1)
            if (!line.trim()) continue
            const ev = JSON.parse(line)
            if (ev.t === 'text') text += ev.v
            else if (ev.t === 'source') text += `\n- [${ev.title}](${ev.url})`
            else if (ev.t === 'error') text += (text ? '\n\n' : '') + s['chat.error']
            out.innerHTML = (md(text) || '…') + cards(text)
            toTurn()
          }
        }
        if (text) history.push({ role: 'user', content: q }, { role: 'assistant', content: text })
      } catch {
        out.textContent = s['chat.error']
      } finally {
        busy = false; sendBtn.disabled = false; if (!touch) input.focus()
      }
    })
  }
</script>
