---
// "מחקרים" accordion body on the product page. Data: src/c5/knowledge/research.ts.
// Written for the general public (client decision 14.11.2026): per ingredient, each study is
// one plain-language sentence ("בקצרה" in the research file) and a link to the paper.
// A study without a "בקצרה" line is not shown; no study tables, statistics or maintainers' notes.
import { productResearch, RESEARCH_DISCLAIMER, type Study } from '@/c5/knowledge/research'
interface Props { slug: string }
const items = productResearch(Astro.props.slug)
  .map((ing) => ({ ...ing, studies: ing.studies.filter((s) => s.summary) }))
  .filter((ing) => ing.studies.length > 0)
const groups = (studies: Study[]) => {
  const out: Array<{ heading?: string; studies: Study[] }> = []
  const main = studies.filter((s) => s.doubleBlind)
  if (main.length) out.push({ studies: main })
  for (const s of studies.filter((x) => !x.doubleBlind)) {
    const g = out.find((x) => x.heading === s.section)
    g ? g.studies.push(s) : out.push({ heading: s.section, studies: [s] })
  }
  return out
}
---
{items.length > 0 && (
<div class="c5-research">
<p class="c5-research-note">{RESEARCH_DISCLAIMER}</p>
{items.map((ing) => (
<section class="c5-research-ing">
<div class="c5-research-head">
<h3>{ing.name}</h3>
{ing.weight && <p class="c5-research-weight">רכיב {ing.weight}</p>}
</div>
{ing.inProduct && <p class="c5-research-inproduct">במוצר: {ing.inProduct}</p>}
{groups(ing.studies).map((g) => (
<Fragment>
{g.heading && <h4>{g.heading}</h4>}
<ol class="c5-research-studies">
{g.studies.map((s) => (
<li>
<p>{s.summary}</p>
{s.url
  ? <a class="c5-research-title" lang="en" dir="ltr" href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a>
  : <p class="c5-research-title" lang="en" dir="ltr">{s.title}</p>}
</li>
))}
</ol>
</Fragment>
))}
</section>
))}
</div>
)}
