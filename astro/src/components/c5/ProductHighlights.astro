---
// "תכונות המוצר" — client notes round 1 (14.11.2026): thin line icons beside each
// attribute, items in a row divided by hairlines (after the client's reference image).
// Data: src/c5/content/highlights.ts (only attributes stated in the product's sources).
// Kashrut: same look as the others; a click shows the kashrut type.
import { HIGHLIGHTS, HIGHLIGHT_LABELS, type HighlightKey } from '@/c5/content/highlights'
import { linkTerms } from '@/c5/glossaryLinks'
import { SERIES } from '@/c5/data'
interface Props { slug: string; series?: string }
const h = HIGHLIGHTS[Astro.props.slug]
// Icons in the product's series colour (client, product page round 3, 17.11.2026).
const hlColor = SERIES.find((x) => x.slug === Astro.props.series)?.color ?? '#8a8a88'
const used = new Set<string>()
type Item = { key: HighlightKey | 'kosher'; label: string; value?: string }
// Two rows (client notes round 2, 16.11.2026): row 1 — vegan, microscope, non-GMO;
// row 2 — kosher, no preservatives, then any other trait the product carries.
const all: Item[] = []
if (h) {
  for (const [key, label] of HIGHLIGHT_LABELS) if (h.is.includes(key)) all.push({ key, label })
  if (h.kosher) all.push({ key: 'kosher', label: 'כשרות', value: h.kosher })
}
const ROW1: Array<Item['key']> = ['vegan', 'microscope', 'nonGmo']
const ROW2: Array<Item['key']> = ['kosher', 'noPreservatives']
const pick = (keys: Array<Item['key']>) => keys.map((k) => all.find((x) => x.key === k)).filter((x): x is Item => !!x)
const rest = all.filter((x) => !ROW1.includes(x.key) && !ROW2.includes(x.key))
const rows = [pick(ROW1), [...pick(ROW2), ...rest]].filter((r) => r.length)
const items = all
// Line icons, 24px grid, thin 1px outline, in the series colour (client, product page round 3).
const ICON: Record<string, string> = {
  vegan: 'M20 4c-7 0-12 3-13 10 0 3 1 5 3 6 6 0 10-5 10-16Zm-13 16c2-5 5-8 9-11',
  glutenFree: 'M12 21v-9m0 0c-3 0-4-2-4-4 2 0 4 1 4 4Zm0 0c3 0 4-2 4-4-2 0-4 1-4 4Zm0-5c-3 0-4-2-4-4 2 0 4 1 4 4Zm0 0c3 0 4-2 4-4-2 0-4 1-4 4ZM12 7c-2 0-3-2-3-4 2 0 3 2 3 4Zm0 0c2 0 3-2 3-4-2 0-3 2-3 4ZM4 4l16 16',
  microscope: 'M13.5 2.5l3.2 1.6-5.5 9.2-3.2-1.6ZM15 7.5c4 2.5 5 8 2.5 13.5M5 15h9M4 21h16M11.5 13.3l-1.2 2.4M12 4.5l3.2 1.6',
  dairy: 'M9 3h6v3l2 3v11a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V9l2-3V3Zm-2 9h10',
  egg: 'M12 3c-4 0-7 6-7 11a7 7 0 0 0 14 0c0-5-3-11-7-11Z',
  nonGmo: 'M8 3c0 9 8 9 8 18M16 3c0 9-8 9-8 18M8.3 5h7.4M9.6 8h4.8M8.3 19h7.4M9.6 16h4.8M4 20L20 4',
  noPreservatives: 'M12 3s-6 6-6 11a6 6 0 0 0 12 0c0-5-6-11-6-11ZM5 5l14 14',
  sugarFree: 'M4 8l8-4 8 4v8l-8 4-8-4V8Zm0 0 8 4 8-4m-8 4v8M4 4l16 16',
  kosher: 'M12 3l2 1.8 2.6-.6.6 2.6L19.8 9 18.6 11.4 19.8 14l-2.6 1.2-.6 2.6-2.6-.6L12 19l-2-1.8-2.6.6-.6-2.6L4.2 14l1.2-2.6L4.2 9l2.6-1.2.6-2.6 2.6.6L12 3Zm-3 8 2 2 4-4',
}
const svg = (k: string) => `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${ICON[k]}"></path></svg>`
---
{items.length > 0 && (
<section aria-label="תכונות המוצר" class="pp-hl" style={`--hl-color: ${hlColor}`}>
<h2 class="pp-hl-title">תכונות המוצר</h2>
{rows.map((row) => (
<ul class="pp-hl-row">
{row.map((x) => x.value ? (
<li class="pp-hl-more">
<button type="button" data-hl-toggle aria-expanded="false">
<Fragment set:html={svg(x.key)} />
<span class="pp-hl-label">{x.label}</span>
</button>
<span class="pp-hl-value" data-hl-value hidden>{x.value}</span>
</li>
) : (
<li>
<Fragment set:html={svg(x.key)} />
<span class="pp-hl-label" set:html={linkTerms(x.label, used)} />
</li>
))}
</ul>
))}
</section>
)}

<style is:global>
  /* In the product's text column, after the "יש לכם שאלה?" banner: title right-aligned, two rows,
     thin grey line icons right of the text, thin vertical dividers inside a row, no box, no rules. */
  .pp-hl { display: flex; flex-direction: column; gap: 14px; }
  .pp-hl-title { margin: 0; text-align: start; }
  .pp-hl-row { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; row-gap: 12px; }
  .pp-hl-row li { display: flex; align-items: center; gap: 10px; padding: 2px clamp(12px, 1.4vw, 20px); font-size: 16px; line-height: 1.35; }
  .pp-hl-row li:first-child { padding-inline-start: 0; }
  .pp-hl-row li + li { border-inline-start: 1px solid #c9c9c6; }
  .pp-hl-row svg { flex: 0 0 22px; width: 22px; height: 22px; color: var(--hl-color, #8a8a88); }
  .pp-hl-label a { color: #141414; }
  .pp-hl-row li.pp-hl-more { flex-wrap: wrap; row-gap: 4px; }
  .pp-hl-more button { display: inline-flex; align-items: center; gap: 10px; padding: 0; border: 0; background: none; color: #141414; font: inherit; cursor: pointer; text-align: start; }
  .pp-hl-more button .pp-hl-label { text-decoration: underline dotted; text-underline-offset: 4px; }
  .pp-hl-more button:focus-visible { outline: 2px solid #141414; outline-offset: 3px; }
  .pp-hl-value { flex: 0 0 100%; padding-inline-start: 32px; font-size: 15px; }
  .pp-hl-value[hidden] { display: none; }
  @media (max-width: 480px) {
    .pp-hl-row { flex-direction: column; align-items: stretch; row-gap: 10px; }
    .pp-hl-row li { padding: 0; }
    .pp-hl-row li + li { border-inline-start: 0; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-hl-toggle]').forEach((btn) => {
    const value = btn.parentElement?.querySelector<HTMLElement>('[data-hl-value]')
    if (!value) return
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true'
      btn.setAttribute('aria-expanded', String(open))
      value.hidden = !open
    })
  })
</script>
