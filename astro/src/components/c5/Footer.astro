---
// BRIEF §4 — Footer, ported 1:1 from mockups/Footer.dc.html.
import { SERIES, NEEDS, CONTACT, FOOTER_LEGAL_NOTE, seriesHref, needHref } from '@/c5/data'
import { t } from '@/c5/i18n'
const sitemapLink = 'color: #141414; text-decoration: none; min-height: 32px'
---
<footer dir="rtl" style="background: #f7f7f5; border-top: 1px solid #dcdcd9; color: #141414; font-family: 'C5 Sans', 'Noto Sans Hebrew', Arial, sans-serif; font-size: 15px; line-height: 1.6">
<div style="max-width: 1280px; margin: 0 auto; padding: 48px clamp(16px, 4vw, 48px) 32px; box-sizing: border-box; display: flex; flex-direction: column; gap: 36px">

<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 32px">
<div style="display: flex; flex-direction: column; gap: 14px; flex: 1 1 260px">
<a href="/" aria-label={t('nav.home')} style="display: inline-flex; align-self: flex-start"><img src="/assets/logo/category5-logo.svg" alt="CATEGORY5 Ethical Supplements" style="height: 40px; width: auto; display: block"></a>
<div style="display: flex; align-items: center; gap: 4px">
<a href="/#contact" style="display: inline-flex; align-items: center; min-height: 44px; padding-inline-end: 12px; color: #141414">{t('nav.contact')}</a>
<a href={CONTACT.instagram} aria-label="Instagram" rel="noopener" target="_blank" style="display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: #141414">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r="0.8" fill="currentColor"></circle></svg></a>
<a href={CONTACT.facebook} aria-label="Facebook" rel="noopener" target="_blank" style="display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: #141414">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"></path></svg></a>
</div>
</div>

<form data-c5-form="newsletter" novalidate style="flex: 1 1 360px; max-width: 460px; display: flex; flex-direction: column; gap: 10px">
<label for="nl-email">{t('footer.keepInTouch')}</label>
<div style="display: flex; align-items: flex-end; gap: 12px">
<input id="nl-email" name="email" type="email" required autocomplete="email" placeholder={t('footer.email')} dir="ltr" style="flex: 1 1 auto; min-width: 0; min-height: 40px; border: 0; border-bottom: 1px solid #141414; border-radius: 0; padding: 8px 0; font: inherit; background: transparent; text-align: right">
<button type="submit" style="min-height: 44px; padding: 0 22px; border: 1px solid #141414; border-radius: 4px; background: #ffffff; color: #141414; font: inherit; cursor: pointer">{t('footer.signup')}</button>
</div>
<p data-c5-form-status role="status" aria-live="polite" style="margin: 0; font-size: 13px; min-height: 1em"></p>
</form>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 32px; border-top: 1px solid #dcdcd9; padding-top: 28px">
<nav aria-label={t('nav.series')} class="c5-sitemap" style="display: flex; flex-direction: column; gap: 4px">
<p style="margin: 0 0 6px">{t('nav.series')}</p>
{SERIES.map((s) => <a href={seriesHref(s)} style={sitemapLink}>{s.name}</a>)}
</nav>
<nav aria-label={t('nav.needs')} class="c5-sitemap" style="display: flex; flex-direction: column; gap: 4px">
<p style="margin: 0 0 6px">{t('nav.needs')}</p>
{NEEDS.map((n) => <a href={needHref(n)} style={sitemapLink}>{n.label}</a>)}
</nav>
<nav aria-label={t('footer.legal')} class="c5-sitemap" style="display: flex; flex-direction: column; gap: 4px">
<a href="/legal/terms" style={sitemapLink}>{t('footer.terms')}</a>
<a href="/legal/privacy" style={sitemapLink}>{t('footer.privacy')}</a>
</nav>
</div>

<div style="border-top: 1px solid #dcdcd9; padding-top: 16px; font-size: 13px">
<p style="margin: 0 0 6px">{t('footer.legalTitle')}</p>
<p style="margin: 0">{FOOTER_LEGAL_NOTE}</p>
</div>
</div>
</footer>
