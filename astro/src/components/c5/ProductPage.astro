---
// Product page. Layout modelled on The Ordinary's product page (client request,
// supersedes the BRIEF §8 mockup layout), in the Category 5 visual language:
//   breadcrumb → gallery (thumbs + large image) beside an info column (series tag,
//   name, short text, ask-the-AI box, pack-size pill, stores button, spec rows)
//   → accordion sections (benefits / usage / label) → more from the series → legal.
// Content: src/c5/content/catalog.ts (old-site data + overrides); unfilled fields
// show the mockup's placeholder texts.
import Site from '@/layouts/Site.astro'
import ProductLabel from '@/components/c5/ProductLabel.astro'
import ProductResearchList from '@/components/c5/ProductResearchList.astro'
import { productResearch } from '@/c5/knowledge/research'
import ProductHighlights from '@/components/c5/ProductHighlights.astro'
import ProductCard from '@/components/c5/ProductCard.astro'
import { SERIES, seriesHref } from '@/c5/data'
import { t } from '@/c5/i18n'
import { PRODUCT_PLACEHOLDERS as PH, productHref, type Product } from '@/c5/content/products'
import { productsOfSeries } from '@/c5/content/catalog'
import { imageFit } from '@/c5/content/imageFit'
import { linkTerms } from '@/c5/glossaryLinks'
const used = new Set<string>()
interface Props { product: Product }
const { product: p } = Astro.props
const s = SERIES.find((x) => x.slug === p.series) ?? SERIES[0]
const name = p.fullTitle || p.title
const intro = p.intro?.length ? p.intro : [PH.intro]
const usage = p.usage?.length ? p.usage : [PH.bullet]
const benefits = p.benefits?.length ? p.benefits : [PH.bullet]
// "label: value" lines become spec rows; the rest (warnings, notes) go under usage.
const all = p.details ?? []
const specs = all.map((d) => d.match(/^([^:]{2,30}):\s*(.+)$/)).filter(Boolean).map((m) => ({ label: m![1], value: m![2] }))
const notes = all.filter((d) => !/^[^:]{2,30}:\s*.+$/.test(d))
const pack = (p.contains || PH.contains).replace(/^מכיל\s+/, '')
// The product photo is framed uniformly (imageFit). The label is text (ProductLabel);
// a label scan is only shown while a product has no text label yet.
const gallery = [
  p.image && { src: p.image, alt: name, fit: await imageFit(p.image) },
  !p.label && p.labelImage && { src: p.labelImage, alt: `תווית המוצר – ${name}`, fit: undefined },
].filter(Boolean) as Array<{ src: string; alt: string; fit?: string }>
const related = (await productsOfSeries(p.series)).filter((x) => x.slug !== p.slug)
const btn = 'display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 22px; border: 1px solid #141414; color: #141414; text-decoration: none; border-radius: 4px; background: #ffffff; font: inherit; cursor: pointer'
---
<Site title={name} description={p.intro?.[0]} image={p.image}>

<section aria-label="מוצר" class="pp">
<nav aria-label="פירורי לחם" class="pp-crumbs">
<a href="/">Category 5</a><span aria-hidden="true">‹</span><a href={seriesHref(s)}>{s.name}</a><span aria-hidden="true">‹</span><span aria-current="page">{p.title}</span>
</nav>

<div class="pp-top">
<div class="pp-gallery">
{gallery.length > 1 && (
<div class="pp-thumbs" role="group" aria-label="תמונות המוצר">
{gallery.map((g, i) => (
<button type="button" class="pp-thumb" data-pp-thumb data-src={g.src} data-alt={g.alt} data-fit={g.fit ?? ''} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={g.alt}><img src={g.src} alt="" loading="lazy" style={g.fit}></button>
))}
</div>
)}
<div class="pp-stage" data-pp-stage role="button" tabindex="0" aria-label="הגדלת התמונה" aria-pressed="false">
{gallery.length
  ? <img data-pp-main src={gallery[0].src} alt={gallery[0].alt} style={gallery[0].fit} fetchpriority="high">
  : <span>{t('img')}</span>}
{gallery.length > 0 && <span class="pp-lens" data-pp-lens aria-hidden="true"></span>}
</div>
</div>

<div class="pp-info">
<a href={seriesHref(s)} class="pp-series">
<span style={`width: 28px; height: 28px; background: ${s.color}; display: flex; align-items: center; justify-content: center; flex-shrink: 0`}><img src={s.iconWhite} alt="" style="width: 22px; height: 22px"></span>
<span>{s.name}</span></a>
<h1 style="margin: 0">{name}</h1>
{intro.map((x) => <p style="margin: 0" set:html={linkTerms(x, used)} />)}

<div class="pp-ask">
<p style="margin: 0; font-weight: 600">יש לכם שאלה?</p>
<button type="button" data-pp-ask class="c5-soft" style={btn}>{t('chat.open')}</button>
</div>

<div class="pp-buy">
<span class="pp-pill">{pack}</span>
<a href="/stores" style={btn}>לחנויות</a>
</div>
<p style="margin: 0; font-size: 15px">מחפשים אותנו? מצאו את החנויות הקרובות אליכם.</p>

{specs.length > 0 && (
<dl class="pp-specs">
{specs.map((r) => <div><dt>{r.label}</dt><dd>{r.value}</dd></div>)}
</dl>
)}
</div>
</div>
</section>

<ProductHighlights slug={p.slug} />

<section aria-label="מידע על המוצר" class="pp pp-acc">
<details open>
<summary><h2 style="margin: 0">יתרונות המוצר ושימושים</h2><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></summary>
<div class="pp-acc-body"><ul class="pp-box">{benefits.map((x) => <li set:html={linkTerms(x, used)} />)}</ul></div>
</details>
<details>
<summary><h2 style="margin: 0">המלצות שימוש</h2><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></summary>
<div class="pp-acc-body">
<ul style="margin: 0; padding-inline-start: 20px">{usage.map((x) => <li>{x}</li>)}</ul>
{notes.length > 0 ? notes.map((x) => <p style="margin: 12px 0 0">{x}</p>) : !all.length && <p style="margin: 12px 0 0">{PH.details}</p>}
</div>
</details>
<details>
<summary><h2 style="margin: 0">תווית המוצר</h2><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></summary>
<div class="pp-acc-body">
{p.label
  ? <ProductLabel label={p.label} name={name} />
  : p.labelImage
  ? <img src={p.labelImage} alt={`תווית המוצר – ${name}`} loading="lazy" style="display: block; width: 100%; max-width: 640px; height: auto">
  : <div style="aspect-ratio: 4 / 3; max-width: 640px; background: #e9e9e7; display: flex; align-items: center; justify-content: center">{t('img')}</div>}
</div>
</details>
{productResearch(p.slug).some((i) => i.studies.some((x) => x.summary)) && (
<details>
<summary><h2 style="margin: 0">מחקרים</h2><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></summary>
<div class="pp-acc-body"><ProductResearchList slug={p.slug} /></div>
</details>
)}
{p.microscope?.length && (
<details>
<summary><h2 style="margin: 0">{p.microscopeTitle ?? 'צילום הליפוזום במיקרוסקופ אלקטרוני'}</h2><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></summary>
<figure class={`pp-acc-body pp-mic${p.microscopeTitle ? ' pp-mic-solo' : ''}`}>
<div class="pp-mic-imgs">
{p.microscope.map((src, i) => <img src={src} alt={`${p.microscopeTitle ?? 'צילום הליפוזום במוצר במיקרוסקופ אלקטרוני'} – ${name}${p.microscope!.length > 1 ? ` (${i + 1})` : ''}`} loading="lazy">)}
</div>
{!p.microscopeTitle && (
<figcaption class="pp-mic-cap">
<p class="pp-mic-lead">צילום במיקרוסקופ אלקטרוני של הליפוזומים שבמוצר בגודל חלקיקים ננומטרי.</p>
<p>בתמונה נראה פיזור טוב וליפוזומים שלמים שמהווים הוכחה להמצאותם במוצר.</p>
</figcaption>
)}
</figure>
</details>
)}
</section>

{related.length > 0 && (
<section aria-label={s.name} class="pp" style="padding-top: clamp(40px, 5vw, 72px)">
<h2 style="margin: 0 0 28px"><a href={seriesHref(s)} style="color: #141414; text-decoration: none">{s.name}</a></h2>
<div class="pp-car" data-pp-car>
<div class="pp-car-track" data-pp-track tabindex="0" role="group" aria-label={s.name}>
{related.map((r) => <div class="pp-car-item"><ProductCard title={r.title} image={r.image} href={productHref(r)} series={r.series} /></div>)}
</div>
<button type="button" class="pp-car-btn pp-car-prev" data-pp-prev aria-label="הקודם"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></button>
<button type="button" class="pp-car-btn pp-car-next" data-pp-next aria-label="הבא"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></button>
<div class="pp-car-bar" aria-hidden="true"><span data-pp-bar></span></div>
</div>
</section>
)}

<section aria-label="התוויה משפטית" class="pp" style="padding-top: clamp(40px, 5vw, 64px); padding-bottom: clamp(48px, 6vw, 88px)">
<p style="margin: 0; font-size: 15px">{p.legal || PH.legal}</p>
</section>

</Site>

<style is:global>
  .pp { max-width: 1280px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px); box-sizing: border-box; }
  .pp-crumbs { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding: 22px 0; border-bottom: 1px solid #dcdcd9; }
  .pp-crumbs a, .pp-crumbs span { font-size: 13px !important; color: #141414; text-decoration: none; }
  .pp-crumbs a:hover { text-decoration: underline; }
  .pp-top { display: grid; grid-template-columns: minmax(0, 1.9fr) minmax(300px, 1fr); gap: clamp(28px, 4vw, 64px); padding: clamp(24px, 3.5vw, 48px) 0 clamp(40px, 5vw, 72px); align-items: start; }
  .pp-gallery { display: flex; gap: 16px; align-items: flex-start; position: sticky; top: 96px; }
  .pp-thumbs { display: flex; flex-direction: column; gap: 10px; flex: 0 0 84px; }
  .pp-thumb { position: relative; overflow: hidden; padding: 0; border: 0; border-bottom: 3px solid transparent; background: #f7f7f5; aspect-ratio: 1 / 1; cursor: pointer; display: block; width: 100%; transition: border-color .4s cubic-bezier(.22,.61,.36,1); }
  .pp-thumb[aria-pressed="true"] { border-bottom-color: #141414; }
  .pp-thumb img { width: 100%; height: 100%; object-fit: contain; display: block; mix-blend-mode: multiply; }
  .pp-stage { position: relative; touch-action: none; flex: 1 1 auto; min-width: 0; aspect-ratio: 1 / 1; background: #f7f7f5; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .pp-stage img { width: 100%; height: 100%; object-fit: contain; display: block; mix-blend-mode: multiply; }
  .pp-stage[data-pp-stage] { cursor: zoom-in; }
  .pp-stage.is-zoom { cursor: none; }
  /* Magnifier: a round lens that follows the pointer and shows the same image enlarged. */
  .pp-lens { position: absolute; left: 0; top: 0; width: 220px; height: 220px; border-radius: 50%; border: 1px solid #141414; background-color: #f7f7f5; background-repeat: no-repeat; background-blend-mode: multiply; box-shadow: 0 10px 30px rgba(20,20,20,.12); pointer-events: none; opacity: 0; transform: scale(.9); transition: opacity .3s cubic-bezier(.22,.61,.36,1), transform .3s cubic-bezier(.22,.61,.36,1); z-index: 3; will-change: left, top, background-position; }
  .pp-stage.is-zoom .pp-lens { opacity: 1; transform: none; }
  @media (max-width: 900px) { .pp-lens { width: 160px; height: 160px; } }
  .pp-info { display: flex; flex-direction: column; gap: 16px; }
  .pp-series { display: inline-flex; align-items: center; gap: 10px; align-self: flex-start; color: #141414; text-decoration: none; }
  .pp-series span { font-size: 15px !important; }
  .pp-ask { background: #f7f7f5; padding: 18px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; margin-top: 4px; }
  .pp-buy { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding-top: 18px; border-top: 1px solid #dcdcd9; }
  .pp-buy a { flex: 1 1 160px; }
  .pp-pill { display: inline-flex; align-items: center; min-height: 32px; padding: 0 14px; border-radius: 999px; background: #141414; color: #ffffff !important; font-size: 15px !important; }
  .pp-specs { margin: 8px 0 0; border-top: 1px solid #dcdcd9; }
  .pp-specs div { display: flex; gap: 10px; padding: 12px 0; border-bottom: 1px solid #dcdcd9; font-size: 15px; }
  .pp-specs dt { font-weight: 600; flex: 0 0 auto; }
  .pp-specs dd { margin: 0; }
  .pp-acc details { border-top: 1px solid #dcdcd9; }
  .pp-acc details:last-child { border-bottom: 1px solid #dcdcd9; }
  .pp-acc summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: clamp(22px, 3vw, 36px) 0; cursor: pointer; }
  .pp-acc summary::-webkit-details-marker { display: none; }
  .pp-acc summary svg { transition: transform .5s cubic-bezier(.22,.61,.36,1); flex-shrink: 0; }
  .pp-acc details[open] summary svg { transform: rotate(180deg); }
  .pp-acc-body { padding: 0 0 clamp(28px, 3.5vw, 44px); padding-inline-start: min(200px, 16vw); max-width: 1000px; }
  .pp-box { margin: 0; padding: 22px 22px 22px 22px; padding-inline-start: 42px; background: #f7f7f5; }
  /* Microscope section: photo(s) framed on the right, caption panel beside them. */
  .pp-mic { margin: 0; display: flex; align-items: stretch; gap: 0; border: 1px solid #dcdcd9; max-width: none; }
  .pp-acc-body.pp-mic { padding: 0; margin-bottom: clamp(28px, 3.5vw, 44px); max-width: 1000px; }
  .pp-mic-imgs { flex: 0 1 auto; display: flex; flex-wrap: wrap; gap: 8px; padding: 16px; background: #141414; align-items: center; justify-content: center; }
  /* Same height for every microscope photo (never upscaled, never cropped). */
  .pp-mic img { display: block; width: auto; height: auto; max-width: 100%; max-height: 280px; flex: 0 1 auto; }
  .pp-acc-body.pp-mic.pp-mic-solo { width: fit-content; }
  .pp-mic-cap { flex: 1 1 260px; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 12px; padding: clamp(20px, 3vw, 36px); background: #f7f7f5; }
  .pp-mic-cap p { margin: 0; }
  .pp-mic-lead { font-size: 20px; font-weight: 600; line-height: 1.4; }
  @media (max-width: 760px) { .pp-mic { flex-direction: column; } .pp-mic img { max-height: 220px; } .pp-mic-cap { flex-basis: auto; } }
  .pp-box li + li { margin-top: 6px; }
  /* "More from the series" carousel (after The Ordinary): 4 cards in view, round
     arrow buttons, a hairline with a black progress segment underneath. */
  .pp-car { position: relative; }
  .pp-car-track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 3 * 24px) / 4); gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 2px; }
  .pp-car-track::-webkit-scrollbar { display: none; }
  .pp-car-item { scroll-snap-align: start; min-width: 0; }
  .pp-car-btn { position: absolute; top: calc(50% - 60px); width: 40px; height: 40px; border-radius: 50%; border: 1px solid #dcdcd9; background: #ffffff; color: #141414; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 4px 14px rgba(20,20,20,.08); transition: background-color .45s cubic-bezier(.22,.61,.36,1), color .45s cubic-bezier(.22,.61,.36,1), opacity .4s; z-index: 2; }
  .pp-car-btn:hover { background: #141414; color: #ffffff; }
  .pp-car-btn[disabled] { opacity: 0; pointer-events: none; }
  .pp-car-prev { right: -12px; }
  .pp-car-next { left: -12px; }
  .pp-car-bar { position: relative; height: 1px; background: #dcdcd9; margin-top: 28px; }
  .pp-car-bar span { position: absolute; top: -1px; right: 0; height: 3px; width: 25%; background: #141414; transition: right .5s cubic-bezier(.22,.61,.36,1), width .5s cubic-bezier(.22,.61,.36,1); }
  @media (max-width: 1100px) { .pp-car-track { grid-auto-columns: calc((100% - 2 * 24px) / 3); } }
  @media (max-width: 760px) { .pp-car-track { grid-auto-columns: 62%; gap: 16px; } .pp-car-btn { display: none; } }
  @media (max-width: 900px) {
    .pp-top { grid-template-columns: minmax(0, 1fr); }
    /* Stacked: the stage must take the full width (its image is absolutely positioned,
       so without a width the box collapses to 0). */
    .pp-gallery { position: static; flex-direction: column-reverse; align-items: stretch; }
    .pp-stage { flex: 0 0 auto; width: 100%; }
    .pp-thumbs { flex-direction: row; flex: 0 0 auto; }
    .pp-thumb { width: 72px; }
    .pp-acc-body { padding-inline-start: 0; }
  }
</style>

<script>
  // Gallery: thumbnail swaps the large image. "Ask" opens the site chat.
  const main = document.querySelector<HTMLImageElement>('[data-pp-main]')
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('[data-pp-thumb]')]
  thumbs.forEach((b) => b.addEventListener('click', () => {
    if (!main) return
    main.src = b.dataset.src!; main.alt = b.dataset.alt || ''; main.style.cssText = b.dataset.fit || ''
    thumbs.forEach((x) => x.setAttribute('aria-pressed', String(x === b)))
  }))
  // Magnifier: click (or tap / Enter) on the product image turns the lens on at
  // that point; it follows the pointer; click again, Esc or leaving turns it off.
  const stage = document.querySelector<HTMLElement>('[data-pp-stage]')
  const lens = document.querySelector<HTMLElement>('[data-pp-lens]')
  if (stage && lens && main) {
    const ZOOM = 2.5
    let on = false
    const place = (cx: number, cy: number) => {
      const s = stage.getBoundingClientRect(), r = main.getBoundingClientRect()
      const half = lens.offsetWidth / 2
      const x = Math.max(s.left, Math.min(cx, s.right)), y = Math.max(s.top, Math.min(cy, s.bottom))
      lens.style.left = `${x - s.left - half}px`
      lens.style.top = `${y - s.top - half}px`
      lens.style.backgroundImage = `url("${main.currentSrc || main.src}")`
      lens.style.backgroundSize = `${r.width * ZOOM}px ${r.height * ZOOM}px`
      lens.style.backgroundPosition = `${-((x - r.left) * ZOOM - half)}px ${-((y - r.top) * ZOOM - half)}px`
    }
    const set = (v: boolean, cx?: number, cy?: number) => {
      on = v
      stage.classList.toggle('is-zoom', v)
      stage.setAttribute('aria-pressed', String(v))
      if (v) { const s = stage.getBoundingClientRect(); place(cx ?? s.left + s.width / 2, cy ?? s.top + s.height / 2) }
    }
    stage.addEventListener('click', (e) => set(!on, e.clientX, e.clientY))
    stage.addEventListener('pointermove', (e) => { if (on) place(e.clientX, e.clientY) })
    stage.addEventListener('pointerleave', (e) => { if (on && e.pointerType === 'mouse') set(false) })
    stage.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); set(!on) } })
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && on) set(false) })
    thumbs.forEach((b) => b.addEventListener('click', () => set(false)))
  }
  // Series carousel: arrows page through, the bar shows the position, and it
  // advances by itself every 5s (paused on hover / focus / reduced motion).
  const car = document.querySelector<HTMLElement>('[data-pp-car]')
  if (car) {
    const track = car.querySelector<HTMLElement>('[data-pp-track]')!
    const bar = car.querySelector<HTMLElement>('[data-pp-bar]')!
    const prev = car.querySelector<HTMLButtonElement>('[data-pp-prev]')!
    const next = car.querySelector<HTMLButtonElement>('[data-pp-next]')!
    const max = () => track.scrollWidth - track.clientWidth
    const pos = () => Math.abs(track.scrollLeft) // RTL: scrollLeft runs 0 → -max
    const step = () => { const it = track.querySelector<HTMLElement>('.pp-car-item'); return it ? it.offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0') : track.clientWidth }
    const go = (dir: 1 | -1) => track.scrollBy({ left: -dir * step(), behavior: 'smooth' })
    const update = () => {
      const m = max(), share = m > 0 ? track.clientWidth / track.scrollWidth : 1
      bar.style.width = `${share * 100}%`
      bar.style.right = `${m > 0 ? (pos() / m) * (1 - share) * 100 : 0}%`
      prev.disabled = pos() < 4
      next.disabled = pos() > m - 4
      car.classList.toggle('is-static', m <= 0)
    }
    prev.addEventListener('click', () => go(-1))
    next.addEventListener('click', () => go(1))
    track.addEventListener('scroll', update, { passive: true })
    window.addEventListener('resize', update)
    update()
    let paused = false
    for (const ev of ['pointerenter', 'focusin', 'touchstart']) car.addEventListener(ev, () => { paused = true }, { passive: true })
    for (const ev of ['pointerleave', 'focusout']) car.addEventListener(ev, () => { paused = false })
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => {
        if (paused || max() <= 0 || document.hidden) return
        const r = car.getBoundingClientRect()
        if (r.bottom < 0 || r.top > window.innerHeight) return
        if (pos() > max() - 4) track.scrollTo({ left: 0, behavior: 'smooth' }); else go(1)
      }, 5000)
    }
  }
  document.querySelector('[data-pp-ask]')?.addEventListener('click', () => document.querySelector<HTMLButtonElement>('[data-chat-open]')?.click())
</script>
