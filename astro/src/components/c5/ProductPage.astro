---
// BRIEF §8 — product page, ported 1:1 from mockups/Product.dc.html (only these floors).
// Content: src/c5/content/products.ts; unfilled fields show the mockup's placeholder text.
import Site from '@/layouts/Site.astro'
import { SERIES, seriesHref } from '@/c5/data'
import { t } from '@/c5/i18n'
import { PRODUCT_PLACEHOLDERS as PH, type Product } from '@/c5/content/products'
interface Props { product: Product }
const { product: p } = Astro.props
const s = SERIES.find((x) => x.slug === p.series) ?? SERIES[0]
const name = p.fullTitle || p.title
const intro = p.intro?.length ? p.intro : [PH.intro]
const usage = p.usage?.length ? p.usage : [PH.bullet]
const benefits = p.benefits?.length ? p.benefits : [PH.bullet]
const details = p.details?.length ? p.details : [PH.details]
const wrap = 'max-width: 1280px; margin: 0 auto; box-sizing: border-box'
---
<Site title={name} description={p.intro?.[0]} image={p.image}>

<section aria-label="באנר מוצר" style="background: #f7f7f5">
<div style={`${wrap}; padding: clamp(24px, 4vw, 56px) clamp(16px, 4vw, 48px); display: flex; flex-wrap: wrap; align-items: center; gap: clamp(24px, 4vw, 64px)`}>
<div style="flex: 1 1 380px; display: flex; flex-direction: column; gap: 16px">
<h1 style="margin: 0">{name}</h1>
<a href={seriesHref(s)} style="display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: #141414; align-self: flex-start">
<span style={`width: 44px; height: 44px; background: ${s.color}; display: flex; align-items: center; justify-content: center`}>
<img src={s.iconWhite} alt="" style="width: 32px; height: 32px">
</span>
<span>{s.name}</span></a>
</div>
<div style="flex: 1 1 380px; display: flex; justify-content: center">
{p.image
  ? <img src={p.image} alt={name} fetchpriority="high" style="display: block; width: 100%; max-width: 600px; height: auto">
  : <div style="width: 100%; max-width: 600px; aspect-ratio: 1 / 1; background: #e9e9e7; display: flex; align-items: center; justify-content: center">{t('img')}</div>}
</div>
</div>
</section>

<section aria-label="על המוצר" style={`${wrap}; padding: clamp(40px, 5vw, 72px) clamp(16px, 4vw, 48px) 0`}>
{intro.map((x, i) => <p style={`margin: ${i ? '16px' : '0'} 0 0; max-width: 820px`}>{x}</p>)}
</section>

<section aria-label="מידע מרכזי" style={`${wrap}; padding: clamp(40px, 5vw, 64px) clamp(16px, 4vw, 48px)`}>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 32px; border-top: 1px solid #141414; padding-top: 28px">
<div style="display: flex; flex-direction: column; gap: 8px">
<h3 style="margin: 0">{p.contains || PH.contains}</h3>
</div>
<div style="display: flex; flex-direction: column; gap: 8px">
<h3 style="margin: 0">המלצות שימוש</h3>
<ul style="margin: 0; padding-inline-start: 20px">{usage.map((x) => <li>{x}</li>)}</ul>
</div>
<div style="display: flex; flex-direction: column; gap: 8px">
<h3 style="margin: 0">יתרונות המוצר ושימושים</h3>
<ul style="margin: 0; padding-inline-start: 20px">{benefits.map((x) => <li>{x}</li>)}</ul>
</div>
</div>
</section>

<section aria-label={t('nav.stores')} style="background: #f7f7f5">
<div style={`${wrap}; padding: 40px clamp(16px, 4vw, 48px)`}>
<p style="margin: 0"><a href="/stores" style="color: #141414">מחפשים אותנו? מצאו את החנויות הקרובות אליכם.</a></p>
</div>
</section>

<section style={`${wrap}; padding: clamp(40px, 5vw, 72px) clamp(16px, 4vw, 48px); display: flex; flex-wrap: wrap; gap: clamp(32px, 4vw, 64px); align-items: flex-start`}>
<div style="flex: 1 1 360px; display: flex; flex-direction: column; gap: 14px">
<h3 style="margin: 0">תווית המוצר</h3>
{p.labelImage
  ? <img src={p.labelImage} alt={`תווית המוצר – ${name}`} loading="lazy" style="display: block; width: 100%; height: auto">
  : <div style="aspect-ratio: 4 / 3; background: #e9e9e7; display: flex; align-items: center; justify-content: center">{t('img')}</div>}
</div>
<div style="flex: 1 1 420px; display: flex; flex-direction: column; gap: 14px">
<h3 style="margin: 0">פרטים נוספים</h3>
{details.map((x) => <p style="margin: 0">{x}</p>)}
</div>
</section>

<section aria-label="התוויה משפטית" style={`${wrap}; padding: 0 clamp(16px, 4vw, 48px) clamp(48px, 6vw, 88px)`}>
<p style="margin: 0; font-size: 15px">{p.legal || PH.legal}</p>
</section>

</Site>
