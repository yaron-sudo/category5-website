---
// ProductCard — ported 1:1 from mockups/ProductCard.dc.html (BRIEF §6).
// Without `href` (placeholder card: no product yet) it renders as a plain block, not a link.
import { SERIES } from '@/c5/data'
import { t } from '@/c5/i18n'
interface Props { title: string; image?: string; href?: string; series: string }
const { title, image, href, series } = Astro.props
const s = SERIES.find((x) => x.slug === series) ?? SERIES[0]
const Tag = href ? 'a' : 'div'
---
<Tag href={href} dir="rtl" style="display: flex; flex-direction: column; height: 100%; text-decoration: none; color: #141414; font-family: 'C5 Sans', 'Noto Sans Hebrew', Arial, sans-serif; background: #ffffff; border: 1px solid #dcdcd9; box-sizing: border-box">
<div style="aspect-ratio: 1 / 1; background: #f7f7f5; display: flex; align-items: center; justify-content: center; overflow: hidden">
{image ? <img src={image} alt={title} loading="lazy" class="c5-cutout" style="width: 100%; height: 100%; object-fit: contain"> : <span>{t('img')}</span>}
</div>
<div style="padding: 16px; display: flex; flex-direction: column; gap: 8px">
<span style="display: inline-flex; align-items: center; gap: 8px; font-size: 15px"><span style={`width: 14px; height: 14px; background: ${s.color}; display: inline-block`}></span>{s.name}</span>
<span style="font-size: 20px; line-height: 1.3">{title}</span>
</div>
</Tag>
