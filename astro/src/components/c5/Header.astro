---
// BRIEF §3 — Header, ported from mockups/Header.dc.html (markup + inline styles
// kept 1:1 so mockups/site.css applies unchanged). The mockup's component state
// (scrolled / compact strip / hover / open menus / mobile panel) is implemented
// by the script below; wide vs narrow (<1000px) is a CSS media query.
import { SERIES, NEEDS, FEATURED_NEEDS, seriesHref, needHref } from '@/c5/data'
import { t } from '@/c5/i18n'
const featured = FEATURED_NEEDS.map((slug) => NEEDS.find((n) => n.slug === slug)!).filter(Boolean)
const navLink = 'display: inline-flex; align-items: center; min-height: 44px; padding: 0 10px; color: #141414; text-decoration: none'
const navBtn = 'display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 10px; border: 0; background: transparent; font: inherit; color: #141414; cursor: pointer'
const mobileRow = 'display: flex; align-items: center; min-height: 52px; border-bottom: 1px solid #dcdcd9; color: #141414; text-decoration: none'
---
<div style="position: sticky; top: 0; z-index: 50">
<header dir="rtl" class="c5-header" data-c5-header style="position: relative; font-family: 'C5 Sans', 'Noto Sans Hebrew', Arial, sans-serif; color: #141414; font-size: 15px; background: #ffffff; border-bottom: 1px solid #dcdcd9; box-shadow: none; transition: box-shadow .5s ease">
<div data-c5-bar style="max-width: 1440px; margin: 0 auto; padding: 0 clamp(16px, 3vw, 40px); height: 80px; display: flex; align-items: center; gap: clamp(16px, 3vw, 48px); box-sizing: border-box; transition: height .7s cubic-bezier(.22,.61,.36,1)">

<a href="/" aria-label={t('nav.home')} class="c5-logo" style="display: flex; align-items: center; flex-shrink: 0">
<img data-c5-logo src="/assets/logo/category5-logo.svg" alt="CATEGORY5 Ethical Supplements" style="height: 40px; width: auto; display: block; transition: height .7s cubic-bezier(.22,.61,.36,1)">
</a>

<nav aria-label={t('nav.main')} class="c5-wide" style="display: flex; align-items: center; gap: 4px">
<a href="/#about" data-c5-close class="c5-nav" style={navLink}>{t('nav.about')}</a>
<button type="button" data-c5-toggle="series" aria-expanded="false" aria-controls="c5-mega-series" class="c5-nav" style={navBtn}>{t('nav.series')}
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></button>
<button type="button" data-c5-toggle="needs" aria-expanded="false" aria-controls="c5-mega-needs" class="c5-nav" style={navBtn}>{t('nav.needs')}
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></button>
<a href="/stores" data-c5-close class="c5-nav" style={navLink}>{t('nav.stores')}</a>
<a href="/glossary" data-c5-close class="c5-nav" style={navLink}>{t('nav.glossary')}</a>
<a href="/articles" data-c5-close class="c5-nav" style={navLink}>{t('nav.articles')}</a>
<a href="/contact" data-c5-close class="c5-nav" style={navLink}>{t('nav.contact')}</a>
</nav>

<div style="margin-inline-start: auto; display: flex; align-items: center; gap: 4px">
<a href="/contact" aria-label={t('nav.contact')} style="display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: #141414">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"></rect><path d="M3 7l9 6 9-6"></path></svg></a>
<a href="/search" aria-label={t('nav.search')} style="display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: #141414">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="M20 20l-4.2-4.2"></path></svg></a>
<button type="button" class="c5-narrow" data-c5-toggle="mobile" aria-expanded="false" aria-controls="c5-mobile" aria-label={t('nav.menu')} style="display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 0; background: transparent; color: #141414; cursor: pointer">
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></button>
</div>
</div>

<div id="c5-mega-series" data-c5-panel="series" class="c5-drop c5-panel c5-wide" hidden style="position: absolute; top: 100%; left: 0; right: 0; background: #ffffff; border-bottom: 1px solid #dcdcd9; box-shadow: 0 24px 40px rgba(0,0,0,0.06); z-index: 60">
<div style="max-width: 1280px; margin: 0 auto; padding: 28px clamp(16px, 4vw, 48px) 32px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; box-sizing: border-box">
{SERIES.map((s) => (
<a href={seriesHref(s)} data-c5-close class="c5-tile" style="display: flex; align-items: center; gap: 14px; padding: 12px; color: #141414; text-decoration: none; border-radius: 4px">
<span style={`width: 56px; height: 56px; flex-shrink: 0; background: ${s.color}; display: flex; align-items: center; justify-content: center`}><img src={s.iconWhite} alt="" style="width: 44px; height: 44px"></span>
<span>{s.name}</span></a>
))}
</div>
</div>

<div id="c5-mega-needs" data-c5-panel="needs" class="c5-drop c5-panel c5-wide" hidden style="position: absolute; top: 100%; left: 0; right: 0; background: #ffffff; border-bottom: 1px solid #dcdcd9; box-shadow: 0 24px 40px rgba(0,0,0,0.06); z-index: 60">
<div style="max-width: 1280px; margin: 0 auto; padding: 36px clamp(16px, 4vw, 48px) 44px; display: flex; flex-wrap: wrap; gap: clamp(32px, 5vw, 96px); box-sizing: border-box">
<div style="flex: 0 1 280px; display: flex; flex-direction: column">
<p style="margin: 0 0 14px; font-size: 13px; letter-spacing: .04em; border-bottom: 1px solid #dcdcd9; padding-bottom: 10px">{t('nav.needs')}</p>
{NEEDS.map((n) => (
<a href={needHref(n)} data-c5-close class="c5-mega-link" style="display: flex; align-items: center; justify-content: space-between; min-height: 40px; color: #141414; text-decoration: none; font-size: 15px">{n.label}
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></a>
))}
<a href="/search?filter=needs" data-c5-close class="c5-mega-link" style="display: flex; align-items: center; min-height: 40px; margin-top: 10px; color: #141414; text-decoration: none; font-size: 15px; text-decoration: underline; text-underline-offset: 5px">{t('nav.allNeeds')}</a>
</div>
<div style="flex: 1 1 420px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px">
{featured.map((n) => (
<a href={needHref(n)} data-c5-close class="c5-mega-card" style="display: flex; flex-direction: column; gap: 10px; color: #141414; text-decoration: none">
<span style="aspect-ratio: 16 / 10; background: #e9e9e7; display: flex; align-items: center; justify-content: center; overflow: hidden">{t('img')}</span>
<span style="font-size: 15px">{n.label}</span>
</a>
))}
</div>
</div>
</div>

<div id="c5-mobile" data-c5-panel="mobile" class="c5-drop c5-panel c5-mobile-panel" hidden style="position: absolute; top: 100%; left: 0; right: 0; background: #ffffff; border-bottom: 1px solid #dcdcd9; z-index: 60; box-shadow: 0 24px 40px rgba(0,0,0,0.08); padding: 8px 16px 24px; display: flex; flex-direction: column; max-height: calc(100vh - 80px); overflow-y: auto">
<a href="/#about" data-c5-close style={mobileRow}>{t('nav.about')}</a>
<p style="margin: 16px 0 8px; font-size: 14px">{t('nav.series')}</p>
<div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px">
{SERIES.map((s) => (
<a href={seriesHref(s)} data-c5-close class="c5-tile" style="display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 10px; color: #141414; border-radius: 4px; text-decoration: none; font-size: 14px"><span style={`width: 28px; height: 28px; flex-shrink: 0; background: ${s.color}; display: flex; align-items: center; justify-content: center`}><img src={s.iconWhite} alt="" style="width: 22px; height: 22px"></span>{s.name}</a>
))}
</div>
<p style="margin: 20px 0 8px; font-size: 14px">{t('nav.needs')}</p>
<div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px">
{NEEDS.map((n) => (
<a href={needHref(n)} data-c5-close class="c5-tile" style="display: flex; align-items: center; min-height: 48px; padding: 0 10px; color: #141414; border-radius: 4px; text-decoration: none; font-size: 14px">{n.label}</a>
))}
</div>
<div style="display: flex; flex-direction: column; margin-top: 16px">
<a href="/stores" data-c5-close style={mobileRow}>{t('nav.stores')}</a>
<a href="/glossary" data-c5-close style={mobileRow}>{t('nav.glossary')}</a>
<a href="/articles" data-c5-close style={mobileRow}>{t('nav.articles')}</a>
<a href="/contact" data-c5-close style="display: flex; align-items: center; min-height: 52px; color: #141414; text-decoration: none">{t('nav.contact')}</a>
</div>
</div>
</header>
</div>

<script>
  // Port of the mockup component's state machine (mockups/Header.dc.html).
  const header = document.querySelector<HTMLElement>('[data-c5-header]')
  if (header) {
    const bar = header.querySelector<HTMLElement>('[data-c5-bar]')!
    const logo = header.querySelector<HTMLImageElement>('[data-c5-logo]')!
    const toggles = [...header.querySelectorAll<HTMLButtonElement>('[data-c5-toggle]')]
    const panels = [...header.querySelectorAll<HTMLElement>('[data-c5-panel]')]
    const narrowMq = window.matchMedia('(max-width: 999.98px)')
    const state = { open: null as null | 'series' | 'needs' | 'mobile', y: 0, hidden: false, hover: false }
    let lastY = 0

    const render = () => {
      const narrow = narrowMq.matches
      if (narrow && (state.open === 'series' || state.open === 'needs')) state.open = null
      if (!narrow && state.open === 'mobile') state.open = null
      const scrolled = state.y > 40
      // Client 14.11.2026: the header no longer shrinks or hides on scroll — every height
      // change shifted the whole page under the reader ("the site trembles"). Constant
      // height; only the shadow marks the scrolled state.
      bar.style.height = '80px'
      logo.style.height = '40px'
      header.style.boxShadow = scrolled ? '0 8px 24px rgba(0,0,0,0.06)' : 'none'
      for (const p of panels) p.hidden = p.dataset.c5Panel !== state.open
      for (const tg of toggles) tg.setAttribute('aria-expanded', String(tg.dataset.c5Toggle === state.open))
    }
    const set = (patch: Partial<typeof state>) => { Object.assign(state, patch); render() }
    const closeAll = () => set({ open: null })

    toggles.forEach((tg) => tg.addEventListener('click', () => {
      const k = tg.dataset.c5Toggle as typeof state.open
      set({ open: state.open === k ? null : k })
    }))
    header.querySelectorAll('[data-c5-close]').forEach((a) => a.addEventListener('click', closeAll))
    header.addEventListener('mouseenter', () => set({ hover: true }))
    header.addEventListener('mouseleave', () => set({ hover: false }))
    document.addEventListener('click', (e) => {
      if (!state.open) return
      const el = (e.target as Element | null)?.closest?.('.c5-header')
      if (!el) closeAll()
    })
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && state.open) closeAll() })
    window.addEventListener('scroll', () => {
      const y = window.scrollY || document.documentElement.scrollTop || 0
      const dy = y - lastY
      let hidden = state.hidden
      if (y < 80) hidden = false
      else if (dy > 6) hidden = true
      else if (dy < -6) hidden = false
      lastY = y
      if (hidden !== state.hidden) set({ y, hidden, open: null })
      else if ((y > 40) !== (state.y > 40)) set({ y })
      else state.y = y
    }, { passive: true })
    narrowMq.addEventListener('change', render)
    state.y = lastY = window.scrollY || 0
    render()
  }
</script>
