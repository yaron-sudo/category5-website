          ))}
        </div>
        {p.usage.footnote && <p class="pusage__foot" data-reveal>{p.usage.footnote}</p>}
      </div>
    </section>
  )}

  <!-- ===== FAQ (high on the page, right after usage) ===== -->
  {p.faqs && p.faqs.length > 0 && (
    <section id="faq" class="ns-section ns-section--white">
      <div class="ns-container pfaq">
        <header class="phead phead--center" data-reveal>
          <span class="ns-eyebrow">שאלות ותשובות</span>
          <h2 class="ph2">מה שכדאי לדעת</h2>
        </header>
        <div class="pfaq__list">
          {p.faqs.filter((f) => f.question && f.answer).map((f, i) => (
            <details class="pfaq__item" data-reveal style={`transition-delay:${i * 60}ms`}>
              <summary>
                <span class="pfaq__q">{f.question}</span>
                <span class="pfaq__toggle" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
              </summary>
              <div class="pfaq__ans"><p>{f.answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== ORAC ===== -->
  {p.orac && p.orac.rows.length > 0 && (
    <section id="orac" class="ns-section ns-section--inverse p-orac">
      <div class="ns-container">
        <header class="phead phead--center" data-reveal>
          <span class="ns-eyebrow" style="color:var(--ns-immune-green)">המדע מאחורי היציבות</span>
          <h2 class="ph2" style="color:var(--ns-sun-beige)">{p.orac.heading || 'מדד ORAC — עוצמת נוגדי החמצון'}</h2>
          {p.orac.intro && <p class="p-orac__intro">{p.orac.intro}</p>}
        </header>
        <div class="p-orac__grid">
          <div class="p-orac__hero" data-reveal>
            <div class="p-orac__huge"><span data-orac-to={oracHero?.value}>{oracHero?.display}</span></div>
            <div class="p-orac__unit">יחידות ORAC · שמן המרווה המרושתת</div>
            {p.orac.lead && <p class="p-orac__lead">{p.orac.lead}</p>}
            {p.orac.caption && <p class="p-orac__cap">{p.orac.caption}</p>}
          </div>
          <div class="p-orac__chart" data-reveal style="transition-delay:120ms">
            {p.orac.rows.map((r, i) => (
              <div class={`p-orac__row ${r.highlight ? 'is-hl' : ''}`} data-reveal style={`transition-delay:${i * 110}ms`}>
                <span class="p-orac__name">{r.source}</span>
                <div class="p-orac__track"><div class="p-orac__bar" style={`--w:${Math.max((Math.sqrt(r.value) / Math.sqrt(oracMax)) * 100, 6)}%`}></div></div>
                <span class="p-orac__val" data-orac-to={r.value}>{r.display}</span>
              </div>
            ))}
          </div>
        </div>
        {p.orac.closing && <p class="p-orac__closing" data-reveal>{p.orac.closing}</p>}
      </div>
    </section>
  )}

  <!-- ===== PROCESS CTA ===== -->
  {p.processCta && (
    <section class="ns-section ns-section--tight pproc">
      <div class="ns-container" data-reveal><a class="ns-btn ns-btn--ghost" href={p.processCta.href}>{p.processCta.label}</a></div>
    </section>
  )}

  <!-- ===== PRODUCT LINE — identical to the home page products section ===== -->
  {p.productLine && p.productLine.items.length > 0 && (
    <section id="line" class="ns-section">
      <div class="ns-container">
        <header class="m-head m-head--row" data-reveal>
          <div>
            <span class="ns-eyebrow">{p.productLine.eyebrow || 'מוצרים נוספים'}</span>
            <h2 class="m-h2">{p.productLine.title || 'מוצרים ממקור אחד'}</h2>
          </div>
          {p.productLine.ctaHref && <a class="ns-btn ns-btn--ghost" href={p.productLine.ctaHref}>{p.productLine.ctaLabel || 'לכל המוצרים'}</a>}
        </header>
        <div class="ns-grid ns-grid--4">
          {p.productLine.items.map((it, i) => (
            <a class="m-prod" href={it.href} data-reveal style={`transition-delay:${i * 80}ms`}>
              <div class="m-prod__media">{it.imageUrl && <img src={it.imageUrl} alt={it.name} loading="lazy" />}</div>
              <div class="m-prod__body"><h3 class="m-prod__name">{it.name}</h3></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== LABEL LIGHTBOX ===== -->
  {(gallery || (p.labelLinks && p.labelLinks.length > 0)) && (
    <dialog class="ns-lightbox" data-lightbox aria-label="תצוגה מוגדלת">
      <button type="button" class="ns-lightbox__close" data-lightbox-close aria-label="סגירה">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
      <figure class="ns-lightbox__fig">
        <img data-lightbox-img src="" alt="" />
        <figcaption data-lightbox-cap></figcaption>
      </figure>
    </dialog>
  )}
  </div>

  <style>
    .pres__lede { font-size: var(--ns-text-md); line-height: 1.75; margin: 14px 0 6px; max-width: 64ch; }
    .pdocs { list-style: none; padding: 0; margin: 18px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
    .pdocs a { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 999px; border: 1px solid var(--ns-border); background: #fff; color: var(--ns-field-green); font-weight: 600; font-size: 14.5px; text-decoration: none; }
    .pdocs a:hover { border-color: var(--ns-pure-orange); color: var(--ns-pure-orange); }
    /* ---------- primary CTA (deep sage, soft shadow) ---------- */
    .pbtn--buy { background: var(--ns-field-green); color: var(--ns-sun-beige); box-shadow: 0 10px 26px -12px rgba(17,48,33,.7); }
    .pbtn--buy:hover { background: var(--ns-green-950); color: var(--ns-sun-beige); transform: translateY(-2px); box-shadow: 0 16px 30px -12px rgba(17,48,33,.75); }

    /* ---------- shared heads ---------- */
    .phead { max-width: 62ch; margin-block-end: var(--ns-space-8); }
    .phead--center { margin-inline: auto; text-align: center; max-width: 60ch; }
    .phead .ns-eyebrow { display: block; margin-block-end: 14px; }
    .ph2 { font-family: var(--ns-font-display); font-weight: 500; font-size: clamp(28px,3.2vw,46px); line-height: 1.2; letter-spacing: -0.01em; color: var(--ns-field-green); margin: 0; }

    /* ---------- HERO ---------- */
    .ph { position: relative; overflow: hidden; padding-block: clamp(48px,7vw,104px);
      background: radial-gradient(120% 120% at 85% 10%, color-mix(in srgb, var(--ns-immune-green) 22%, var(--ns-sun-beige)), var(--ns-sun-beige) 60%); }
    .ph__leaf { position: absolute; inset-block-start: -12%; inset-inline-start: -8%; width: 46%; aspect-ratio: 1; pointer-events: none;
      background: radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--ns-field-green) 10%, transparent), transparent 62%); opacity: .8; }
    .ph__grid { position: relative; display: grid; grid-template-columns: 0.82fr 1.55fr; gap: var(--ns-space-7); align-items: center; }
    .ph__title { font-family: var(--ns-font-display); font-weight: 500; font-size: clamp(34px,4.6vw,60px); line-height: 1.05; letter-spacing: -0.015em; color: var(--ns-field-green); margin-block: 14px 18px; }
    .ph__sub { font-size: clamp(18px,1.5vw,21px); line-height: 1.8; color: var(--ns-fg); opacity: .9; max-width: 48ch; }
    /* trust badges as readable chips with the original brand badge marks */
    /* symmetric chips: equal-width grid columns, equal height, identical icon box */
    .ph__trust { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; padding: 0; margin-block: 24px; max-width: 520px; }
    .ph__chip { display: flex; align-items: center; gap: 10px; min-height: 46px; font-size: 13.5px; font-weight: 600; line-height: 1.25; color: var(--ns-field-green); background: #fff; border: 1px solid var(--ns-border); border-radius: 999px; padding: 6px 16px 6px 12px; box-shadow: var(--ns-shadow-sm); transition: transform var(--ns-dur-base) var(--ns-ease-out), box-shadow var(--ns-dur-base) var(--ns-ease-out); }
    .ph__chip:hover { transform: translateY(-2px); box-shadow: var(--ns-shadow-md); }
    .ph__chip-ic { flex: none; width: 32px; height: 26px; display: grid; place-items: center; color: var(--ns-pure-orange); }
    .ph__chip-ic img { height: 24px; width: auto; max-width: 32px; object-fit: contain; display: block; }
    .ph__chip-txt { min-width: 0; }
    @media (max-width: 480px) { .ph__trust { gap: 7px; } .ph__chip { min-height: 40px; font-size: 12.5px; padding: 5px 10px 5px 8px; gap: 6px; } .ph__chip-ic { width: 24px; height: 22px; } }
    /* equal-column grid → every hero button is exactly the same width & height */
    .ph__cta { display: inline-grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 12px; }
    .ph__btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; min-width: 228px; padding-inline: 26px; white-space: nowrap; }
    .ph__btn svg { flex: none; }
    /* Match the home-page hero (Carousel): the image is the dominant column, shown
       at its natural aspect with a rounded frame, soft shadow, and warm glow. */
    .ph__media { position: relative; }
    .ph__media::before { content: ""; position: absolute; inset: -10% -8%; z-index: 0; background: radial-gradient(58% 58% at 68% 32%, color-mix(in srgb, var(--ns-pure-orange) 24%, transparent), transparent 70%); filter: blur(34px); pointer-events: none; }
    .ph__media-inner { position: relative; z-index: 1; }
    .ph__media-inner img { width: 100%; height: auto; display: block; border-radius: var(--ns-radius-xl); box-shadow: var(--ns-shadow-lg); }

    /* ---------- HERO GALLERY (white-bg product photos blended onto the page) ----------
       The product shots are photographed on pure white; `mix-blend-mode: multiply`
       makes that white disappear into the cream hero so the bottle sits cleanly on
       the background with no white box — main image and thumbnails alike. */
    .ph__grid--gallery { grid-template-columns: 1fr 1fr; }
    .ph__media--gallery { display: flex; flex-direction: column; align-items: center; }
    .ph__media--gallery::before { inset: 4% 2%; }
    /* IMPORTANT for the multiply blend: nothing between the <img> and the hero
       background may create a stacking context (no z-index, opacity<1, transform,
       will-change/data-reveal, filter on an ancestor) — otherwise the blend is
       isolated against a transparent box and the photo's white stays white. */
    .ph__gframe { position: relative; display: grid; place-items: center; width: 100%; }
    /* the wrapper owns the height; the <img> derives its width from it, so the
       wrapper (and the 🔍 button pinned to it) hugs the photo exactly */
    .ph__gframe img { display: block; height: 100%; width: auto; max-width: 100%; object-fit: contain; mix-blend-mode: multiply; transition: opacity .28s var(--ns-ease-out); }
    .ph__gthumbs { position: relative; display: flex; flex-wrap: wrap; gap: 8px; margin-block-start: 18px; justify-content: center; }
    .ph__gthumb { width: 62px; height: 62px; padding: 6px; border-radius: 14px; overflow: hidden; border: 1.5px solid transparent; background: transparent; cursor: pointer; transition: border-color .2s var(--ns-ease-out), background .2s var(--ns-ease-out); }
    .ph__gthumb.is-active { border-color: var(--ns-pure-orange); background: color-mix(in srgb, var(--ns-pure-orange) 7%, transparent); }
    /* dim via the image itself (opacity on the button would isolate the blend) */
    .ph__gthumb img { width: 100%; height: 100%; object-fit: contain; display: block; mix-blend-mode: multiply; opacity: .55; transition: opacity .2s var(--ns-ease-out); }
    .ph__gthumb:hover img, .ph__gthumb.is-active img { opacity: 1; }
    /* magnifier — the wrapper is position:relative WITHOUT z-index so it never
       isolates the photo's blend; the lens is a crisp "glass" (no blend). */
    .ph__gimg { position: relative; display: inline-block; height: min(64vh, 560px); max-width: 100%; cursor: zoom-in; }
    @media (max-width: 900px) { .ph__gimg { height: min(50vh, 440px); } }
    .ph__lens { position: absolute; inset-block-start: 0; inset-inline-start: 0; width: 200px; height: 200px; border-radius: 999px; border: 2px solid color-mix(in srgb, var(--ns-field-green) 55%, transparent); background: #fff no-repeat; box-shadow: 0 22px 44px -16px rgba(17,48,33,.5), inset 0 0 0 5px rgba(255,255,255,.55); pointer-events: none; opacity: 0; transform: scale(.85); transition: opacity .16s var(--ns-ease-out), transform .16s var(--ns-ease-out); z-index: 2; }
    .ph__lens.is-on { opacity: 1; transform: none; }
    /* zoom control: a labeled pill at the photo's bottom-centre — product shots
       carry wide white margins, so a corner button would float far from the item */
    .ph__zoom-hint { position: absolute; inset-block-end: 8px; left: 50%; transform: translateX(-50%); z-index: 3; display: inline-flex; align-items: center; gap: 7px; padding: 8px 14px 8px 12px; border-radius: 999px; border: 1px solid var(--ns-border); background: var(--ns-bg-alt); color: var(--ns-field-green); font: inherit; font-size: 13.5px; font-weight: 700; white-space: nowrap; cursor: zoom-in; box-shadow: var(--ns-shadow-sm); transition: background .2s var(--ns-ease-out), color .2s var(--ns-ease-out), transform .2s var(--ns-ease-out); }
    .ph__zoom-hint:hover { background: var(--ns-field-green); color: var(--ns-sun-beige); transform: translateX(-50%) scale(1.05); }
    @media (hover: none), (pointer: coarse) { .ph__lens { display: none; } }
    /* subtle scroll-driven float on the hero product shot (CSS only, enhanced) */
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .ph__gframe img { animation: phFloat linear both; animation-timeline: view(); animation-range: entry 0% exit 100%; }
      }
    }
    @keyframes phFloat { from { transform: translateY(16px); } to { transform: translateY(-16px); } }

    /* ---------- METRICS ---------- */
    .pm__grid { display: grid; grid-template-columns: repeat(4,1fr); gap: clamp(14px,1.6vw,22px); }
    .pm__card { background: var(--ns-bg-alt); border: 1px solid var(--ns-border); border-radius: var(--ns-radius-lg); padding: clamp(22px,2.4vw,32px) 20px; text-align: center; transition: transform var(--ns-dur-base) var(--ns-ease-out), box-shadow var(--ns-dur-base) var(--ns-ease-out); }
    .pm__card:hover { transform: translateY(-4px); box-shadow: var(--ns-shadow-md); }
    .pm__icon { display: block; margin: 0 auto 12px; opacity: .9; }
    .pm__value { font-family: var(--ns-font-display); font-weight: 900; font-size: clamp(30px,3.2vw,42px); line-height: 1; color: var(--ns-field-green); }
    .pm__label { font-size: clamp(14.5px, 1.15vw, 16px); color: var(--ns-fg-muted); margin-block-start: 11px; line-height: 1.5; }

    /* ---------- COMPARISON TABLE ---------- */
    .pcmp { overflow-x: auto; max-width: 940px; margin-inline: auto; padding-block-start: 12px; }
    .pcmp__t { width: 100%; border-collapse: separate; border-spacing: 0; background: var(--ns-bg-alt); border: 1px solid var(--ns-border); border-radius: var(--ns-radius-lg); overflow: hidden; }
    .pcmp__t th, .pcmp__t td { padding: 18px 16px; border-block-end: 1px solid var(--ns-border); }
    .pcmp__t tbody tr:last-child th, .pcmp__t tbody tr:last-child td { border-block-end: 0; }
    .pcmp__corner { background: transparent; border-block-end-color: transparent; }
    .pcmp__t th.pcmp__col { text-align: center; vertical-align: middle; padding-block: 24px; }
    .pcmp__t th.pcmp__col--hl { background: var(--ns-field-green); position: relative; }
    /* "our choice" tag on the highlighted column + text labels beside each mark,
       and a legend below — so the table reads unambiguously at a glance */
    .pcmp__tag { display: inline-block; font-size: 11.5px; font-weight: 700; letter-spacing: .05em; color: var(--ns-sun-beige); background: var(--ns-pure-orange); border-radius: 999px; padding: 3px 11px; margin-block-end: 8px; }
    .pcmp__mark { display: inline-flex; flex-direction: column; align-items: center; gap: 5px; }
    .pcmp__txt { font-size: 12.5px; font-weight: 600; line-height: 1; }
    .pcmp__mark--yes .pcmp__txt { color: var(--ns-field-green); }
    .pcmp__mark--no .pcmp__txt { color: var(--ns-light-gray); }
    .pcmp__mark--partial .pcmp__txt { color: var(--ns-pure-orange); }
    .pcmp__legend { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 28px; padding: 0; margin: 22px auto 0; font-size: var(--ns-text-sm); font-weight: 600; color: var(--ns-field-green); }
    .pcmp__legend li { display: inline-flex; align-items: center; gap: 9px; }
    .pcmp__legend .pcmp__ic { width: 26px; height: 26px; }
    .pcmp__colname { font-family: var(--ns-font-display); font-weight: 700; font-size: 17px; color: var(--ns-field-green); }
    .pcmp__col--hl .pcmp__colname { color: var(--ns-sun-beige); }
    .pcmp__crit { text-align: start; font-weight: 600; font-size: var(--ns-text-md); color: var(--ns-field-green); background: color-mix(in srgb, var(--ns-sun-beige) 55%, transparent); }
    .pcmp__cell { text-align: center; }
    .pcmp__cell--hl { background: color-mix(in srgb, var(--ns-immune-green) 15%, transparent); }
    .pcmp__ic { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 999px; }
    .pcmp__ic--yes { background: color-mix(in srgb, var(--ns-field-green) 15%, transparent); color: var(--ns-field-green); }
    .pcmp__cell--hl .pcmp__ic--yes { background: var(--ns-field-green); color: var(--ns-sun-beige); }
    .pcmp__ic--no { background: color-mix(in srgb, var(--ns-light-gray) 20%, transparent); color: var(--ns-light-gray); }
    .pcmp__ic--partial { background: color-mix(in srgb, var(--ns-pure-orange) 16%, transparent); color: var(--ns-pure-orange); }
    .pcmp__note { text-align: center; color: var(--ns-fg-muted); font-size: var(--ns-text-sm); margin-block-start: 22px; max-width: 70ch; margin-inline: auto; }
    @media (max-width: 640px) { .pcmp__t th, .pcmp__t td { padding: 13px 8px; } .pcmp__col { font-size: 13px; } .pcmp__crit { font-size: 12.5px; } }

    /* ---------- STORY ---------- */
    .pstory { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px,2.4vw,36px); align-items: start; }
    /* unified text box (see .ns-textbox in components.css) */
    .pstory__block { background: var(--ns-bg-alt); border: 1px solid var(--ns-border); border-radius: var(--ns-radius-lg); box-shadow: var(--ns-shadow-md); padding: clamp(28px,3.2vw,52px); }
    .pstory__h { font-family: var(--ns-font-display); font-weight: 500; font-size: clamp(22px,2.2vw,30px); line-height: 1.25; color: var(--ns-field-green); margin: 0 0 14px; }
    .pstory__p { font-size: var(--ns-text-md); line-height: 1.9; color: var(--ns-fg); opacity: .9; margin: 0; }
    /* rich-text card body (PortableText output → :global) — same voice as .pstory__p */
    .pstory__prose :global(p) { font-size: var(--ns-text-md); line-height: 1.85; color: var(--ns-fg); opacity: .9; margin: 0 0 14px; }
    .pstory__prose :global(p:last-child) { margin-block-end: 0; }
    .pstory__prose :global(img), .pstory__prose :global(.pt-figure) { display: block; width: 100%; height: auto; border-radius: 14px; margin: 2px 0 16px; }
    .pstory__prose :global(a) { display: inline-flex; align-items: center; font-size: 13px; font-weight: 700; color: var(--ns-pure-orange); text-decoration: none; border: 1px solid color-mix(in srgb, var(--ns-pure-orange) 45%, transparent); border-radius: 999px; padding: 2px 11px; margin-inline-start: 4px; white-space: nowrap; transition: background .2s var(--ns-ease-out), color .2s var(--ns-ease-out); }
    .pstory__prose :global(a:hover) { background: var(--ns-pure-orange); color: var(--ns-sun-beige); }
    .pstory__prose :global(.pt-small), .pstory__prose :global(blockquote) { font-size: 13px; line-height: 1.6; color: var(--ns-fg-muted); opacity: 1; margin: 16px 0 0; padding-block-start: 12px; border-block-start: 1px solid var(--ns-border); }
    .pstory__prose :global(h3) { font-family: var(--ns-font-display); font-weight: 600; font-size: 19px; color: var(--ns-field-green); margin: 18px 0 8px; }

    /* ---------- NARRATIVE (two columns: prose + data panel) ---------- */
    .pnar2 { display: grid; grid-template-columns: 1.35fr .65fr; gap: clamp(28px,4vw,64px); align-items: start; }
    .pnar2__head { margin-block-end: var(--ns-space-6); }
    .pnar2__head .ns-eyebrow { display: block; margin-block-end: 12px; }
