    .pfaq__toggle { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 999px; background: color-mix(in srgb, var(--ns-field-green) 8%, transparent); color: var(--ns-field-green); transition: transform .3s var(--ns-ease-out), background .2s var(--ns-ease-out), color .2s var(--ns-ease-out); }
