---
import Base from '@/layouts/Base.astro'
import FeatureCard from '@/components/FeatureCard.astro'
import PortableText from '@/components/PortableText.astro'
import SectionBar from '@/components/SectionBar.astro'
import VideoSection from '@/components/VideoSection.astro'
import { youtubeId, type PortableBlock, type Feature } from '@/lib/sanity'

// Premium product page: hero → metrics → why-different → features → research →
// ORAC → product line → FAQ, plus a sticky mobile buy bar. Airy, RTL, cream +
// deep-sage palette with small gold/orange accents. The route resolves a Sanity
// product doc (or fallback) into this view model.
export interface ProductViewModel {
  name: string
  tagline?: string
  heroEyebrow?: string
  subheading?: string
  badges?: string[]
  buyUrl?: string
  buyLabel?: string
  secondaryCta?: { label: string; href: string }
  heroImageUrl?: string
  heroImageAlt?: string
  /** Click-through product gallery; when present it replaces the single hero image. */
  gallery?: Array<{ url: string; thumbUrl: string; zoomUrl?: string; alt?: string }>
  usage?: { intro?: string; items?: Array<{ audience: string; dose: string; note?: string; icon?: string }>; footnote?: string }
  /** Product-label scans opened in a lightbox from the narrative panel. */
  labelLinks?: Array<{ label: string; url: string }>
  stats?: Array<{ value: string; label: string; icon?: string }>
  comparison?: { eyebrow?: string; title?: string; note?: string; columns: string[]; rows: Array<{ label: string; cells: Array<'yes' | 'no' | 'partial'> }> }
  story?: { eyebrow?: string; blocks: Array<{ heading: string; paragraph: string }> }
  narrative?: { eyebrow?: string; heading: string; paragraphs: string[]; listCaption?: string; list?: Array<{ label: string; value: string }>; footnote?: string }
  features?: Feature[]
  featuresEyebrow?: string
  featuresTitle?: string
  research?: { eyebrow?: string; title?: string; lede?: string; points: string[]; badge?: string; badgeSub?: string }
  bodyBlocks?: PortableBlock[]
  /** Body split at its h2s → rendered as the site's standard text cards (uniform with the story section). */
  proseSections?: Array<{ heading?: string; blocks: PortableBlock[] }>
  orac?: { heading?: string; intro?: string; closing?: string; caption?: string; lead?: string; rows: Array<{ source: string; value: number; display: string; highlight?: boolean }> }
  productLine?: { eyebrow?: string; title?: string; ctaLabel?: string; ctaHref?: string; items: Array<{ name: string; tag?: string; href: string; imageUrl?: string }> }
  processCta?: { label: string; href: string }
  faqs?: Array<{ question?: string; answer?: string }>
  /** Badge label → icon URL (brand badge artwork). */
  badgeIcons?: Record<string, string>
  /** Product-family accent colour (tints buttons, chips and highlights). */
  accent?: string
  video?: string
  /** Downloadable documents (leaflet PDF, clinical study…), shown in the usage panel. */
  docs?: Array<{ label: string; href: string }>
  seo: { title: string; description?: string; image?: string; canonical?: string; noindex?: boolean; ogTitle?: string; ogDescription?: string }
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}
const p = Astro.props as ProductViewModel
const oracMax = p.orac ? Math.max(...p.orac.rows.map((r) => r.value)) : 1
const oracHero = p.orac?.rows.find((r) => r.highlight) ?? p.orac?.rows[0]
const gallery = p.gallery?.length ? p.gallery : undefined

// Section bar entries: one chip per section that actually renders, in page order.
const barEntries = [
  p.comparison?.rows.length ? { id: 'why', label: p.comparison.eyebrow || 'למה זה שונה' } : null,
  p.story?.blocks.length ? { id: 'story', label: p.story.eyebrow || 'הסיפור' } : null,
  p.features?.length ? { id: 'features', label: p.featuresEyebrow || 'תכונות המוצר' } : null,
  p.research ? { id: 'research', label: p.research.eyebrow || 'מדע וטבע' } : null,
  p.proseSections?.length || p.bodyBlocks?.length ? { id: 'more', label: 'מידע נוסף' } : null,
  p.video ? { id: 'video', label: 'וידאו' } : null,
  p.narrative ? { id: 'narrative', label: p.narrative.eyebrow || p.narrative.heading } : null,
  p.usage?.items?.length ? { id: 'usage', label: 'הוראות שימוש' } : null,
  p.faqs?.length ? { id: 'faq', label: 'שאלות ותשובות' } : null,
  p.orac?.rows.length ? { id: 'orac', label: 'מדד ORAC' } : null,
  p.productLine?.items.length ? { id: 'line', label: p.productLine.eyebrow || 'עוד מוצרים' } : null,
].filter((e): e is { id: string; label: string } => !!e)

// Features grid: rows of 3 when the count divides evenly by 3 (e.g. 6 cards),
// otherwise rows of 4 (e.g. the flagship's 8) — keeps rows full and balanced.
const featCols = p.features?.length && p.features.length % 3 === 0 && p.features.length % 4 !== 0 ? 3 : 4

// Hero trust badges: match a label to a brand badge SVG (public/icons/badges);
// unmatched labels fall back to the orange dot.
const badgeIcon = (label: string): string | undefined => p.badgeIcons?.[label]
// Line-icon fallback so every chip carries a mark (no bare dots): keyword →
// SVG path (stroke = currentColor). Last entry is the generic default.
const badgeGlyph = (label: string): string => {
  if (/מתכות|נקי|מזהמ/.test(label)) return '<path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.2 7.5 9.5 4.3-1.3 7.5-4.9 7.5-9.5V6z"/><path d="m9 12 2.2 2.2L15.5 10"/>'
  if (/משמר|מייצב|תוספ/.test(label)) return '<path d="M12 3c3 3.6 5.5 6.6 5.5 9.5a5.5 5.5 0 0 1-11 0C6.5 9.6 9 6.6 12 3z"/><path d="M9.5 13.5a2.5 2.5 0 0 0 2.5 2.5"/>'
  if (/מומח|המלצ|רופא|מקצוע/.test(label)) return '<circle cx="12" cy="9" r="4.6"/><path d="M8.8 13 7.5 21l4.5-2.4L16.5 21l-1.3-8"/>'
  if (/כשר/.test(label)) return '<path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L3.3 9.3l6.1-.7z"/>'
  if (/כבישה|קר/.test(label)) return '<path d="M12 3v18M5 7.5 12 12l7-4.5M5 16.5 12 12l7 4.5"/>'
  return '<circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.3 2.3L15.5 10"/>'
}

// Line icons for the usage/dosage cards (stroke = currentColor).
const USAGE_ICONS: Record<string, string> = {
  adult: '<circle cx="12" cy="7.2" r="3.2"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/>',
  women: '<circle cx="9" cy="8" r="3.1"/><path d="M3.6 19a5.4 5.4 0 0 1 10.8 0M16.5 5.6a3 3 0 0 1 0 5.8M18 19a5.4 5.4 0 0 0-2.8-4.7"/>',
  pregnancy: '<path d="M12 20s-7-4.6-7-9.3C5 7.9 7 6 9.4 6c1.5 0 2.6 1.1 2.6 1.1S13.1 6 14.6 6C17 6 19 7.9 19 10.7c0 4.7-7 9.3-7 9.3z"/>',
  kids: '<circle cx="12" cy="8.5" r="2.8"/><path d="M6.8 19a5.2 5.2 0 0 1 10.4 0M9.5 3.8C10.3 3.3 11.1 3 12 3s1.7.3 2.5.8"/>',
  boost: '<path d="M4 17l6-6 4 4 6-7M14 8h6v6"/>',
}
---
<Base
  title={p.seo.title}
  description={p.seo.description}
  image={p.seo.image}
  type="product"
  noindex={p.seo.noindex}
  canonicalUrl={p.seo.canonical}
  ogTitle={p.seo.ogTitle}
  ogDescription={p.seo.ogDescription}
  jsonLd={p.jsonLd}
>
  <div class="pv" style={p.accent ? `--ns-pure-orange:${p.accent};--pv-accent:${p.accent}` : undefined}>
  <SectionBar entries={barEntries} />

  <!-- ===== HERO ===== -->
  <section class="ph">
    <span class="ph__leaf" aria-hidden="true"></span>
    <div class={`ns-container ph__grid${gallery ? ' ph__grid--gallery' : ''}`}>
      <div class="ph__text" data-reveal="now">
        {p.heroEyebrow && <span class="ns-eyebrow">{p.heroEyebrow}</span>}
        <h1 class="ph__title">{p.name}</h1>
        {p.subheading && <p class="ph__sub">{p.subheading}</p>}
        {p.badges && p.badges.length > 0 && (
          <ul class="ph__trust">
            {p.badges.map((b) => (
              <li class="ph__chip">
                <span class="ph__chip-ic" aria-hidden="true">
                  {badgeIcon(b)
                    ? <img src={badgeIcon(b)} alt="" width="30" height="24" loading="lazy" />
                    : <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={badgeGlyph(b)} />}
                </span>
                <span class="ph__chip-txt">{b}</span>
              </li>
            ))}
          </ul>
        )}
        <div class="ph__cta">
          {p.buyUrl && (
            <a class="ns-btn pbtn--buy ph__btn" href={p.buyUrl} rel="noopener">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H7"/><circle cx="10.4" cy="19.6" r="1.3"/><circle cx="17.2" cy="19.6" r="1.3"/></svg>
              <span>{p.buyLabel || 'לרכישת מוצרים'}</span>
            </a>
          )}
          {p.secondaryCta && (
            <a class="ns-btn ns-btn--ghost ph__btn" href={p.secondaryCta.href}>
              {p.secondaryCta.href.startsWith('#')
                ? <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
                : <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>}
              <span>{p.secondaryCta.label}</span>
            </a>
          )}
        </div>
      </div>
      {gallery ? (
        <div class="ph__media ph__media--gallery">
          <div class="ph__gframe">
            {/* magnifier: hover lens on fine pointers; tap/click → full-size lightbox */}
            <div class="ph__gimg" data-zoom-frame>
              <img data-gallery-main src={gallery[0].url} data-zoom={gallery[0].zoomUrl || gallery[0].url} alt={gallery[0].alt || p.name} loading="eager" />
              <span class="ph__lens" data-zoom-lens aria-hidden="true"></span>
              <button type="button" class="ph__zoom-hint" data-zoom-open aria-label="הגדלת תמונת המוצר">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8M8.5 11h5M11 8.5v5"/></svg>
                <span>הגדלה</span>
              </button>
            </div>
          </div>
          {gallery.length > 1 && (
            <div class="ph__gthumbs" aria-label="תמונות המוצר">
              {gallery.map((g, i) => (
                <button
                  type="button"
                  class={`ph__gthumb${i === 0 ? ' is-active' : ''}`}
                  data-gallery-thumb
                  data-url={g.url}
                  data-zoom={g.zoomUrl || g.url}
                  data-alt={g.alt || ''}
                  aria-label={`הצגת תמונה ${i + 1}`}
                >
                  <img src={g.thumbUrl} alt="" loading={i === 0 ? 'eager' : 'lazy'} width="64" height="64" />
                </button>
              ))}
            </div>
          )}
        </div>
      ) : p.heroImageUrl && (
        <div class="ph__media" data-reveal="now">
          <div class="ph__media-inner"><img src={p.heroImageUrl} alt={p.heroImageAlt || p.name} loading="eager" /></div>
        </div>
      )}
    </div>
  </section>

  <!-- ===== METRICS ===== -->
  {p.stats && p.stats.length > 0 && (
    <section class="ns-section ns-section--tight pm">
      <div class="ns-container pm__grid">
        {p.stats.map((s, i) => (
          <div class="pm__card" data-reveal style={`transition-delay:${i * 70}ms`}>
            {s.icon && <img class="pm__icon" src={`/icons/benefit/${s.icon}.svg`} alt="" aria-hidden="true" width="40" height="40" />}
            <div class="pm__value" data-count>{s.value}</div>
            <div class="pm__label">{s.label}</div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ===== WHY DIFFERENT (comparison table) ===== -->
  {p.comparison && p.comparison.rows.length > 0 && (
    <section id="why" class="ns-section ns-section--beige">
      <div class="ns-container">
        <header class="phead phead--center" data-reveal>
          <span class="ns-eyebrow">{p.comparison.eyebrow || 'למה זה שונה'}</span>
          <h2 class="ph2">{p.comparison.title || 'מה מייחד את שמן המרווה המרושתת'}</h2>
        </header>
        <div class="pcmp" data-reveal>
          <table class="pcmp__t">
            <thead>
              <tr>
                <th class="pcmp__corner"></th>
                {p.comparison.columns.map((c, i) => (
                  <th class={i === 0 ? 'pcmp__col pcmp__col--hl' : 'pcmp__col'}>
                    {i === 0 && <span class="pcmp__tag">הבחירה שלנו</span>}
                    <span class="pcmp__colname">{c}</span>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {p.comparison.rows.map((row) => (
                <tr>
                  <th scope="row" class="pcmp__crit">{row.label}</th>
                  {row.cells.map((cell, ci) => (
                    <td class={ci === 0 ? 'pcmp__cell pcmp__cell--hl' : 'pcmp__cell'}>
                      {cell === 'yes' && (
                        <span class="pcmp__mark pcmp__mark--yes">
                          <span class="pcmp__ic pcmp__ic--yes" role="img" aria-label="כן"><svg viewBox="0 0 24 24" width="24" height="24"><path d="M6 12.5l3.5 3.5L18 8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                          <span class="pcmp__txt" aria-hidden="true">כן</span>
                        </span>
                      )}
                      {cell === 'no' && (
                        <span class="pcmp__mark pcmp__mark--no">
                          <span class="pcmp__ic pcmp__ic--no" role="img" aria-label="לא"><svg viewBox="0 0 24 24" width="24" height="24"><path d="M7 7l10 10M17 7L7 17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></span>
                          <span class="pcmp__txt" aria-hidden="true">לא</span>
                        </span>
                      )}
                      {cell === 'partial' && (
                        <span class="pcmp__mark pcmp__mark--partial">
                          <span class="pcmp__ic pcmp__ic--partial" role="img" aria-label="נמוך מאוד"><svg viewBox="0 0 24 24" width="24" height="24"><path d="M7 12h10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></span>
                          <span class="pcmp__txt" aria-hidden="true">נמוך מאוד</span>
                        </span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <ul class="pcmp__legend" data-reveal aria-label="מקרא">
          <li><span class="pcmp__ic pcmp__ic--yes" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><path d="M6 12.5l3.5 3.5L18 8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>יתרון מלא</li>
          <li><span class="pcmp__ic pcmp__ic--partial" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><path d="M7 12h10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></span>נמוך מאוד</li>
          <li><span class="pcmp__ic pcmp__ic--no" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><path d="M7 7l10 10M17 7L7 17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></span>אין</li>
        </ul>
        {p.comparison.note && <p class="pcmp__note" data-reveal>{p.comparison.note}</p>}
      </div>
    </section>
  )}

  <!-- ===== STORY / NARRATIVE ===== -->
  {p.story && p.story.blocks.length > 0 && (
    <section id="story" class="ns-section ns-section--white">
      <div class="ns-container">
        {p.story.eyebrow && (
          <header class="phead phead--center" data-reveal><span class="ns-eyebrow">{p.story.eyebrow}</span></header>
        )}
        <div class="pstory">
          {p.story.blocks.map((b, i) => (
            <article class="pstory__block" data-reveal style={`transition-delay:${i * 90}ms`}>
              <h3 class="pstory__h">{b.heading}</h3>
              <div class="ns-fold" data-fold>
                <p class="pstory__p">{b.paragraph}</p>
              </div>
              <button type="button" class="ns-fold__btn" data-fold-btn aria-expanded="false">קרא עוד</button>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== FEATURES ===== -->
  {p.features && p.features.length > 0 && (
    <section id="features" class="ns-section">
      <div class="ns-container">
        <header class="phead phead--center" data-reveal>
          <span class="ns-eyebrow">{p.featuresEyebrow || 'תכונות המוצר'}</span>
          <h2 class="ph2">{p.featuresTitle || 'אוסף נדיר של איכויות, ממקור אחד בטבע'}</h2>
        </header>
        <div class="pfeat" style={`--pfeat-cols:${featCols}`}>
          {p.features.map((f, i) => (
            <div class="m-cell" data-reveal style={`transition-delay:${(i % featCols) * 60}ms`}><FeatureCard feature={f} /></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== RESEARCH / CREDIBILITY ===== -->
  {p.research && (
    <section id="research" class="ns-section ns-section--beige">
      <div class="ns-container pres">
        <div class="pres__text" data-reveal>
          <span class="ns-eyebrow">{p.research.eyebrow || 'מדע וטבע'}</span>
          <h2 class="ph2">{p.research.title || 'יתרונות המוצר'}</h2>
          {p.research.lede && <p class="pres__lede">{p.research.lede}</p>}
          <ul class="pres__points">
            {p.research.points.map((pt) => <li><span class="pres__leaf" aria-hidden="true"></span>{pt}</li>)}
          </ul>
        </div>
        {p.research.badge && (
          <aside class="pres__badge" data-reveal style="transition-delay:100ms">
            <span class="pres__badge-mark" aria-hidden="true"></span>
            <strong>{p.research.badge}</strong>
            {p.research.badgeSub && <span>{p.research.badgeSub}</span>}
          </aside>
        )}
      </div>
    </section>
  )}

  <!-- ===== CMS BODY as text cards (uniform with the story cards) ===== -->
  {p.proseSections && p.proseSections.length > 0 && (
    <section id="more" class="ns-section ns-section--white">
      <div class="ns-container">
        <header class="phead phead--center" data-reveal><span class="ns-eyebrow">מידע נוסף</span></header>
        <div class="pstory pstory--even">
          {p.proseSections.map((s, i) => (
            <article class="pstory__block" data-reveal style={`transition-delay:${i * 90}ms`}>
              {s.heading && <h3 class="pstory__h">{s.heading}</h3>}
              {/* data-fold="always": clamps on desktop too, so sibling cards stay symmetric */}
              <div class="ns-fold" data-fold="always">
                <PortableText blocks={s.blocks} class="pstory__prose" />
              </div>
              <button type="button" class="ns-fold__btn" data-fold-btn aria-expanded="false">קרא עוד</button>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
  {!p.proseSections?.length && p.bodyBlocks?.length && (
    <section id="more" class="ns-section ns-section--white">
      <div class="ns-container pbody"><PortableText blocks={p.bodyBlocks} class="ns-prose m-rt" /></div>
    </section>
  )}

  {p.video && youtubeId(p.video) && (
    <section id="video" class="ns-section ns-section--tight">
      <div class="ns-container"><VideoSection youtubeId={youtubeId(p.video)!} title={p.name} /></div>
    </section>
  )}

  <!-- ===== NARRATIVE — two columns (prose + reference-data panel) ===== -->
  {p.narrative && (
    <section id="narrative" class="ns-section ns-section--white">
      <div class="ns-container pnar2">
        <div class="pnar2__main" data-reveal>
          <header class="pnar2__head">
            {p.narrative.eyebrow && <span class="ns-eyebrow">{p.narrative.eyebrow}</span>}
            <h2 class="ph2">{p.narrative.heading}</h2>
          </header>
          <div class="pnar2__prose ns-fold" data-fold>
            {p.narrative.paragraphs.map((t) => <p>{t}</p>)}
          </div>
          <button type="button" class="ns-fold__btn" data-fold-btn aria-expanded="false">קרא עוד</button>
          {p.docs && p.docs.length > 0 && (
            <ul class="pdocs">
              {p.docs.map((d) => (
                <li><a href={d.href} target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>
                  {d.label}</a></li>
              ))}
            </ul>
          )}
          {p.narrative.footnote && <p class="pnar2__foot">{p.narrative.footnote}</p>}
        </div>
        {p.narrative.list && p.narrative.list.length > 0 && (
          <aside class="pnar2__panel" data-reveal style="transition-delay:120ms">
            {p.narrative.listCaption && <p class="pnar2__panel-cap">{p.narrative.listCaption}</p>}
            <ul>
              {p.narrative.list.map((it) => (
                <li><span class="pnar2__lbl">{it.label}</span><span class="pnar2__val">{it.value}</span></li>
              ))}
            </ul>
            {p.labelLinks && p.labelLinks.length > 0 && (
              <div class="pnar2__labels">
                {p.labelLinks.map((l) => (
                  <button type="button" class="pnar2__label-btn" data-lightbox-open data-url={l.url} data-caption={l.label}>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8M8.5 11h5M11 8.5v5"/></svg>
                    {l.label}
                  </button>
                ))}
              </div>
            )}
          </aside>
        )}
      </div>
    </section>
  )}

  <!-- ===== USAGE / DOSAGE ===== -->
  {p.usage?.items?.length && (
    <section id="usage" class="ns-section ns-section--beige pusage">
      <div class="ns-container">
        <header class="phead phead--center" data-reveal>
          <span class="ns-eyebrow">איך משתמשים</span>
          <h2 class="ph2">הוראות שימוש ומינון</h2>
          {p.usage.intro && <p class="pusage__intro">{p.usage.intro}</p>}
        </header>
        <div class="pusage__grid">
          {p.usage.items.map((u, i) => (
            <div class="pusage__card" data-reveal style={`transition-delay:${i * 70}ms`}>
              <span class="pusage__ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={USAGE_ICONS[u.icon ?? 'adult'] ?? USAGE_ICONS.adult} />
              </span>
              <span class="pusage__aud">{u.audience}</span>
              <span class="pusage__dose">{u.dose}</span>
              {u.note && <span class="pusage__note">{u.note}</span>}
