  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // Hero gallery: click a thumbnail to swap the main image (with a soft fade).
    const gmain = document.querySelector('[data-gallery-main]') as HTMLImageElement | null
    if (gmain) {
      document.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const url = btn.dataset.url || ''
          if (!url || gmain.src === url) return
          document.querySelectorAll('[data-gallery-thumb].is-active').forEach((b) => b.classList.remove('is-active'))
          btn.classList.add('is-active')
          let swapped = false
          const swap = () => {
            if (swapped) return
            swapped = true
            gmain.src = url
            gmain.dataset.zoom = btn.dataset.zoom || url
            if (btn.dataset.alt) gmain.alt = btn.dataset.alt
            requestAnimationFrame(() => { gmain.style.opacity = '1' })
          }
          if (reduce) { swap(); return }
          gmain.style.opacity = '0'
          const pre = new Image()
          pre.onload = swap
          pre.onerror = swap
          setTimeout(swap, 800) // don't stall on a slow preload
          pre.src = url
        })
      })
    }
    const fmt = (n: number) => n.toLocaleString('he-IL')
    const ease = (k: number) => 1 - Math.pow(1 - k, 3)

    // Lightbox (native <dialog>) shared by the label scans and the product
    // zoom. ESC is native; backdrop click + X close it.
    const lb = document.querySelector<HTMLDialogElement>('[data-lightbox]')
    const openLightbox = (src: string, caption: string) => {
      if (!lb || !src) return
      const lbImg = lb.querySelector<HTMLImageElement>('[data-lightbox-img]')!
      const lbCap = lb.querySelector<HTMLElement>('[data-lightbox-cap]')!
      lbImg.src = src
      lbImg.alt = caption
      lbCap.textContent = caption
      lb.showModal()
    }
    if (lb) {
      document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]').forEach((btn) => {
        btn.addEventListener('click', () => openLightbox(btn.dataset.url || '', btn.dataset.caption || ''))
      })
      lb.querySelector('[data-lightbox-close]')?.addEventListener('click', () => lb.close())
      lb.addEventListener('click', (e) => { if (e.target === lb) lb.close() })
    }

    // Product magnifier: on fine pointers a round lens follows the cursor over
    // the hero photo (hi-res source, 2.4×); on touch — or on click anywhere —
    // the photo opens full-size in the lightbox.
    const zoomFrame = document.querySelector<HTMLElement>('[data-zoom-frame]')
    if (gmain && zoomFrame) {
      const lens = zoomFrame.querySelector<HTMLElement>('[data-zoom-lens]')
      const ZOOM = 2.4
      const zoomSrc = () => gmain.dataset.zoom || gmain.src
      if (lens && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const move = (e: MouseEvent) => {
          const r = gmain.getBoundingClientRect()
          const x = e.clientX - r.left, y = e.clientY - r.top
          if (x < 0 || y < 0 || x > r.width || y > r.height) { lens.classList.remove('is-on'); return }
          const L = lens.offsetWidth
          lens.style.backgroundImage = `url("${zoomSrc()}")`
          lens.style.backgroundSize = `${r.width * ZOOM}px ${r.height * ZOOM}px`
          lens.style.backgroundPosition = `${-(x * ZOOM - L / 2)}px ${-(y * ZOOM - L / 2)}px`
          lens.style.left = `${x - L / 2}px`
          lens.style.top = `${y - L / 2}px`
          lens.classList.add('is-on')
        }
        gmain.addEventListener('mousemove', move)
        gmain.addEventListener('mouseleave', () => lens.classList.remove('is-on'))
        // warm the hi-res image so the lens is sharp on first hover
        gmain.addEventListener('mouseenter', () => { const pre = new Image(); pre.src = zoomSrc() }, { once: true })
      }
      const openZoom = () => openLightbox(zoomSrc(), gmain.alt)
      gmain.addEventListener('click', openZoom)
      zoomFrame.querySelector('[data-zoom-open]')?.addEventListener('click', openZoom)
    }

    // "קרא עוד" folds (phones/tablets only). The text is never clamped by
    // default; we clamp — and only then show the fade + button — when the
    // paragraph is at least a full line taller than the clamp. A paragraph that
    // barely overflows is shown whole (a faded last line hiding half a line
    // just looks broken). Re-evaluated after web fonts load and on resize.
    // (the "קרא עוד" fold for [data-fold] blocks is handled site-wide in Base.astro)

    // Metric count-up
    document.querySelectorAll('.pm__value[data-count]').forEach((el) => {
      const final = (el.textContent || '').trim()
      if (/[:\/]/.test(final)) return
      const m = final.match(/^(\D*)(\d+(?:\.\d+)?)(.*)$/s)
      if (!m || reduce) return
      const pre = m[1], num = parseFloat(m[2]), dec = (m[2].split('.')[1] || '').length, suf = m[3]
      el.textContent = pre + (0).toFixed(dec) + suf
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) {
        const t = performance.now()
        const tick = (n: number) => { const k = Math.min((n - t) / 1100, 1); el.textContent = pre + (num * ease(k)).toFixed(dec) + suf; if (k < 1) requestAnimationFrame(tick) }
        requestAnimationFrame(tick); io.disconnect()
      } }), { threshold: 0.4 })
      io.observe(el)
    })

    // ORAC number count-up (hero counts slower for a "loading" feel; bars quicker)
    document.querySelectorAll('[data-orac-to]').forEach((el) => {
      const target = parseInt(el.getAttribute('data-orac-to') || '0', 10)
      if (reduce) return
      const hero = !!el.closest('.p-orac__huge')
      const dur = hero ? 2000 : 1300
      let done = false
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting && !done) {
        done = true; el.textContent = fmt(0)
        if (hero) el.classList.add('is-loading')
        const t = performance.now()
        const tick = (n: number) => { const k = Math.min((n - t) / dur, 1); el.textContent = fmt(Math.round(target * ease(k))); if (k < 1) requestAnimationFrame(tick); else if (hero) el.classList.remove('is-loading') }
        requestAnimationFrame(tick); io.disconnect()
      } }), { threshold: 0.5 })
      io.observe(el)
    })
  </script>
