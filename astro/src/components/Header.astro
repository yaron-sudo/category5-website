<script>
  const toggle = document.querySelector('[data-nav-toggle]') as HTMLButtonElement | null
  const drawer = document.querySelector('[data-mobile-nav]') as HTMLElement | null
  if (toggle && drawer) {
    let open = false
    const setOpen = (next: boolean) => {
      open = next
      toggle.setAttribute('aria-expanded', String(next))
      toggle.setAttribute('aria-label', next ? 'סגירת תפריט' : 'פתיחת תפריט')
      document.body.classList.toggle('ns-nav-open', next)
      if (next) {
        drawer.hidden = false
        requestAnimationFrame(() => drawer.classList.add('is-open'))
      } else {
        drawer.classList.remove('is-open')
        const done = () => { if (!open) drawer.hidden = true; drawer.removeEventListener('transitionend', done) }
        drawer.addEventListener('transitionend', done)
      }
