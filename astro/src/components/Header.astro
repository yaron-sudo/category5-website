    drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)))
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && open) setOpen(false) })
  }
  // Escape also dismisses an open (keyboard-focused) mega panel.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.activeElement?.closest('.ns-nav__item')) {
      ;(document.activeElement as HTMLElement).blur()
    }
  })

  // Desktop side-dock: past 240px of scroll the top bar hands over to the
  // right-edge rail; back under 90px it returns (hysteresis = no flicker).
  // Disabled on narrow viewports and while the mobile drawer is open.
  const rail = document.querySelector<HTMLElement>('[data-rail]')
