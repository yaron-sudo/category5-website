    toggle.addEventListener('click', () => setOpen(!open))
    // Collapsible groups (e.g. המוצרים): closed by default, one tap opens the sub-links.
    const groupToggles = [...drawer.querySelectorAll<HTMLButtonElement>('[data-mnav-toggle]')]
    const setGroup = (btn: HTMLButtonElement, expanded: boolean) => {
      btn.setAttribute('aria-expanded', String(expanded))
      const subs = document.getElementById(btn.getAttribute('aria-controls') || '')
