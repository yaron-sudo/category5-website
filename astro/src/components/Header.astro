    const wide = window.matchMedia('(min-width: 1024px)')
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let docked = false
    let queued = false
    let outTimer = 0
    const apply = (next: boolean) => {
      if (next === docked) return
