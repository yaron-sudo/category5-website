---
import { getSiteSettings, getCategories, getAllProductCards, urlFor } from '@/lib/sanity'
import MegaPanel from '@/components/MegaPanel.astro'
import DropPanel, { type DropRow } from '@/components/DropPanel.astro'

const [settings, categories, products] = await Promise.all([getSiteSettings(), getCategories(), getAllProductCards()])

// Desktop navigation: items with `mega` open a two-zone mega panel — the first
// child renders as a large featured card, the rest as link rows (optionally
// grouped under headings). Items without `mega` are plain links.
type MegaLink = { label: string; href: string; desc?: string; icon?: string; photo?: string; group?: string; img?: string }
type MegaNavItem = { label: string; href: string; icon?: string; mega?: MegaLink[]; kind?: 'products' | 'info' }

// "מוצרים": generated from the product families + products in the CMS, so a
// new product appears in the menu automatically. Featured card = all families.
const productsMega: MegaLink[] = [
  { label: 'כל משפחות המוצרים', href: '/#families', desc: 'ויטמינים ומינרלים, ויטמין C ליפוזומלי, חיסון, זיכרון, תנועה וצמחים', img: '/media/2022/10/Homepage1.webp' },
  ...categories.flatMap((c) =>
    products
      .filter((p) => p.category?.slug === c.slug)
      .map((p) => ({ group: c.title, label: p.name, href: `/products/${p.slug}`, img: p.image?.asset ? urlFor(p.image).width(120).url() : undefined })),
  ),
]
const ICON_BY_HREF: Record<string, string> = { '/faq': 'help', '/stores': 'pin', '/community': 'reel', '/contact': 'mail' }
const fallbackMegaNav: MegaNavItem[] = [
  { label: 'מוצרים', href: '/#families', icon: 'grid', kind: 'products', mega: productsMega },
  { label: 'תמיכה ומידע', href: '/faq', icon: 'help' },
  { label: 'רשימת חנויות', href: '/stores', icon: 'pin' },
  { label: 'קהילה', href: '/community', icon: 'reel' },
  { label: 'צור קשר', href: '/contact', icon: 'mail' },
]

// CMS nav (siteSettings.nav): the first item whose href points at the product
// families gets the generated products mega; other items keep their children.
const cmsNav = (settings?.nav ?? []).filter((i) => i.label && i.href && !i.href.startsWith('/category/'))
const megaNav: MegaNavItem[] = cmsNav.length
  ? cmsNav.map((i) => {
      if (i.href === '/#families') return { label: i.label!, href: i.href!, icon: 'grid', kind: 'products' as const, mega: productsMega }
      const kids = (i.children ?? []).filter((c) => c.label && c.href)
      return {
        label: i.label!,
        href: i.href!,
        icon: ICON_BY_HREF[i.href!] ?? 'leaf',
        ...(kids.length ? { mega: kids.map((c): MegaLink => ({ label: c.label!, href: c.href!, desc: c.description })) } : {}),
      }
    })
  : fallbackMegaNav

// Header CTA button — CMS-overridable, hardcoded values as fallback.
const cta = {
  label: settings?.headerCta?.label || 'היכן לקנות',
  href: settings?.headerCta?.href || '/stores',
}

// Social links — CMS-overridable, with the brand's live accounts as fallback
// (mirrors the footer so the two never drift apart).
const soc = settings?.socials
const social: Array<{ label: string; href: string }> =
  soc?.facebook || soc?.instagram || soc?.youtube
    ? [
        ...(soc?.facebook ? [{ label: 'Facebook', href: soc.facebook }] : []),
        ...(soc?.instagram ? [{ label: 'Instagram', href: soc.instagram }] : []),
        ...(soc?.youtube ? [{ label: 'YouTube', href: soc.youtube }] : []),
      ]
    : []
const SOCIAL_ICONS: Record<string, string> = {
  Facebook: '<path fill="currentColor" d="M14 9h3l.5-3H14V4.5c0-.9.3-1.5 1.6-1.5H17V.2C16.7.1 15.7 0 14.6 0 12.1 0 10.5 1.5 10.5 4.2V6H8v3h2.5v9H14z"/>',
  Instagram: '<path fill="none" stroke="currentColor" stroke-width="2" d="M3 7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/>',
  YouTube: '<path fill="currentColor" d="M23 12s0-3.3-.4-4.9a2.5 2.5 0 0 0-1.8-1.8C19.2 5 12 5 12 5s-7.2 0-8.8.4A2.5 2.5 0 0 0 1.4 7.2C1 8.7 1 12 1 12s0 3.3.4 4.9a2.5 2.5 0 0 0 1.8 1.8C4.8 19 12 19 12 19s7.2 0 8.8-.4a2.5 2.5 0 0 0 1.8-1.8C23 15.3 23 12 23 12m-13 3.2V8.8l5.5 3.2z"/>',
}

const thumb = (l: { img?: string }) => l.img
const featImg = (l: { img?: string }) => l.img

// Simple line icons (stroke = currentColor).
const ICONS: Record<string, string> = {
  drop: '<path d="M12 3c3 3.6 5.5 6.6 5.5 9.5a5.5 5.5 0 0 1-11 0C6.5 9.6 9 6.6 12 3z"/>',
  leaf: '<path d="M5 19c0-7 5-12 14-12 0 9-5 14-12 14M5 19c2-3.5 4.5-5.8 8-7.5"/>',
  grid: '<rect x="3.5" y="3.5" width="7" height="7" rx="1.4"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.4"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.4"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.4"/>',
  sparkle: '<path d="M12 3l1.7 4.8L18.5 9l-4.8 1.7L12 15l-1.7-4.3L5.5 9l4.8-1.2z"/>',
  help: '<circle cx="12" cy="12" r="9"/><path d="M9.6 9.3a2.5 2.5 0 0 1 4.7 1.2c0 1.7-2.3 2-2.3 3.5M12 17h.01"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>',
  book: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5V5.5M20 18v3H6.5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  reel: '<rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 9h18M8 4l3 5M13 4l3 5"/><path d="m10.5 12.5 4 2.3-4 2.3z" fill="currentColor" stroke="none"/>',
  go: '<path d="m14 7-5 5 5 5"/>',
  cart: '<path d="M4 5h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H7"/><circle cx="10.4" cy="19.6" r="1.3"/><circle cx="17.2" cy="19.6" r="1.3"/>',
}
const SHOP_URL = '/stores'

// "היכן לקנות": a small dropdown (mega look & feel) — in the top bar, the side
// rail and the mobile drawer. The products are sold in stores, not on this site.
const BUY_LABEL = cta.label
const buyMenu: DropRow[] = [
  { label: 'חנויות ונקודות מכירה', href: cta.href, desc: 'בתי טבע, סופר-פארם, ניצת הדובדבן ו-B&D — מפה וחיפוש לפי עיר', icon: 'pin' },
  { label: 'חנויות אינטרנט', href: '/stores?type=online', desc: 'הזמנה אונליין עם משלוח עד הבית', icon: 'cart' },
]

// Resolve a mega item into the shared panel's data: first child = featured card.
const panelProps = (item: MegaNavItem) => {
  const [first, ...rest] = item.mega ?? []
  const info = item.kind === 'info'
  return {
    feat: first ? { label: first.label, href: first.href, desc: first.desc, img: featImg(first) } : null,
    rows: rest.map((l) => ({ label: l.label, href: l.href, desc: l.desc, group: l.group, img: info ? undefined : thumb(l) })),
    shopUrl: SHOP_URL,
    wide: true,
    ...(info ? { featTag: 'מידע', featCta: 'למידע המלא', shop: false } : { featTag: 'קטגוריה 5', featCta: 'לכל המוצרים', cols: item.kind === 'products', shopLabel: 'היכן לקנות' }),
  }
}
---
<header class="ns-header">
  <div class="ns-container ns-header__inner">
    <a class="ns-header__logo c5-logo" href="/" aria-label="קטגוריה 5 תוספים אתיים — דף הבית">
      <img src="/brand/category5-wordmark.svg" alt="CATEGORY 5" width="168" height="20" />
      <span class="c5-logo__sub" dir="ltr">Ethical Supplements</span>
    </a>
    <nav class="ns-nav" aria-label="ניווט ראשי">
      {megaNav.map((item) => item.mega ? (
        <div class="ns-nav__item">
          <a class="ns-nav__top" href={item.href} aria-haspopup="true">
            {item.label}
            <svg class="ns-nav__chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </a>
          <div class="ns-mega">
            <MegaPanel {...panelProps(item)} />
          </div>
        </div>
      ) : (
        <a class="ns-nav__top" href={item.href}>{item.label}</a>
      ))}
    </nav>
    <div class="ns-header__end">
      {social.length > 0 && (
        <div class="ns-header__social" aria-label="רשתות חברתיות">
          {social.map((s) => (
            <a href={s.href} aria-label={s.label} rel="noopener noreferrer" target="_blank">
              <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" set:html={SOCIAL_ICONS[s.label]} />
            </a>
          ))}
        </div>
      )}
      <div class="ns-nav__item ns-nav__item--buy">
        <a class="ns-nav__top ns-nav__top--buy" href="/stores" aria-haspopup="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS.cart} />
          {BUY_LABEL}
          <svg class="ns-nav__chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </a>
        <div class="ns-mega ns-mega--drop">
          <DropPanel rows={buyMenu} />
        </div>
      </div>
    </div>
    <button class="ns-burger" data-nav-toggle type="button" aria-label="פתיחת תפריט" aria-expanded="false" aria-controls="mobile-nav">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<!-- Desktop side rail: when the page is scrolled the top bar slides away and this
     slim rail docks on the right edge (RTL start) so content gets the full screen;
     scrolling back to the top restores the bar. Hidden/inert until docked. -->
<aside class="ns-rail" data-rail aria-label="ניווט צף" aria-hidden="true">
  <a class="ns-rail__logo" href="/" aria-label="קטגוריה 5 תוספים אתיים — דף הבית" style="--i:0">
    <img src="/brand/category5-mark.svg" alt="CATEGORY 5" width="64" height="64" />
  </a>
  <nav class="ns-rail__nav" aria-label="ניווט ראשי (צף)">
    {megaNav.map((item, i) => (
      <div class="ns-rail__item" style={`--i:${i + 1}`}>
        <a class="ns-rail__link" href={item.href} aria-haspopup={item.mega ? 'true' : undefined} data-label={item.label}>
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[item.icon ?? 'leaf']} />
          <span>{item.label}</span>
          {item.mega && <svg class="ns-rail__chev" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>}
        </a>
        {item.mega && (
          <div class="ns-rail__fly">
            <MegaPanel {...panelProps(item)} />
          </div>
        )}
      </div>
    ))}
  </nav>
  {social.length > 0 && (
    <div class="ns-rail__social" aria-label="רשתות חברתיות" style={`--i:${megaNav.length + 1}`}>
      {social.map((s) => (
        <a href={s.href} aria-label={s.label} rel="noopener noreferrer" target="_blank">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={SOCIAL_ICONS[s.label]} />
        </a>
      ))}
    </div>
  )}
  <div class="ns-rail__item ns-rail__item--buy" style={`--i:${megaNav.length + 2}`}>
    <a class="ns-rail__link ns-rail__cta" href="/stores" aria-haspopup="true" data-label={BUY_LABEL}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS.cart} />
      <span>{BUY_LABEL}</span>
    </a>
    <div class="ns-rail__fly ns-rail__fly--drop">
      <DropPanel rows={buyMenu} />
    </div>
  </div>
  <button type="button" class="ns-rail__top" data-rail-top aria-label="חזרה לראש הדף" style={`--i:${megaNav.length + 3}`}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    <span>למעלה</span>
  </button>
</aside>

<!-- Mobile navigation drawer (animated). Kept OUTSIDE <header> because the header's
     backdrop-filter would otherwise trap this fixed overlay inside the header box. -->
<div class="ns-mnav" id="mobile-nav" data-mobile-nav hidden>
  <button type="button" class="ns-mnav__close" data-nav-close aria-label="סגירת התפריט וחזרה לדף">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    סגירה
  </button>
  <span class="ns-mnav__deco ns-mnav__deco--1" aria-hidden="true"></span>
  <span class="ns-mnav__deco ns-mnav__deco--2" aria-hidden="true"></span>
  <div class="ns-mnav__inner">
    <a class="ns-mnav__logo c5-logo" href="/" aria-label="קטגוריה 5 תוספים אתיים — דף הבית" style="--i:0">
      <img src="/brand/category5-wordmark.svg" alt="CATEGORY 5" width="200" height="24" />
      <span class="c5-logo__sub" dir="ltr">Ethical Supplements</span>
    </a>
    <nav class="ns-mnav__panel" aria-label="ניווט מובייל">
      {megaNav.map((item, i) => (
        <div class="ns-mnav__group" style={`--i:${i + 1}`}>
          {item.mega ? (
            <button type="button" class="ns-mnav__toggle" aria-expanded="false" aria-controls={`mnav-subs-${i}`} data-mnav-toggle>
              <svg class="ns-mnav__ic" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[item.icon ?? 'leaf']} />
              <span>{item.label}</span>
              <svg class="ns-mnav__chev" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          ) : (
            <a href={item.href}>
              <svg class="ns-mnav__ic" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[item.icon ?? 'leaf']} />
              <span>{item.label}</span>
            </a>
          )}
          {item.mega && (
            <div class="ns-mnav__subs" id={`mnav-subs-${i}`} hidden>
              {item.mega.map((sub, j) => (
                <>
                  {sub.group && sub.group !== item.mega![j - 1]?.group && <span class="ns-mnav__grp">{sub.group}</span>}
                  <a href={sub.href}><span class="ns-mnav__dot" aria-hidden="true"></span>{sub.label}</a>
                </>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>
    <nav class="ns-mnav__panel ns-mnav__panel--buy" aria-label={BUY_LABEL}>
      <div class="ns-mnav__group ns-mnav__group--buy" style={`--i:${megaNav.length + 1}`}>
        <button type="button" class="ns-mnav__toggle" aria-expanded="false" aria-controls="mnav-subs-buy" data-mnav-toggle>
          <svg class="ns-mnav__ic" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS.cart} />
          <span>{BUY_LABEL}</span>
          <svg class="ns-mnav__chev" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="ns-mnav__subs" id="mnav-subs-buy" hidden>
          {buyMenu.map((l) => (
            <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}><span class="ns-mnav__dot" aria-hidden="true"></span>{l.label}</a>
          ))}
        </div>
      </div>
    </nav>
    {social.length > 0 && (
      <div class="ns-mnav__social" style={`--i:${megaNav.length + 2}`} aria-label="רשתות חברתיות">
        {social.map((s) => (
          <a href={s.href} aria-label={s.label} rel="noopener noreferrer" target="_blank">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" set:html={SOCIAL_ICONS[s.label]} />
          </a>
        ))}
      </div>
    )}
  </div>
  <p class="ns-mnav__tag">פורצים גבולות בעולם תוספי התזונה</p>
</div>

<style>
  .c5-logo { display: inline-flex; flex-direction: column; align-items: center; gap: 3px; line-height: 1; }
  .c5-logo img { display: block; height: 19px; width: auto; }
  .c5-logo__sub { font-family: var(--ns-font-latin); font-size: 11.5px; letter-spacing: .2em; color: var(--ns-field-green); white-space: nowrap; }
  .ns-mnav .c5-logo img { height: 24px; }
  .ns-mnav .c5-logo__sub { font-size: 13px; }
  /* ---- Desktop nav + mega menu ---- */
  .ns-nav { display: flex; gap: 2px; align-items: center; }
  /* nav items are static so the mega dropdown positions against the header
     container (.ns-header__inner) — a wide panel then hugs the container's
     left edge instead of running off-screen from a right-hand item. */
  .ns-nav__item { position: static; }
  .ns-header__inner { position: relative; }
  .ns-nav__top { display: inline-flex; align-items: center; gap: 6px; color: var(--ns-field-green); font-size: clamp(18px, 1.35vw, 21px); font-weight: 500; padding: 10px 15px; border-radius: var(--ns-radius-md); transition: color .2s var(--ns-ease-out); }
  .ns-nav__top:hover, .ns-nav__item:hover .ns-nav__top, .ns-nav__item:focus-within .ns-nav__top { color: var(--ns-pure-orange); }
  .ns-nav__chev { opacity: .7; transition: transform .25s var(--ns-ease-out); }
  .ns-nav__item:hover .ns-nav__chev, .ns-nav__item:focus-within .ns-nav__chev { transform: rotate(180deg); }

  /* sliding underline (from the reading side) on desktop nav items */
  .ns-nav__top { position: relative; }
  .ns-nav__top::after { content: ""; position: absolute; inset-inline: 12px; inset-block-end: 4px; height: 2px; border-radius: 2px; background: var(--ns-pure-orange); transform: scaleX(0); transform-origin: 100% 50%; transition: transform var(--ns-dur-base) var(--ns-ease-smooth); }
  .ns-nav__top:hover::after, .ns-nav__item:focus-within .ns-nav__top::after { transform: scaleX(1); }

  /* invisible hover bridge so the pointer can travel into the panel */
  /* mega dropdown: soft entrance (drifts up, unblurs, slight overshoot) and a
     gentle exit (fades + settles down, slightly delayed so the panel doesn't
     vanish the instant the pointer crosses the gap). */
  .ns-mega { position: absolute; inset-block-start: 100%; inset-inline-end: 0; padding-block-start: 14px; opacity: 0; visibility: hidden; transform: translateY(18px) scale(.97); filter: blur(6px); transform-origin: top right; transition: opacity .22s var(--ns-ease-out) .06s, transform .28s var(--ns-ease-smooth) .06s, filter .22s var(--ns-ease-out) .06s, visibility 0s linear .3s; z-index: 60; }
  .ns-nav__item:hover .ns-mega, .ns-nav__item:focus-within .ns-mega { opacity: 1; visibility: visible; transform: none; filter: blur(0); transition: opacity .3s var(--ns-ease-out), transform .55s cubic-bezier(.2, 1.3, .35, 1), filter .35s var(--ns-ease-out), visibility 0s; }
  .ns-mega :global(.ns-mega__panel) { transform-origin: top right; }

  /* (panel contents + styles live in MegaPanel.astro — shared with the side rail) */

  /* right-side cluster: social icons + CTA */
  .ns-header__end { display: flex; align-items: center; gap: 14px; }
  .ns-header__social { display: flex; align-items: center; gap: 4px; }
  .ns-header__social a { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 999px; color: var(--ns-field-green); transition: color .2s var(--ns-ease-out), background .2s var(--ns-ease-out), transform .2s var(--ns-ease-out); }
  .ns-header__social a:hover { color: var(--ns-pure-orange); background: color-mix(in srgb, var(--ns-pure-orange) 10%, transparent); transform: translateY(-2px); }
  /* buy dropdown item: orange pill in the old button's place; its small panel
     hangs under the item itself (not the container-wide mega position) */
  .ns-nav__item--buy { position: relative; }
  .ns-nav__top--buy { gap: 8px; padding: 10px 18px; border-radius: 999px; background: var(--ns-pure-orange); color: var(--ns-sun-beige); font-weight: 600; font-size: clamp(16px, 1.15vw, 18px); box-shadow: 0 12px 26px -12px rgba(232,114,0,.7); transition: background .2s var(--ns-ease-out), transform .2s var(--ns-ease-out), box-shadow .2s var(--ns-ease-out); }
  .ns-nav__top--buy::after { display: none; }
