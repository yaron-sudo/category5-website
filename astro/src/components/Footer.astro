---
import { getSiteSettings } from '@/lib/sanity'
const settings = await getSiteSettings()

// Every public route, grouped: the site, the professional-information pages
// (incl. the articles and studies), and the product pages.
const importantLinks = [
  { label: 'דף הבית', href: '/' },
  { label: 'מידע על המרווה', href: '/product' },
  { label: 'הסיפור שלנו', href: '/#story' },
  { label: 'רשימת חנויות', href: '/stores' },
  { label: 'שאלות ותשובות', href: '/faq' },
  { label: 'קהילה — אינסטגרם', href: '/community' },
  { label: 'צור קשר', href: '/contact' },
]
const infoLinks = [
  { label: 'פורטל המידע המקצועי', href: '/experts' },
  { label: 'השוואה לשמן דגים', href: '/compare' },
  { label: 'כמה EPA ו-DHA יש בשמן?', href: '/omega-3-conversion' },
  { label: 'אומגה 3 אינדקס', href: '/omega-3-index' },
  { label: 'תהליכי הייצור', href: '/production' },
  { label: 'מערכת החיסון', href: '/articles/immune-system' },
  { label: 'קשב וריכוז', href: '/articles/focus-concentration' },
  { label: 'אומגה 3 וקצב הלב', href: '/articles/omega-3-heart-rate' },
  { label: 'מחקר: שומנים בדם', href: '/research/blood-lipids' },
  { label: 'מחקר: דלקת מעיים', href: '/research/crohns-colitis' },
]
const productLinks = [
  { label: 'מרווה מרושתת אומגה 3', href: '/product' },
  { label: 'PURE — כמוסות טבעוניות', href: '/products/pure-capsules' },
  { label: 'PURE — שמן בבקבוק', href: '/products/pure-oil' },
  { label: 'ויטמין D3 טבעוני — ספריי', href: '/products/vitamin-d' },
  { label: 'פורטי פיור — ספריי פורטיום', href: '/products/forti-pure' },
]
const contact = {
  address: settings?.contact?.address || 'רחוב משה לוי 1, ראשון לציון, ישראל',
  email: settings?.contact?.email || 'info-israel@nature-sage.com',
  phone: settings?.contact?.phone,
  hours: settings?.contact?.hours || 'א׳–ה׳ 09:00–17:00',
}
// CMS footer columns replace the two hardcoded link columns when non-empty.
const cmsColumns = (settings?.footerColumns ?? [])
  .map((c) => ({ title: c.title ?? '', links: (c.links ?? []).filter((l) => l.label && l.href) }))
  .filter((c) => c.title && c.links.length)
const columns = cmsColumns.length
  ? cmsColumns
  : [
      { title: 'האתר', links: importantLinks },
      { title: 'מידע מקצועי', links: infoLinks },
      { title: 'המוצרים', links: productLinks },
    ]

// Social icons: render only URLs present in the CMS; when the whole object is empty,
// fall back to the hardcoded profiles.
const s = settings?.socials
const social: Array<{ label: string; href: string }> =
  s?.facebook || s?.instagram || s?.youtube
    ? [
        ...(s?.facebook ? [{ label: 'Facebook', href: s.facebook }] : []),
        ...(s?.instagram ? [{ label: 'Instagram', href: s.instagram }] : []),
        ...(s?.youtube ? [{ label: 'YouTube', href: s.youtube }] : []),
      ]
    : [
        { label: 'Facebook', href: 'https://www.facebook.com/naturesageomega3' },
        { label: 'Instagram', href: 'https://www.instagram.com/naturesageil/' },
        { label: 'YouTube', href: 'https://www.youtube.com/channel/UCCBDkYQ7Gl9UeTktQ77vy_A' },
      ]
const tagline = settings?.tagline || 'Where good gets better.'
const disclaimer =
  settings?.footerDisclaimer ||
  'כל המידע הנמצא באתר ניתן למטרות חינוכיות בלבד, אינו מהווה תחליף לייעוץ, טיפול, אבחון והשגחה של רופא מוסמך, ואינו ערוך או מעוצב כדי לקדם או לפרסם שיטות ריפוי או מוצרים מסוימים. אין להשתמש בתוכן האתר למטרות אבחון או טיפול של בעיות בריאות או מחלות. יש לקרוא בזהירות את המידע המסופק על המוצרים המפורסמים או מקודמים באתר. אם יש חשש לבעיה רפואית כלשהי, יש לפנות מיד לרופא המטפל ולפעול לפי הנחיותיו, ולא להסתמך בצורה כלשהי על תכני האתר או המוצרים המופיעים בו כתחליף לטיפול על ידי רופא מוסמך.'
const year = new Date().getFullYear()
---
<footer class="ns-footer">
  <div class="ns-container ns-footer__grid">
    <div class="ns-footer__brand">
      <img src="/brand/logo-wordmark-cream.svg" alt="NATURESAGE" width="190" height="21" />
      <p class="ns-footer__tagline" dir="ltr">{tagline}</p>
      <div class="ns-footer__social" aria-label="רשתות חברתיות">
        {social.map((s) => (
          <a href={s.href} aria-label={s.label} rel="noopener noreferrer" target="_blank">
            {s.label === 'Facebook' && <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M14 9h3l.5-3H14V4.5c0-.9.3-1.5 1.6-1.5H17V.2C16.7.1 15.7 0 14.6 0 12.1 0 10.5 1.5 10.5 4.2V6H8v3h2.5v9H14z"/></svg>}
            {s.label === 'Instagram' && <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M3 7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>}
            {s.label === 'YouTube' && <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M23 12s0-3.3-.4-4.9a2.5 2.5 0 0 0-1.8-1.8C19.2 5 12 5 12 5s-7.2 0-8.8.4A2.5 2.5 0 0 0 1.4 7.2C1 8.7 1 12 1 12s0 3.3.4 4.9a2.5 2.5 0 0 0 1.8 1.8C4.8 19 12 19 12 19s7.2 0 8.8-.4a2.5 2.5 0 0 0 1.8-1.8C23 15.3 23 12 23 12m-13 3.2V8.8l5.5 3.2z"/></svg>}
          </a>
        ))}
      </div>
    </div>

    {columns.map((col) => (
      <nav class="ns-footer__col" aria-label={col.title}>
        <h2 class="ns-footer__h">{col.title}</h2>
        <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    ))}

    <div class="ns-footer__col">
      <h2 class="ns-footer__h">צור קשר</h2>
      <address class="ns-footer__contact">
        <p>{contact.address}</p>
        <p><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
        {contact.phone && <p><a href={`tel:${contact.phone}`} dir="ltr">{contact.phone}</a></p>}
        <p>שעות פעילות: {contact.hours}</p>
      </address>
    </div>
  </div>

  <div class="ns-container">
    <p class="ns-footer__disclaimer">{disclaimer}</p>
  </div>

  <div class="ns-footer__bar">
    <div class="ns-container ns-footer__bar-inner">
      <span>© {year} Nature's Sage · נייטשרסייג׳ — כל הזכויות שמורות.</span>
      <span class="ns-footer__bar-links">
        <a href="/terms">תנאי שימוש</a>
        <a href="/privacy">מדיניות פרטיות</a>
        <a href="/cookies">מדיניות קוקיות</a>
        <a href="/accessibility">הצהרת נגישות</a>
        <a href="#" data-cookie-settings>הגדרות עוגיות</a>
      </span>
    </div>
  </div>
</footer>
