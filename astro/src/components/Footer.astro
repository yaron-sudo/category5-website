---
import { getSiteSettings } from '@/lib/sanity'
import { DISCLAIMER } from '@/lib/brand'
const settings = await getSiteSettings()

import { getCategories } from '@/lib/sanity'
const categories = await getCategories()
const siteLinks = [
  { label: 'דף הבית', href: '/' },
  { label: 'תמיכה ומידע', href: '/faq' },
  { label: 'רשימת חנויות', href: '/stores' },
  { label: 'קהילה', href: '/community' },
  { label: 'צור קשר', href: '/contact' },
  { label: 'חוברת מוצרים', href: '/catalog' },
]
const contact = {
  address: settings?.contact?.address,
  email: settings?.contact?.email || 'info@ethical-supplements.com',
  phone: settings?.contact?.phone || '053-9325888',
  whatsapp: settings?.contact?.whatsapp || '972539325888',
  hours: settings?.contact?.hours,
}
// CMS footer columns replace the two hardcoded link columns when non-empty.
const cmsColumns = (settings?.footerColumns ?? [])
  .map((c) => ({ title: c.title ?? '', links: (c.links ?? []).filter((l) => l.label && l.href) }))
  .filter((c) => c.title && c.links.length)
const columns = cmsColumns.length
  ? cmsColumns
  : [
      { title: 'משפחות מוצרים', links: categories.map((c) => ({ label: c.title, href: `/category/${c.slug}` })) },
      { title: 'קישורים', links: siteLinks },
    ]

// Social icons: render only URLs present in the CMS; when the whole object is empty,
// fall back to the hardcoded profiles.
const s = settings?.socials
const social: Array<{ label: string; href: string }> =
  s?.facebook || s?.instagram || s?.youtube
    ? [
        ...(s?.facebook ? [{ label: 'Facebook', href: s.facebook }] : []),
        ...(s?.instagram ? [{ label: 'Instagram', href: s.instagram }] : []),
        ...(s?.youtube ? [{ label: 'YouTube', href: s.youtube }] : []),
      ]
    : []
const tagline = settings?.tagline || 'פורצים גבולות בעולם תוספי התזונה'
const disclaimer = settings?.footerDisclaimer || DISCLAIMER
const year = new Date().getFullYear()
---
<footer class="ns-footer">
  <div class="ns-container ns-footer__grid">
    <div class="ns-footer__brand">
      <img class="ns-footer__logo" src="/brand/category5-mark-white.svg" alt="CATEGORY 5 Ethical Supplements" width="120" height="120" />
      <p class="ns-footer__tagline">{tagline}</p>
      <div class="ns-footer__social" aria-label="רשתות חברתיות">
        {social.map((s) => (
          <a href={s.href} aria-label={s.label} rel="noopener noreferrer" target="_blank">
            {s.label === 'Facebook' && <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M14 9h3l.5-3H14V4.5c0-.9.3-1.5 1.6-1.5H17V.2C16.7.1 15.7 0 14.6 0 12.1 0 10.5 1.5 10.5 4.2V6H8v3h2.5v9H14z"/></svg>}
            {s.label === 'Instagram' && <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M3 7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>}
            {s.label === 'YouTube' && <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M23 12s0-3.3-.4-4.9a2.5 2.5 0 0 0-1.8-1.8C19.2 5 12 5 12 5s-7.2 0-8.8.4A2.5 2.5 0 0 0 1.4 7.2C1 8.7 1 12 1 12s0 3.3.4 4.9a2.5 2.5 0 0 0 1.8 1.8C4.8 19 12 19 12 19s7.2 0 8.8-.4a2.5 2.5 0 0 0 1.8-1.8C23 15.3 23 12 23 12m-13 3.2V8.8l5.5 3.2z"/></svg>}
          </a>
        ))}
      </div>
    </div>

    {columns.map((col) => (
      <nav class="ns-footer__col" aria-label={col.title}>
        <h2 class="ns-footer__h">{col.title}</h2>
        <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    ))}

    <div class="ns-footer__col">
      <h2 class="ns-footer__h">צור קשר</h2>
      <address class="ns-footer__contact">
        {contact.address && <p>{contact.address}</p>}
        <p><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
        <p>ווטסאפ (הודעות בלבד): <a href={`https://wa.me/${contact.whatsapp}`} dir="ltr" rel="noopener" target="_blank">{contact.phone}</a></p>
        {contact.hours && <p>{contact.hours}</p>}
        <p><a href="/contact">לטופס יצירת קשר ←</a></p>
      </address>
    </div>
  </div>

  <div class="ns-container">
    <p class="ns-footer__disclaimer">{disclaimer}</p>
  </div>

  <div class="ns-footer__bar">
    <div class="ns-container ns-footer__bar-inner">
      <span>© {year} קטגוריה 5 תוספים אתיים · Category 5 Ethical Supplements — כל הזכויות שמורות.</span>
      <span class="ns-footer__bar-links">
        <a href="/terms">תנאי שימוש</a>
        <a href="/privacy">מדיניות פרטיות</a>
        <a href="/cookies">מדיניות קוקיות</a>
        <a href="/accessibility">הצהרת נגישות</a>
        <a href="#" data-cookie-settings>הגדרות עוגיות</a>
      </span>
    </div>
  </div>
</footer>
