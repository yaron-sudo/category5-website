---
import { videoEmbed } from '@/lib/sanity'
interface Props {
  url: string
  name?: string
  poster?: string
}
const { url, name, poster: posterProp } = Astro.props
const v = videoEmbed(url)
// Poster priority: an explicit CMS image, then the video platform's own
// thumbnail (YouTube / Vimeo via vumbnail), else a brand-gradient fallback.
const poster =
  posterProp ||
  (v?.ytId ? `https://i.ytimg.com/vi/${v.ytId}/hqdefault.jpg` : null) ||
  (v?.vmId ? `https://vumbnail.com/${v.vmId}.jpg` : null)
---
{v && (
  <div class="tvid" data-tvid data-embed={v.embed}>
    {poster
      ? <img class="tvid__poster" src={poster} alt="" loading="lazy" />
      : <div class="tvid__poster tvid__poster--brand"></div>}
    <div class="tvid__veil"></div>
    <button class="tvid__play" data-tvid-play type="button" aria-label={`נגן וידאו${name ? ' — ' + name : ''}`}>
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
    </button>
  </div>
)}

<style>
  .tvid { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: var(--ns-radius-lg); overflow: hidden; margin-block-end: 22px; background: var(--ns-green-950); cursor: pointer; box-shadow: var(--ns-shadow-sm); }
  .tvid__poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .tvid__poster--brand { background: linear-gradient(135deg, var(--ns-green-800), var(--ns-green-950)); }
  .tvid__veil { position: absolute; inset: 0; background: rgba(17,48,33,.34); transition: background var(--ns-dur-base) var(--ns-ease-out); }
  .tvid:hover .tvid__veil { background: rgba(17,48,33,.20); }
  .tvid__play { position: absolute; inset: 0; margin: auto; width: 60px; height: 60px; border: none; cursor: pointer; border-radius: 999px; background: var(--ns-pure-orange); color: var(--ns-sun-beige); display: grid; place-items: center; box-shadow: var(--ns-shadow-md); transition: transform var(--ns-dur-base) var(--ns-ease-out); }
  .tvid__play svg { margin-inline-start: 3px; }
  .tvid:hover .tvid__play { transform: scale(1.08); }
</style>

<script>
  document.querySelectorAll('[data-tvid]').forEach((el) => {
    el.querySelector('[data-tvid-play]')?.addEventListener('click', () => {
      const src = el.getAttribute('data-embed')
      if (!src) return
      const f = document.createElement('iframe')
      // Inline styles: scoped component CSS doesn't reach JS-created elements.
      f.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;'
      f.src = src
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen'
      f.allowFullscreen = true
      f.title = (el.querySelector('[data-tvid-play]') as HTMLElement)?.getAttribute('aria-label') || 'video'
      el.innerHTML = ''
      el.appendChild(f)
    })
  })
</script>
