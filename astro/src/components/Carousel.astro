---
export interface Slide {
  imageUrl?: string
  eyebrow?: string
  title?: string
  text?: string
  ctaLabel?: string
  ctaHref?: string
}
interface Props {
  slides: Slide[]
}
const { slides } = Astro.props
---
<div class="car" data-carousel>
  <div class="car__viewport">
    {slides.map((s, i) => (
      <div class={`car__slide${i === 0 ? ' is-active' : ''}`} data-index={i} aria-hidden={i === 0 ? 'false' : 'true'}>
        <div class="ns-container car__grid">
          <div class="car__text">
            {s.eyebrow && <span class="ns-eyebrow">{s.eyebrow}</span>}
            {s.title && <h1 class="car__title">{s.title}</h1>}
            {s.text && <p class="car__lede">{s.text}</p>}
            {s.ctaLabel && <a class="ns-btn ns-btn--primary" href={s.ctaHref || '/product'}>{s.ctaLabel}</a>}
          </div>
          {s.imageUrl && (
            <div class="car__media"><img src={s.imageUrl} alt={s.title || ''} loading={i === 0 ? 'eager' : 'lazy'} /></div>
          )}
        </div>
      </div>
    ))}
  </div>

  {slides.length > 1 && (
    <div class="ns-container car__controls">
      <button class="car__arrow" data-car-prev aria-label="הקודם">‹</button>
      <div class="car__dots" role="tablist">
        {slides.map((_, i) => (
          <button class={`car__dot${i === 0 ? ' is-active' : ''}`} data-car-dot={i} aria-label={`שקופית ${i + 1}`}></button>
        ))}
      </div>
      <button class="car__arrow" data-car-next aria-label="הבא">›</button>
    </div>
  )}
</div>

<style>
  .car { position: relative; background: linear-gradient(180deg, var(--ns-beige-50), var(--ns-sun-beige) 62%); padding-block: var(--ns-space-10) var(--ns-space-7); overflow: hidden; }
  .car__viewport { display: grid; }
  /* gentle cross-dissolve between slides (both visible during the fade) */
  .car__slide { grid-area: 1 / 1; opacity: 0; visibility: hidden; transition: opacity .85s var(--ns-ease-out), visibility 0s linear .85s; }
  .car__slide.is-active { opacity: 1; visibility: visible; transition: opacity .85s var(--ns-ease-out), visibility 0s; }
  /* media column is the dominant one so the hero image reads ~50%+ larger (area) */
  .car__grid { display: grid; grid-template-columns: 0.82fr 1.55fr; gap: var(--ns-space-7); align-items: center; }
  .car__title { font-family: var(--ns-font-display); font-weight: 700; font-size: clamp(34px, 4.4vw, 62px); line-height: 1.08; letter-spacing: -0.02em; text-wrap: balance; color: var(--ns-field-green); margin-block: 14px 18px; }
  .car__lede { font-family: var(--ns-font-display); font-weight: 500; font-size: clamp(18px, 1.6vw, 24px); line-height: 1.65; color: var(--ns-fg); max-width: 46ch; margin-block-end: 30px; }
  .car__text .ns-btn { padding: 16px 40px; font-size: var(--ns-text-md); }
  .car__media { position: relative; }
  .car__media::before { content: ""; position: absolute; inset: -10% -8%; z-index: 0; background: radial-gradient(58% 58% at 68% 32%, color-mix(in srgb, var(--ns-pure-orange) 24%, transparent), transparent 70%); filter: blur(34px); pointer-events: none; }
  .car__media img { position: relative; z-index: 1; width: 100%; border-radius: var(--ns-radius-xl); display: block; box-shadow: var(--ns-shadow-lg); }
  @media (max-width: 900px) { .car__grid { grid-template-columns: 1fr; } .car__media { order: -1; } .car__title { font-size: clamp(36px, 9vw, 52px); } }

  /* Bolder entrance: staggered reveal of the active slide */
  @media (prefers-reduced-motion: no-preference) {
    .car__slide.is-active .car__text > * { animation: heroIn .7s var(--ns-ease-out) both; }
    .car__slide.is-active .car__text > :nth-child(1) { animation-delay: .06s; }
    .car__slide.is-active .car__text > :nth-child(2) { animation-delay: .16s; }
    .car__slide.is-active .car__text > :nth-child(3) { animation-delay: .26s; }
    .car__slide.is-active .car__text > :nth-child(4) { animation-delay: .36s; }
    .car__slide.is-active .car__media { animation: heroMedia 1s var(--ns-ease-out) both .1s; }
    /* slow, living "ken burns" zoom on the active image for a premium feel */
    .car__slide.is-active .car__media img { animation: kenBurns 9s var(--ns-ease-out) .2s both; }
  }
  @keyframes heroIn { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes heroMedia { from { opacity: 0; transform: translateY(16px) scale(.96); } to { opacity: 1; transform: none; } }
  @keyframes kenBurns { from { transform: scale(1); } to { transform: scale(1.06); } }

  .car__controls { display: flex; align-items: center; justify-content: center; gap: 20px; margin-block-start: var(--ns-space-7); }
  .car__arrow { width: 44px; height: 44px; border-radius: 999px; border: 1px solid var(--ns-border); background: var(--ns-bg-alt); color: var(--ns-field-green); font-size: 22px; line-height: 1; cursor: pointer; transition: all var(--ns-dur-fast) var(--ns-ease-out); }
  .car__arrow:hover { background: var(--ns-field-green); color: var(--ns-sun-beige); }
  .car__dots { display: flex; gap: 10px; }
  .car__dot { width: 10px; height: 10px; border-radius: 999px; border: none; background: var(--ns-border-strong); cursor: pointer; padding: 0; transition: all var(--ns-dur-base) var(--ns-ease-out); }
  .car__dot.is-active { background: var(--ns-pure-orange); width: 28px; }
</style>

<script>
  document.querySelectorAll('[data-carousel]').forEach((root) => {
    const slides = [...root.querySelectorAll('.car__slide')]
    const dots = [...root.querySelectorAll('[data-car-dot]')]
    if (slides.length < 2) return
    let i = 0
    let timer: number | undefined
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const show = (n: number) => {
      i = (n + slides.length) % slides.length
      slides.forEach((s, k) => {
        s.classList.toggle('is-active', k === i)
        s.setAttribute('aria-hidden', k === i ? 'false' : 'true')
      })
      dots.forEach((d, k) => d.classList.toggle('is-active', k === i))
    }
    const next = () => show(i + 1)
    const prev = () => show(i - 1)
    const start = () => { if (!reduce) timer = window.setInterval(next, 6000) }
    const stop = () => { if (timer) window.clearInterval(timer) }
    root.querySelector('[data-car-next]')?.addEventListener('click', () => { next(); stop(); start() })
    root.querySelector('[data-car-prev]')?.addEventListener('click', () => { prev(); stop(); start() })
    dots.forEach((d, k) => d.addEventListener('click', () => { show(k); stop(); start() }))
    root.addEventListener('mouseenter', stop)
    root.addEventListener('mouseleave', start)
    start()
  })
</script>
