---
// Small dropdown panel (same look & feel as the mega panel, single column, no
// featured card): used for the "רכישת מוצרים" menu in the top bar and the rail.
export interface DropRow { label: string; href: string; desc?: string; icon?: string; external?: boolean }
interface Props { rows: DropRow[] }
const { rows } = Astro.props
const GO = '<path d="m14 7-5 5 5 5"/>'
const ICONS: Record<string, string> = {
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>',
  cart: '<path d="M4 5h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H7"/><circle cx="10.4" cy="19.6" r="1.3"/><circle cx="17.2" cy="19.6" r="1.3"/>',
  leaf: '<path d="M5 19c0-7 5-12 14-12 0 9-5 14-12 14M5 19c2-3.5 4.5-5.8 8-7.5"/>',
}
---
<div class="ns-drop">
  <span class="ns-drop__glow" aria-hidden="true"></span>
  {rows.map((l, i) => (
    <a class="ns-drop__row" href={l.href} style={`--i:${i}`} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>
      <span class="ns-drop__fig">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[l.icon ?? 'leaf']} />
      </span>
      <span class="ns-drop__text"><b>{l.label}</b>{l.desc && <em>{l.desc}</em>}</span>
      <span class="ns-drop__go" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={GO} />
      </span>
    </a>
  ))}
</div>

<style>
  .ns-drop { position: relative; display: flex; flex-direction: column; gap: 4px; width: min(380px, 94vw); padding: 12px; background: var(--ns-bg-alt); border: 1px solid var(--ns-border); border-radius: 22px; box-shadow: 0 30px 70px -28px rgba(17,48,33,.45), var(--ns-shadow-lg); overflow: hidden; }
  .ns-drop__glow { position: absolute; inset-block-start: -60%; inset-inline-end: -30%; width: 80%; aspect-ratio: 1; pointer-events: none; background: radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--ns-pure-orange) 18%, transparent), transparent 65%); }
  .ns-drop__row { position: relative; display: flex; align-items: center; gap: 14px; padding: 12px 12px; border-radius: 16px; transition: background .2s var(--ns-ease-out); opacity: 0; transform: translateY(10px); }
  :global(.ns-nav__item:hover) .ns-drop__row, :global(.ns-nav__item:focus-within) .ns-drop__row,
  :global(.ns-rail__item:hover) .ns-drop__row, :global(.ns-rail__item:focus-within) .ns-drop__row { opacity: 1; transform: none; transition: background .2s var(--ns-ease-out), opacity .3s var(--ns-ease-smooth) calc(var(--i, 0) * 60ms + 80ms), transform .3s var(--ns-ease-smooth) calc(var(--i, 0) * 60ms + 80ms); }
  .ns-drop__row:hover, .ns-drop__row:focus-visible { background: color-mix(in srgb, var(--ns-pure-orange) 9%, var(--ns-sun-beige)); }
  .ns-drop__fig { flex: none; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; color: var(--ns-pure-orange); background: color-mix(in srgb, var(--ns-pure-orange) 10%, transparent); box-shadow: 0 0 0 1.5px color-mix(in srgb, var(--ns-pure-orange) 22%, transparent) inset; transition: transform .3s var(--ns-ease-out), background .3s var(--ns-ease-out), color .3s var(--ns-ease-out); }
  .ns-drop__row:hover .ns-drop__fig { transform: scale(1.06); background: var(--ns-pure-orange); color: var(--ns-sun-beige); }
  .ns-drop__text { flex: 1; min-width: 0; text-align: start; }
  .ns-drop__text b { display: block; font-family: var(--ns-font-display); font-weight: 500; font-size: 16.5px; color: var(--ns-field-green); line-height: 1.25; }
  .ns-drop__text em { display: block; font-style: normal; font-size: 13px; color: var(--ns-light-gray); margin-block-start: 3px; }
  .ns-drop__go { flex: none; width: 28px; height: 28px; border-radius: 999px; display: grid; place-items: center; background: var(--ns-sun-beige); color: var(--ns-field-green); opacity: 0; transform: translateX(6px); transition: opacity .22s var(--ns-ease-out), transform .22s var(--ns-ease-out), background .2s, color .2s; }
  .ns-drop__row:hover .ns-drop__go, .ns-drop__row:focus-visible .ns-drop__go { opacity: 1; transform: none; background: var(--ns-pure-orange); color: var(--ns-sun-beige); }
  @media (prefers-reduced-motion: reduce) { .ns-drop__row, .ns-drop__fig, .ns-drop__go { transition: none !important; } }
</style>
