---
import { RANGES } from '@/admin/stats'
interface Props { days: number; base: string }
const { days, base } = Astro.props
---
<nav class="ad-range" aria-label="טווח זמן">
  {RANGES.map((r) => <a href={`${base}?d=${r}`} aria-current={r === days ? 'true' : undefined}>{r === 1 ? 'היום' : `${r} ימים`}</a>)}
</nav>
