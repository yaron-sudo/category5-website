---
// Ranked list with a thin horizontal bar per row. Every list shows the same number of rows (`limit`,
// default 6) so cards line up; the rest sit in an accordion ("show N more"). All numbers are real
// text, so nothing depends on colour.
import BarRow from './BarRow.astro'
interface Row { label: string; n: number; prev?: number; href?: string }
interface Props { rows: Row[]; ltr?: boolean; empty?: string; showShare?: boolean; color?: 'green' | 'gold' | 'blue' | 'plum'; limit?: number }
const { rows, ltr = false, empty = 'אין נתונים בטווח.', showShare = true, color = 'green', limit = 6 } = Astro.props
const total = rows.reduce((a, r) => a + r.n, 0) || 1
const max = Math.max(1, ...rows.map((r) => r.n))
const head = rows.slice(0, limit), rest = rows.slice(limit)
---
{rows.length === 0 ? <p class="ad-empty">{empty}</p> : (
  <div class={`bl-wrap bl-${color}`}>
    <ul class="bl">
      {head.map((r) => <BarRow {...r} max={max} total={total} ltr={ltr} showShare={showShare} />)}
    </ul>
    {rest.length > 0 && (
      <details class="bl-more">
        <summary>הצג עוד {rest.length}</summary>
        <ul class="bl">
          {rest.map((r) => <BarRow {...r} max={max} total={total} ltr={ltr} showShare={showShare} />)}
        </ul>
      </details>
    )}
  </div>
)}
