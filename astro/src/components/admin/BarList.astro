---
// Ranked list with a thin horizontal bar per row: label, share bar, count, share %, and (optional)
// the change against the previous period. All numbers are real text, so nothing depends on colour.
interface Row { label: string; n: number; prev?: number; href?: string }
interface Props { rows: Row[]; ltr?: boolean; empty?: string; showShare?: boolean; color?: 'green' | 'gold' | 'blue' | 'plum' }
const { rows, ltr = false, empty = 'אין נתונים בטווח.', showShare = true, color = 'green' } = Astro.props
const total = rows.reduce((a, r) => a + r.n, 0) || 1
const max = Math.max(1, ...rows.map((r) => r.n))
const nf = (n: number) => n.toLocaleString('he-IL')
const chip = (a: number, b: number | undefined) => {
  if (b === undefined) return ''
  if (b === 0) return a > 0 ? 'חדש' : ''
  const p = Math.round(((a - b) / b) * 100)
  return p === 0 ? '0%' : `${p > 0 ? '▲' : '▼'} ${Math.abs(p)}%`
}
---
{rows.length === 0 ? <p class="ad-empty">{empty}</p> : (
  <ul class={`bl bl-${color}`}>
    {rows.map((r) => (
      <li class="bl-row">
        <span class={ltr ? 'bl-label ltr' : 'bl-label'}>{r.href ? <a href={r.href}>{r.label}</a> : r.label}</span>
        <span class="bl-track" aria-hidden="true"><span class="bl-bar" style={`width:${Math.max(2, Math.round((r.n / max) * 100))}%`}></span></span>
        <span class="bl-n">{nf(r.n)}</span>
        {showShare && <span class="bl-pct">{Math.round((r.n / total) * 100)}%</span>}
        {r.prev !== undefined && <span class="bl-delta" title="לעומת התקופה הקודמת">{chip(r.n, r.prev)}</span>}
      </li>
    ))}
  </ul>
)}
