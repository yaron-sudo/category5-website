---
// Category 5 site layout (BRIEF.md): Header + <main> + Footer + Floating, the
// mockups' shared CSS (site.css verbatim) and motion script (site.js verbatim).
import Seo from '@/components/Seo.astro'
import Header from '@/components/c5/Header.astro'
import Footer from '@/components/c5/Footer.astro'
import Floating from '@/components/c5/Floating.astro'
import { DEFAULT_LANG, DIR, type Lang } from '@/c5/i18n'
import '@/styles/c5-base.css'
import '@/styles/c5-site.css'

interface Props {
  title: string
  description?: string
  image?: string
  lang?: Lang
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}
const { title, description, image = '/assets/banners/home-banner-1.jpg', lang = DEFAULT_LANG, jsonLd } = Astro.props
const fullTitle = title.includes('Category 5') ? title : `${title} | Category 5`
---
<!doctype html>
<html lang={lang} dir={DIR[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo/category5-logo.svg" />
    <link rel="preload" href="/assets/fonts/NotoSansHebrew-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <Seo title={fullTitle} description={description} image={image} jsonLd={jsonLd} />
  </head>
  <body class="c5-site">
    <div class="ns-page">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <Floating />
    <script is:inline src="/c5/site.js"></script>
    <script is:inline>
      // Deterrent against casual image copying (client request): no right-click menu or
      // drag on images. Text stays selectable (accessibility / IS 5568).
      document.addEventListener('contextmenu', (e) => { if (e.target && e.target.tagName === 'IMG') e.preventDefault() })
      document.addEventListener('dragstart', (e) => { if (e.target && e.target.tagName === 'IMG') e.preventDefault() })
    </script>
    <script>
      // Contact + newsletter forms → POST /api/contact (the site's mailer).
      document.querySelectorAll<HTMLFormElement>('form[data-c5-form]').forEach((form) => {
        const started = Date.now()
        const status = form.querySelector<HTMLElement>('[data-c5-form-status]')
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')
        form.addEventListener('submit', async (e) => {
          e.preventDefault()
          if (!form.reportValidity()) return
          const data = Object.fromEntries(new FormData(form).entries())
          // Contact page extras (topic / product) travel inside the message.
          const extra = [data.topic && `נושא הפנייה: ${data.topic}`, data.product && `מוצר: ${data.product}`].filter(Boolean).join('\n')
          if (extra) data.message = `${extra}\n\n${data.message ?? ''}`
          if (btn) btn.disabled = true
          try {
            const res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ ...data, kind: form.dataset.c5Form, _t: started, _source: location.pathname }),
            })
            const ok = res.ok && (await res.json().catch(() => ({}))).ok
            if (status) status.textContent = ok ? form.dataset.sent || 'נשלח' : form.dataset.error || 'השליחה נכשלה'
            if (ok) form.reset()
          } catch {
            if (status) status.textContent = form.dataset.error || 'השליחה נכשלה'
          } finally {
            if (btn) btn.disabled = false
          }
        })
      })
    </script>
  </body>
</html>
