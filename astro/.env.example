# Sanity read config. The production dataset is PUBLIC, so no token is needed
# for the site build. Copy to astro/.env (gitignored).
SANITY_PROJECT_ID=jiy8i5hb
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01

# ---- Visual editing / live preview (Presentation tool) ----------------------
# Set ONLY on preview deployments (or locally while editing). Flips the build
# to SSR + stega overlays. Leave unset in production (site stays fully static).
#PUBLIC_SANITY_VISUAL_EDITING_ENABLED=true
# Where the Studio runs (click-to-edit links point here).
#PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
# Viewer token (sanity.io/manage -> API -> Tokens, "Viewer" role) so the
# preview shows unpublished DRAFTS. Without it, preview shows published only.
#SANITY_READ_TOKEN=

# Store locator map tiles (optional). Default: OpenStreetMap, no key needed.
# For a styled basemap, set the full {z}/{x}/{y} template incl. key, e.g. MapTiler/Stadia.
#PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#PUBLIC_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# ---- Contact form --------------------------------------------------------------
# SIMPLEST (free, no account): Web3Forms. On web3forms.com enter the inbox address
# (info-israel@nature-sage.com) → the access key is emailed there → paste it here.
# The form then posts straight to their API and they email the submission to that
# inbox (250/month free). The key is public by design (it only identifies the inbox).
#PUBLIC_WEB3FORMS_KEY=
#
# OTHERWISE the site's own mailer (/api/contact, a Vercel serverless function)
# emails the form to CONTACT_TO. Configure ONE transport in the Vercel project
# (Settings → Environment Variables, production + preview):
CONTACT_TO=info-israel@nature-sage.com
# (a) Microsoft 365 mailbox via Graph (recommended for Office 365 — Microsoft is
#     retiring password SMTP: off by default from end of Dec 2026, removed in 2027).
#     Entra admin center → App registrations → New: note Tenant ID + Client ID, add a
#     client secret, API permissions → Microsoft Graph → Application → Mail.Send →
#     "Grant admin consent". (Optional hardening: Exchange ApplicationAccessPolicy
#     limiting the app to this one mailbox.)
#MS_TENANT_ID=
#MS_CLIENT_ID=
#MS_CLIENT_SECRET=
#MS_SENDER=info-israel@nature-sage.com
# (b) The company mailbox over password SMTP — Google Workspace: smtp.gmail.com:465
#     with an App Password; Microsoft 365: smtp.office365.com:587, mailbox password,
#     "Authenticated SMTP" enabled on the mailbox (works until Microsoft turns it off).
#SMTP_HOST=smtp.office365.com
#SMTP_PORT=587
#SMTP_USER=info-israel@nature-sage.com
#SMTP_PASS=
#SMTP_FROM="אתר נייטשרסייג" <info-israel@nature-sage.com>
# (c) Or Resend (resend.com; verify nature-sage.com there first):
#RESEND_API_KEY=re_xxxxxxxx
#CONTACT_FROM="NatureSage" <site@nature-sage.com>
# Optional: post the form to an external JSON endpoint instead of /api/contact.
#PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxx

# ---- Community page (/community) — Instagram feed ------------------------------
# Long-lived token of the brand's Instagram professional account (Meta app →
# "Instagram API with Instagram Login" → generate token; refresh before 60 days).
#INSTAGRAM_ACCESS_TOKEN=
#INSTAGRAM_USER_ID=            # optional, defaults to /me
# Optional: posts the brand is tagged in (needs a Facebook Page token + IG business id)
#INSTAGRAM_GRAPH_TOKEN=
#INSTAGRAM_BUSINESS_ID=
# Design review without a token: sample cards, clearly marked "דוגמה"
#PUBLIC_INSTAGRAM_DEMO=true
