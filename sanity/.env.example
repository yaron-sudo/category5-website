# Copy to sanity/.env (gitignored) after creating the Sanity project.
# Get the project id from `npm create sanity@latest` output or sanity.io/manage.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01

# Write token (sanity.io/manage -> API -> Tokens, "Editor" role).
# Required only for `npm run import` / `npm run seed` (NOT for --dry).
SANITY_WRITE_TOKEN=

# Vercel Deploy Hook for the "פרסום לאתר" button in the Studio (create at
# Vercel → Project → Settings → Git → Deploy Hooks).
#SANITY_STUDIO_DEPLOY_HOOK=

# Presentation tool ("עריכה חיה") preview target. Defaults to the local Astro
# dev server (http://localhost:4321). For the deployed Studio, set this to the
# Vercel PREVIEW deployment URL (the one built with
# PUBLIC_SANITY_VISUAL_EDITING_ENABLED=true).
#SANITY_STUDIO_PREVIEW_ORIGIN=
